---
import { Image } from "astro:assets";
import BrandHeading from "@/components/BrandHeading.astro";
import { dailyMoments } from "@/data/activities";
import { ICONS } from "@/lib/icons";
import { lightboxSrc } from "@/lib/images";

interface Props {
  title?: string;
  highlight?: string;
  note?: string;
  class?: string;
}

const {
  title = "Một buổi học ở",
  highlight = "SaigonHSK",
  note = "Ảnh thật, không dàn dựng",
  class: className = "",
} = Astro.props;

const CARD_W = 360;
const CARD_H = 270;

const photos = await Promise.all(
  dailyMoments.map(async (p) => {
    const density = Math.min(2, p.image.width / CARD_W, p.image.height / CARD_H);

    return {
      ...p,
      densities: density >= 1.05 ? [1, Number(density.toFixed(2))] : [1],
      full: await lightboxSrc(p.image),
    };
  }),
);
---

<section
  id="daily-life"
  class:list={["relative overflow-hidden bg-background scroll-mt-24", className]}
>
  <div class="container relative z-10 mx-auto px-6">
    <BrandHeading title={title} highlight={highlight} note={note} />

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {
        photos.map((p) => (
          <li>
            <figure class="h-full">
              <button
                type="button"
                data-lightbox={p.full}
                data-caption={p.caption}
                class="group relative block w-full cursor-zoom-in overflow-hidden rounded-[1.75rem] bg-brand-ink-100 text-left"
              >
                <Image
                  src={p.image}
                  alt={p.caption}
                  width={CARD_W}
                  height={CARD_H}
                  fit="cover"
                  densities={p.densities}
                  format="webp"
                  quality={88}
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />

                <span class="pointer-events-none absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-bold text-brand-ink-900 opacity-0 shadow-[0_10px_24px_-14px_rgb(17_24_39/0.7)] transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100">
                  <span class="[&>svg]:size-3.5" set:html={ICONS.search} />
                  Xem ảnh lớn
                </span>
              </button>

              <figcaption class="mt-3 px-1 text-sm leading-snug text-muted-foreground">
                {p.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
