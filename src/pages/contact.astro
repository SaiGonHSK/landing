---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import FAQ from "@/components/FAQ.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { contact, site } from "@/data/site";
import { clampDescription } from "@/lib/seo";
import { contactPageSchema } from "@/lib/schema";

const schemas = [contactPageSchema({ pathname: Astro.url.pathname, site: Astro.site })];
---

<Layout
  title="Địa chỉ & hotline trung tâm tiếng Trung TPHCM | SaigonHSK"
  description={clampDescription(
    `Trung tâm tiếng Trung SaigonHSK: ${contact.addressShort}. Hotline ${contact.phonePrimary}, Zalo. Mở cửa ${contact.workingHours} — gọi để nhận học phí và lịch khai giảng.`,
  )}
  keywords="địa chỉ trung tâm tiếng Trung TPHCM, dia chi trung tam tieng trung tphcm, hotline học tiếng Trung, trung tâm tiếng Trung gần đây, trung tam tieng trung o dau, tư vấn học phí tiếng Trung"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 pb-16 lg:gap-24 lg:pb-24">
    <PageHero
      title="Liên hệ với SaigonHSK"
      description="Gọi hotline, nhắn Zalo hoặc để lại thông tin — trung tâm sẽ tư vấn lộ trình, học phí và lịch khai giảng phù hợp với bạn."
      crumbs={[{ label: "Liên hệ" }]}
      glyph="联"
    />

    <RegisterSection />
    <FAQ />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
