---
import { Image } from "astro:assets";
import { dailyMoments } from "@/data/activities";
import { contact } from "@/data/site";
import { ICONS } from "@/lib/icons";

interface Props {
  title?: string;
  highlight?: string;
  showFormNote?: boolean;
  class?: string;
}

const {
  title = "Đăng ký",
  highlight = "học thử",
  showFormNote = true,
  class: className = "",
} = Astro.props;

const includes = [
  "Ngồi học nguyên buổi cùng lớp đang mở",
  "Cảm nhận cách giảng dạy và không khí lớp trước khi đăng ký",
  "Nghe giảng viên tư vấn lộ trình HSK theo mục tiêu của bạn",
];

const levels = ["HSK 1–6", "Giao tiếp", "Công sở", "Trẻ em"];

type Channel = {
  label: string;
  desc: string;
  href: string;
  external: boolean;
  icon: string;
  brand?: boolean;
  tint?: string;
};

const channels: Channel[] = [
  {
    label: "Nhắn Zalo",
    desc: "Nhắn là có giảng viên tư vấn ngay",
    href: contact.zalo,
    external: true,
    icon: ICONS.zalo,
    brand: true,
  },
  {
    label: contact.phonePrimary,
    desc: contact.workingHours,
    href: `tel:${contact.phonePrimaryRaw}`,
    external: false,
    icon: ICONS.phone,
    tint: "text-brand-ink-400",
  },
  {
    label: "Tới trung tâm",
    desc: contact.addressShort,
    href: contact.mapsUrl,
    external: true,
    icon: ICONS.pin,
    tint: "text-brand-ink-400",
  },
];

const mosaic = Array.from(
  { length: 14 },
  (_, i) => dailyMoments[i % dailyMoments.length],
);

const fadeUp =
  "mask-image: linear-gradient(to bottom, transparent, #000 55%); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 55%);";
---

<section
  id="trial-cta"
  class:list={[
    "relative isolate overflow-hidden bg-background scroll-mt-24 pb-16 lg:pb-24",
    className,
  ]}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-90 overflow-hidden opacity-[0.22] md:h-105"
    style={fadeUp}
  >
    <div
      class="grid grid-cols-4 gap-3 px-3 sm:grid-cols-5 lg:grid-cols-7 lg:gap-4 lg:px-6"
    >
      {
        mosaic.map((p) => (
          <Image
            src={p.image}
            alt=""
            width={220}
            format="webp"
            quality={55}
            loading="lazy"
            decoding="async"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        ))
      }
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-6">
    <div class="flex flex-col items-center text-center">
      <h2
        class="font-heading text-[1.9rem] leading-[1.05] font-black tracking-tight text-balance text-brand-ink-900 md:text-[2.9rem]"
      >
        {title}{" "}
        <span class="whitespace-nowrap text-brand-red-600">{highlight}</span>
      </h2>

      <p class="mt-4 max-w-xl text-base leading-7 text-brand-ink-500">
        Trải nghiệm lớp học thực tế, làm quen cách giảng dạy và tìm lộ trình tiếng Trung
        phù hợp với bạn.
      </p>

      <ul class="mt-5 flex flex-wrap items-center justify-center gap-2">
        {
          levels.map((l) => (
            <li class="rounded-full border border-brand-ink-100 bg-background px-3.5 py-1.5 text-xs font-semibold text-brand-ink-700">
              {l}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mx-auto mt-12 grid max-w-5xl overflow-hidden rounded-[2rem] border border-border bg-background/90 shadow-[0_40px_90px_-60px_rgb(17_24_39/0.55)] backdrop-blur-sm lg:grid-cols-[1.05fr_1fr]"
    >
      <div
        class="relative overflow-hidden bg-brand-red-600 p-6 text-white md:p-8 lg:p-12"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -right-3 -bottom-12 select-none text-[9rem] leading-none font-black text-white/[0.05]"
          >试</span
        >

        <div class="relative z-10">
          <p class="text-[1.75rem] leading-[1.15] font-extrabold tracking-tight text-balance md:text-[2rem]">
            Trải nghiệm lớp học trước khi đăng ký
          </p>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-white/80">
            Một buổi học thật, cùng một lớp đang mở — để bạn tự đánh giá trước khi quyết định.
          </p>

          <p class="mt-7 text-[11px] font-bold tracking-[0.18em] text-white/60 uppercase">
            Một buổi học thử gồm
          </p>
          <ul class="mt-4 space-y-3">
            {
              includes.map((item) => (
                <li class="flex gap-3 text-[15px] leading-relaxed text-white">
                  <span
                    class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-white/15 [&>svg]:size-3"
                    set:html={ICONS.check}
                  />
                  {item}
                </li>
              ))
            }
          </ul>

          <a
            href="/trial"
            class="group mt-8 inline-flex h-12 items-center gap-2 rounded-lg bg-white px-7 text-sm font-bold text-brand-red-700 transition-colors hover:bg-brand-red-50"
          >
            Chọn lớp học thử
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      </div>

      <div class="flex flex-col justify-center py-4 lg:py-8">
        <p class="px-6 pt-4 text-lg font-extrabold text-brand-ink-900 sm:px-8">
          Đăng ký dễ dàng
        </p>
        <p class="mt-1 px-6 text-sm text-muted-foreground sm:px-8">
          Chọn cách liên hệ tiện nhất với bạn.
        </p>

        <div class="mt-3 divide-y divide-border">
          {
            channels.map((c) => (
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "noopener" : undefined}
                class="group flex items-center gap-4 px-6 py-5 transition-colors hover:bg-brand-ink-50 sm:px-8"
              >
                <span
                  class:list={[
                    "grid size-11 shrink-0 place-items-center rounded-xl bg-brand-ink-50 transition-colors group-hover:bg-background",
                    c.brand ? "[&>svg]:size-6" : `[&>svg]:size-5 ${c.tint}`,
                  ]}
                  set:html={c.icon}
                />

                <span class="min-w-0 flex-1 text-left">
                  <span class="block font-heading text-[15px] font-extrabold text-brand-ink-900">
                    {c.label}
                  </span>
                  <span class="block text-sm leading-snug text-muted-foreground">
                    {c.desc}
                  </span>
                </span>

                <span
                  class="shrink-0 text-brand-ink-300 transition-all group-hover:translate-x-0.5 group-hover:text-brand-ink-700 [&>svg]:size-4"
                  set:html={ICONS.arrowUpRight}
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    {
      showFormNote && (
        <p class="mt-6 text-center text-sm text-muted-foreground">
          Chưa chọn được lớp?
          <a
            href="/register"
            class="font-semibold text-brand-red-600 underline-offset-4 hover:underline"
          >
            Để lại thông tin</a
          >, trung tâm sẽ gọi lại xếp buổi học thử phù hợp.
        </p>
      )
    }
  </div>
</section>
