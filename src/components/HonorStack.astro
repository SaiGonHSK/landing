---

import { Image } from "astro:assets";
import { honorPosters } from "@/data/achievements";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const posters = [...honorPosters].sort(
  (a, b) => Number(a.total) - Number(b.total),
);

const CARD = 36;
const STEP = 18;
const LEFT = 5;
const BOTTOM = 8;
const RISE = 5;
const TILT = 1.6;

const LAST = posters.length - 1;

const label = `Poster vinh danh học viên SaigonHSK: ${posters
  .map((p) => `${p.name} ${p.result}`)
  .join(", ")}`;
---

<div class:list={["relative aspect-16/10", className]} role="group" aria-label={label}>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-[4%] bottom-[3%] h-[9%] rounded-[50%] bg-[radial-gradient(closest-side,rgb(17_24_39/0.18),transparent)]"
  ></span>

  {
    posters.map((p, i) => (
      <figure
        class="absolute overflow-hidden rounded-2xl border border-brand-ink-900/10 bg-white shadow-[0_4px_10px_-4px_rgb(17_24_39/0.35),0_22px_44px_-24px_rgb(17_24_39/0.5)]"
        style={`left:${LEFT + i * STEP}%;bottom:${BOTTOM + (LAST - i) * RISE}%;width:${CARD}%;z-index:${i + 1};transform:rotate(${(-(LAST - i) * TILT).toFixed(1)}deg);transform-origin:50% 100%;`}
      >
        <Image
          src={p.image}
          alt={`${p.title} — bạn ${p.name}`}
          width={560}
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
          class="block aspect-square w-full object-cover"
        />
      </figure>
    ))
  }
</div>
