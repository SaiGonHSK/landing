---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { findParent, getPageContents } from "@/data/pages";
import { renderArticleBody } from "@/lib/articleBody";
import { site } from "@/data/site";

const wanted = `/${(Astro.params.slug ?? "").replace(/^\/+|\/+$/g, "")}`;
const page = (await getPageContents()).find((entry) => entry.slug === wanted);
if (!page) return new Response(null, { status: 404 });

const parent = findParent(page.slug);

const inLibrary = page.slug.startsWith("/library/");

const crumbs = parent
  ? [{ label: parent.label, href: parent.slug }, { label: page.title }]
  : [{ label: page.title }];

const origin = Astro.site?.origin ?? "";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.summary,
    inLanguage: "vi-VN",
    mainEntityOfPage: `${origin}${page.slug}`,
    ...(page.updatedAt
      ? { dateModified: page.updatedAt, datePublished: page.updatedAt }
      : {}),
    author: {
      "@type": "Organization",
      name: site.fullName,
      url: origin,
    },
    publisher: { "@id": `${origin}/#organization` },
  },
];
---

<Layout
  title={`${page.title} | ${site.shortName}`}
  description={page.summary || page.intro || site.description}
  ogType="article"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero title={page.title} description={page.intro} crumbs={crumbs} glyph="文" />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <article
          class="rich mx-auto max-w-3xl rounded-3xl bg-brand-ink-50 p-7 text-base leading-relaxed text-muted-foreground md:p-10"
          set:html={renderArticleBody(page.body)}
        />
      </div>
    </section>

    {
      parent && parent.children.length > 1 && (
        <section class="bg-background">
          <div class="container mx-auto px-6">
            <h2 class="text-xl font-extrabold text-brand-ink-900">
              Cùng mục {parent.label}
            </h2>
            <div class="mt-5 flex flex-wrap gap-3">
              {parent.children
                .filter((child) => child.slug !== page.slug)
                .slice(0, 10)
                .map((child) => (
                  <a
                    href={child.slug}
                    class="rounded-lg bg-brand-ink-50 px-5 py-2.5 text-sm font-semibold text-foreground transition-transform hover:-translate-y-0.5"
                  >
                    {child.label}
                  </a>
                ))}
            </div>
          </div>
        </section>
      )
    }

    {
      !inLibrary && (
        <>
          <RegisterSection />
          <CtaSection />
        </>
      )
    }
  </main>
  <Footer />
  <FloatingContact />
</Layout>
