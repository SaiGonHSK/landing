---
import CourseBadge from "@/components/CourseBadge.astro";
import { sessionLines, type ScheduleRow } from "@/data/schedule";
import { contact } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { registerHref } from "@/lib/registerLink";

interface Props {
  rows: ScheduleRow[];
  class?: string;
}

const { rows, class: className = "" } = Astro.props;

const MODE_LABELS: Record<string, string> = {
  offline: "Offline",
  online: "Online",
  hybrid: "Kết hợp",
};

const placeOf = (row: ScheduleRow) =>
  row.mode === "online"
    ? "Học online, lớp trực tuyến tương tác"
    : row.mode === "hybrid"
      ? "Kết hợp online và học tại trung tâm"
      : `Học tại trung tâm · ${contact.addressShort.split(",")[0]}`;

const detailsOf = (row: ScheduleRow) => {
  const fixed = row.slots.length > 0;

  return [
    {
      icon: ICONS.calendar,
      lines: [
        row.openDate
          ? `Khai giảng ${row.openDate}`
          : "Khai giảng linh hoạt — gọi để xếp lớp",
      ],
      strong: true,
    },
    {
      icon: ICONS.clock,
      lines: fixed
        ? sessionLines(row.slots)
        : [row.cadenceNote || "Giờ học xếp theo học viên"],
      strong: false,
    },
    {
      icon: ICONS.cap,
      lines: [fixed ? `${row.slots.length} buổi/tuần · ${row.duration}` : row.duration],
      strong: false,
    },
    {
      icon: row.mode === "online" ? ICONS.monitor : ICONS.pin,
      lines: [placeOf(row)],
      strong: false,
    },
  ];
};

const searchKey = (row: ScheduleRow) =>
  `${row.code} ${row.name} ${row.target} ${row.cadence}`
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/đ/g, "d");

const cards = rows.map((row) => ({
  row,
  courseTitle: row.group || row.name,
  details: detailsOf(row),
  href: registerHref({
    course: row.group,
    classCode: row.code,
    itemId: row.id,
  }),
  meta: [row.openDate && `Khai giảng ${row.openDate}`, row.cadence, placeOf(row)]
    .filter(Boolean)
    .join(" · "),
}));
---
<div class:list={["grid gap-5 md:grid-cols-2 lg:grid-cols-3", className]}>
  {
    cards.map(({ row, courseTitle, details, href, meta }) => (
      <article
        data-class-card
        data-search={searchKey(row)}
        class="flex flex-col overflow-hidden rounded-2xl border border-border bg-background transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-32px_rgb(17_24_39/0.45)]"
      >
        <div class="h-24 border-b border-border">
          <CourseBadge title={courseTitle} />
        </div>

        <div class="px-5 pt-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-brand-ink-200 px-2.5 py-0.5 font-mono text-[0.6875rem] font-bold tracking-[0.06em] text-brand-ink-700 uppercase">
              {row.code}
            </span>
            <span
              class:list={[
                "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[0.6875rem] font-bold",
                row.mode === "online"
                  ? "bg-brand-ink-900 text-white"
                  : "bg-brand-ink-100 text-brand-ink-700",
              ]}
            >
              <span class="[&>svg]:size-3" set:html={row.mode === "online" ? ICONS.monitor : ICONS.pin} />
              {MODE_LABELS[row.mode] ?? row.mode}
            </span>
          </div>
          <h3 class="mt-3 text-lg leading-tight font-black text-brand-ink-900">
            {row.name}
          </h3>
        </div>

        <div class="mx-5 mt-4 flex items-center gap-3 rounded-xl bg-brand-red-50 px-4 py-3">
          <span class="text-brand-red-700 [&>svg]:size-5" set:html={ICONS.calendar} />
          <div class="min-w-0">
            <p class="text-[0.6875rem] font-semibold tracking-[0.08em] text-brand-red-700/80 uppercase">
              Khai giảng
            </p>
            <p class="text-base leading-tight font-black text-brand-ink-900">
              {row.openDate || "Linh hoạt — gọi để xếp lớp"}
            </p>
          </div>
        </div>

        <div class="px-5 pt-4">
          <p class="text-[0.6875rem] font-semibold tracking-[0.08em] text-brand-ink-400 uppercase">
            Lịch học
          </p>
          <ul class="mt-1.5 space-y-1 text-sm leading-relaxed font-semibold text-brand-ink-800">
            {details[1].lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>

        <div class="space-y-1 px-5 pt-3 pb-5 text-[13px] leading-relaxed text-brand-ink-500">
          <p class="flex gap-2">
            <span class="mt-0.5 shrink-0 [&>svg]:size-3.5" set:html={ICONS.cap} />
            {details[2].lines[0]}
          </p>
          <p class="flex gap-2">
            <span class="mt-0.5 shrink-0 [&>svg]:size-3.5" set:html={row.mode === "online" ? ICONS.monitor : ICONS.pin} />
            {details[3].lines[0]}
          </p>
        </div>

        <div class="mt-auto border-t border-border p-5">
          {row.openDate ? (
            <a
              href={href}
              data-class-register
              data-class-id={row.id}
              data-class-name={row.name}
              data-class-code={row.code}
              data-course={row.group}
              data-class-meta={meta}
              class="block rounded-lg bg-brand-red-600 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
            >
              Đăng ký ngay
            </a>
          ) : (
            <a
              href={`tel:${contact.phonePrimaryRaw}`}
              class="flex items-center justify-center gap-2 rounded-lg border border-border py-3 text-center text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
            >
              <span class="[&>svg]:size-4" set:html={ICONS.phone} />
              Gọi để xếp lớp
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>
