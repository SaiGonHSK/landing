---
import { ICONS } from "@/lib/icons";
import { mission } from "@/data/site";
import { coreValues } from "@/data/coreValues";

const panels = [
  {
    icon: ICONS.target,
    label: "Tầm nhìn",
    body: mission.vision,
    keywords: [
      "uy tín hàng đầu tại TP.HCM",
      "phương pháp giảng dạy hiện đại",
      "môi trường học tập truyền cảm hứng",
    ],
  },
  {
    icon: ICONS.heart,
    label: "Sứ mệnh",
    body: mission.statement,
    keywords: [
      "môi trường học tập chuyên nghiệp",
      "đội ngũ giảng viên tận tâm",
      "phát triển toàn diện năng lực ngôn ngữ",
    ],
  },
];

const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const emphasize = (text: string, keywords: readonly string[]) => {
  const longestFirst = [...keywords].sort((a, b) => b.length - a.length);

  return longestFirst.reduce(
    (html, keyword) =>
      html.replace(
        escapeHtml(keyword),
        (match) => `<strong class="font-bold text-brand-ink-800">${match}</strong>`,
      ),
    escapeHtml(text),
  );
};
---
<section class="about-identity relative isolate overflow-hidden py-16 lg:py-24">
  <div class="about-identity-glow pointer-events-none absolute inset-0 -z-10"></div>
  <div class="about-identity-grid pointer-events-none absolute inset-0 -z-10"></div>

  <div class="container relative mx-auto px-6">
    <div class="flex flex-col items-center text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-red-600">
        Về chúng tôi
      </p>

      <h2
        class="mt-4 max-w-2xl text-[2rem] font-black leading-[1.08] tracking-tight text-balance text-brand-ink-900 md:text-[2.75rem]"
      >
        Bản sắc, Tầm nhìn<br class="hidden sm:block" /> và Giá trị
      </h2>

      <p
        class="mt-5 max-w-2xl text-base leading-relaxed text-brand-ink-600 italic md:text-lg"
      >
        {mission.motto}
      </p>
    </div>

    <div class="mt-12 lg:mt-16">
      <ul
        class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 gap-x-8 gap-y-9 rounded-[2rem] bg-brand-red-600 px-6 py-10 shadow-[0_22px_45px_-25px_var(--brand-red-900)] sm:grid-cols-2 lg:grid-cols-5 lg:rounded-[2.5rem] lg:px-10"
      >
        {
          coreValues.map((v) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span
                class="grid size-12 place-items-center rounded-full bg-white/15 text-white inset-ring inset-ring-white/25 [&>svg]:size-6"
                set:html={ICONS[v.icon as keyof typeof ICONS] ?? ICONS.shield}
              />
              <p class="text-base font-extrabold leading-snug text-white md:text-[17px]">
                {v.title}
              </p>
              <p class="text-sm leading-relaxed text-white/90 md:text-[15px]">
                {v.desc}
              </p>
            </li>
          ))
        }
      </ul>

      <div
        class="-mt-14 rounded-[2rem] bg-background px-6 pt-20 pb-10 shadow-[0_30px_60px_-45px_var(--brand-ink-900)] sm:px-10 lg:-mt-16 lg:rounded-[2.5rem] lg:px-14 lg:pt-24 lg:pb-14"
      >
        <div class="grid gap-10 md:grid-cols-2 md:gap-14">
          {
            panels.map((p, i) => (
              <div class:list={[i > 0 && "md:border-l md:border-brand-surface-200 md:pl-14"]}>
                <div class="flex items-center gap-3">
                  <span
                    class="grid size-10 place-items-center rounded-full bg-brand-surface-100 text-brand-ink-600 [&>svg]:size-5"
                    set:html={p.icon}
                  />
                  <h3 class="text-xl font-extrabold text-brand-ink-900 md:text-2xl">
                    {p.label}
                  </h3>
                </div>
                <p
                  class="mt-4 text-base leading-[1.85] text-brand-ink-500"
                  set:html={emphasize(p.body, p.keywords)}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-identity {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      var(--brand-surface-100) 18%,
      var(--brand-surface-100) 82%,
      #ffffff 100%
    );
  }

  .about-identity-glow {
    background:
      radial-gradient(
        55% 40% at 50% 38%,
        rgba(178, 20, 32, 0.05) 0%,
        transparent 72%
      ),
      radial-gradient(
        45% 45% at 88% 92%,
        rgba(18, 19, 22, 0.04) 0%,
        transparent 70%
      );
  }

  .about-identity-grid {
    background-image:
      linear-gradient(to right, rgba(18, 19, 22, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 19, 22, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(65% 60% at 50% 45%, #000 0%, transparent 100%);
  }
</style>
