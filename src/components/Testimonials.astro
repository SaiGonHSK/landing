---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import RailHint from "@/components/RailHint.astro";
import HeroBackdrop from "@/components/HeroBackdrop.astro";
import Stars from "@/components/Stars.astro";
import {
  orderedTestimonials,
  reviewDetailHref,
  reviewsSummary,
  sourceLabel,
  testimonials,
} from "@/data/testimonials";
import { imageAsset } from "@/data/imageAssets";
import { ICONS } from "@/lib/icons";

/**
 * Mục cảm nhận học viên, đặt trên nền `HeroBackdrop` — cùng bộ nền của hero và mục sự kiện:
 * dải chuyển sắc trắng→xám, hai vệt sáng, lưới kẻ mờ, sticker sách–én–tia sáng, và hai lớp
 * sóng trắng ở đáy trả nền về trắng cho `TrialCta` ngay dưới.
 *
 * Vì sao mục này đáng có nền riêng: mấy thẻ đánh giá vốn là khối trắng viền mảnh, đứng trên
 * nền trắng thì chúng chỉ là mấy ô kẻ viền. Đặt lên nền xám có chất liệu thì thẻ nổi hẳn lên
 * thành từng tấm rời — đúng thứ cần thấy ở một dải kéo ngang.
 *
 * Đây cũng là mốc thứ hai của cùng một bộ nền trên trang chủ (mục sự kiện là mốc thứ nhất):
 * hai mảng xám cách nhau đúng một mục trắng (`Facility`), nên trang đọc ra là xám–trắng xen
 * kẽ chứ không phải một dải trắng dài có một chỗ đổi màu.
 */

interface Props {
  /**
   * Số thẻ tối đa trên dải. Bỏ trống là hiện hết.
   *
   * Có mặt vì danh sách đã đổi bậc độ lớn: trước đây là hơn chục cảm nhận trung tâm
   * tự ghi lại, giờ có thêm đánh giá Google. Một dải ngang 70 thẻ thì mọi thẻ từ thẻ
   * thứ mười trở đi không ai kéo tới, mà vẫn phải render và tải ảnh.
   */
  limit?: number;
}

const { limit } = Astro.props;

const summary = reviewsSummary();

const initials = (name: string) =>
  name
    .split(" ")
    .slice(-2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

/*
  Cắt từ đầu `orderedTestimonials()` — tức là dải này luôn là mấy đánh giá MỚI NHẤT.

  Mục này KHÔNG tự sắp lại danh sách, và đó là chủ ý: mã neo của link "Chi tiết" tính
  theo vị trí trong `orderedTestimonials()` (xem `reviewAnchor`), nên sắp lại ở đây là
  mọi link trỏ sang thẻ của người khác. Muốn đổi thứ tự thì đổi ở `orderedTestimonials`,
  một chỗ, cho cả trang chủ lẫn `/about/reviews`.

  Trước đây dải này xếp thẻ có ảnh lên đầu để trang chủ đẹp hơn. Quy tắc đó đã bỏ:
  "mới nhất trước" và "có ảnh trước" là hai thứ tự khác nhau, giữ cả hai thì hai trang
  hiển thị hai thứ tự và link giữa chúng hết khớp.
*/
const list = orderedTestimonials()
  .slice(0, limit ?? Infinity)
  .map((item, index) => ({ item, index }));

// `quote` là chữ thuần nên không còn thẻ HTML để bỏ; vẫn dò trên chuỗi thô.
const badgeOf = (quote: string) => {
  const hsk = quote.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/, "");
  const tocfl = quote.match(/TOCFL(\s+Band\s+[A-C]\d?)?/i)?.[0];
  if (hsk && tocfl) return `${hsk.toUpperCase()} · TOCFL`;
  return hsk?.toUpperCase() ?? tocfl ?? "Học viên SaigonHSK";
};
---

{/*
  `relative isolate overflow-hidden` là điều kiện dùng `HeroBackdrop` — xem chú thích đầu file
  đó: `isolate` để lớp `-z-10` không tụt xuống dưới nền của cả trang, `overflow-hidden` để
  sticker và sóng không thò ra ngoài mục.

  `pb` đặt đúng bằng chiều cao dải sóng của `HeroBackdrop` ở cả ba mốc (28 / 36 / 44): sóng neo
  ở đáy section, hai con số bằng nhau thì đỉnh sóng không bao giờ ăn vào thẻ đánh giá cuối dải.
  Đổi chiều cao sóng thì phải đổi `pb` theo.
*/}
<section
  id="reviews"
  class="relative isolate scroll-mt-24 overflow-hidden pt-12 pb-28 sm:pb-36 lg:pt-16 lg:pb-44"
>
  {/* `stickers="wide"`: tiêu đề mục nằm giữa và ăn hết bề rộng, nên hai sticker trên cùng phải
      lên khỏi tầm chữ ở màn hẹp — xem `variant` trong `HeroStickers.astro`. */}
  {/* `stickers="wide"`: tiêu đề mục nằm giữa và ăn hết bề rộng, nên hai sticker trên cùng phải
      lên khỏi tầm chữ ở màn hẹp — xem `variant` trong `HeroStickers.astro`. */}
  <HeroBackdrop stickers="wide" />

  <div class="container relative mx-auto px-6">
    <SectionHeading
      title="Chuyện của"
      highlight="học viên SaigonHSK"
      description="Những trải nghiệm thực tế trên hành trình chinh phục tiếng Trung."
    />

    {/*
      Dải điểm tổng của trang nguồn, đặt dưới tiêu đề.

      Ở đây nó là chữ cho người đọc, KHÔNG kèm `aggregateRating` của schema.org —
      lý do viết ở `src/pages/about/reviews.astro`.

      Con số dẫn thẳng ra trang nguồn: một dòng "5,0 · 65 đánh giá" tự trung tâm
      viết về mình thì không có sức nặng gì, trừ khi bấm được để tự kiểm.
    */}
    <div class="mt-8 flex justify-center">
      <a
        href={summary.sourceUrl}
        target="_blank"
        rel="noopener nofollow"
        class="group/summary inline-flex items-center gap-4 rounded-2xl border border-[#eadfd3] bg-white px-6 py-4 shadow-[0_18px_40px_-32px_rgb(17_24_39/0.5)] transition-colors hover:border-brand-red-300"
      >
        <span class="text-4xl leading-none font-black tracking-tight text-brand-ink-900">
          {summary.score}<span class="text-lg font-bold text-brand-ink-400"> / 5</span>
        </span>
        <span class="h-10 w-px bg-[#eadfd3]" aria-hidden="true"></span>
        <span class="flex flex-col items-start gap-1">
          <Stars rating={5} label={`${summary.score} trên 5 sao`} />
          <span class="text-sm font-medium text-brand-ink-600">
            {summary.count} đánh giá trên {summary.sourceLabel}
          </span>
        </span>
        <span
          class="text-brand-red-700 transition-transform group-hover/summary:translate-x-0.5 [&>svg]:size-4"
          set:html={ICONS.arrowUpRight}
        />
      </a>
    </div>

    <div data-rail class="group/rail relative mt-10">
      <div
        data-rail-track
        class="flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto md:gap-5 scroll-smooth pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
        list.map(({ item: t, index }, i) => {
          const image = imageAsset(t.image);

          /*
            Chỉ cặp thẻ nhìn thấy khi khối lọt vào khung mới có nét trượt ngang: thẻ đầu
            vào từ trái, thẻ thứ hai vào từ phải. Các thẻ sau nằm ngoài khung ngang, người
            xem phải kéo mới thấy — lúc đó nét vào đã chạy xong nên có gán cũng vô nghĩa.
          */
          const slide = i === 0 ? "left" : i === 1 ? "right" : undefined;

          return (
            <figure
              data-review-card
              data-review-slide={slide}
              class="flex w-[min(88vw,34rem)] shrink-0 snap-start flex-col overflow-hidden rounded-2xl border border-[#eadfd3] bg-white shadow-[0_18px_40px_-34px_rgb(17_24_39/0.5)] lg:w-[calc((100%-1.25rem)/2)]"
            >
              <div class="flex flex-1 gap-6 p-6 md:p-8">
                {/*
                  `justify-center` cho khối trích dẫn: mọi thẻ trong dải cao bằng nhau
                  (`items-stretch`), và chiều cao đó do thẻ có bài dài nhất quyết định —
                  nên một cảm nhận ba dòng nằm cạnh một cảm nhận chín dòng sẽ để lại sáu
                  dòng trống. Canh giữa thì chỗ trống chia đều trên–dưới và đọc ra là bố
                  cục, thay vì dồn hết xuống dưới và đọc ra là thiếu nội dung.
                */}
                <div class="flex flex-1 flex-col justify-center">
                  {/*
                    Có điểm thì dải sao thay chỗ dấu ngoặc kép trang trí, không xếp
                    thêm một hàng: hai thứ này cùng nằm trên đầu khối trích dẫn, để cả
                    hai thì đầu thẻ có hai hàng chỉ để nhìn và chữ bị đẩy xuống.
                  */}
                  {/* Dấu ngoặc kép đỏ, cỡ lớn — điểm nhấn duy nhất của thẻ, nói ngay "đây là
                      lời của học viên". Có điểm sao thì sao đứng cùng hàng bên phải. */}
                  <div class="flex items-center justify-between gap-4">
                    <span
                      aria-hidden="true"
                      class="font-serif text-7xl leading-[0.55] text-brand-red-600/80"
                    >
                      &ldquo;
                    </span>
                    {t.rating && (
                      <Stars
                        rating={t.rating}
                        label={`${t.rating}/5 sao — đánh giá của ${t.name}`}
                      />
                    )}
                  </div>
                  {/*
                    Nội suy chứ không `set:html`: `quote` là chữ thuần do người soạn
                    nhập, in như HTML thì dấu < và & của họ thành thẻ. `whitespace-pre-line`
                    để chỗ họ xuống dòng vẫn xuống dòng.

                    `line-clamp-9` là lý do trang chi tiết tồn tại: đánh giá Google dài
                    tới vài trăm chữ, không chặn thì một thẻ cao gấp năm thẻ bên cạnh và
                    dải ngang mất luôn đường chân. Bản đầy đủ nằm sau link "Chi tiết" ở
                    chân thẻ — `line-clamp` chỉ cắt phần NHÌN THẤY, chữ vẫn nằm trong DOM
                    nên người dùng Ctrl+F và trình thu thập vẫn đọc được cả bài.
                  */}
                  <blockquote class="mt-5 line-clamp-9 whitespace-pre-line text-[0.95rem] leading-7 text-brand-ink-800 md:text-base md:leading-[1.8]">
                    {t.quote}
                  </blockquote>
                </div>

                {image && (
                  <Image
                    src={image}
                    alt={`Học viên ${t.name}`}
                    width={288}
                    densities={[1, 2]}
                    format="webp"
                    quality={85}
                    loading="lazy"
                    decoding="async"
                    class="hidden aspect-[3/4] w-36 shrink-0 self-start rounded-2xl object-cover object-top sm:block"
                  />
                )}
              </div>

              <figcaption class="mt-auto flex items-center justify-between gap-4 border-t border-brand-ink-100 px-6 py-4 md:px-8">
                <div class="flex min-w-0 items-center gap-3">
                  {image ? (
                    <Image
                      src={image}
                      alt=""
                      width={96}
                      densities={[1, 2]}
                      format="webp"
                      quality={85}
                      loading="lazy"
                      decoding="async"
                      class="size-12 shrink-0 rounded-full object-cover object-top"
                    />
                  ) : (
                    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-ink-100 text-sm font-bold text-brand-ink-700">
                      {initials(t.name)}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p class="truncate text-base font-bold text-brand-ink-900">
                      {t.name}
                    </p>
                    {/*
                      Dòng dưới tên: mô tả học viên nếu có, còn đánh giá Google thì
                      không có mô tả nào — chỗ đó ghi nguồn và thời điểm đăng, tức là
                      thứ trả lời đúng câu người xem hỏi ở một đánh giá lạ: ai đăng,
                      đăng ở đâu, đăng khi nào.
                    */}
                    <p class="truncate text-sm text-muted-foreground">
                      {t.role ||
                        [sourceLabel(t.source), t.postedAt]
                          .filter(Boolean)
                          .join(" · ")}
                    </p>
                  </div>
                </div>

                {/*
                  Chân thẻ là một link "Chi tiết" dẫn sang bản đầy đủ trên
                  `/about/reviews`, KHÔNG còn là link ra bài đăng gốc.

                  Vì phần chữ trên thẻ đã bị `line-clamp` cắt, nên thao tác người xem
                  cần ở đây là "đọc hết cái này", chứ không phải "rời trang sang
                  Google". Link ra nguồn vẫn còn, nằm ở trang chi tiết cạnh bản đầy
                  đủ — đó là chỗ nó có ích, vì lúc đó người xem đã đọc và mới có gì để
                  kiểm chứng.

                  Huy hiệu HSK/TOCFL trở lại thành nhãn tĩnh: nó là thông tin, không
                  phải chỗ bấm, và hai vùng bấm cạnh nhau trong một chân thẻ thì không
                  ai đoán được cái nào dẫn đi đâu.
                */}
                <div class="flex shrink-0 items-center gap-5">
                  <span class="hidden text-[11px] font-semibold tracking-[0.08em] text-brand-ink-400 uppercase sm:inline">
                    {badgeOf(t.quote)}
                  </span>

                  <a
                    href={reviewDetailHref(t, index)}
                    class="group/detail inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-700"
                  >
                    Chi tiết
                    <span class="sr-only">
                      {" "}đánh giá của {t.name}
                    </span>
                    <span
                      class="transition-transform group-hover/detail:translate-x-0.5 [&>svg]:size-4"
                      set:html={ICONS.arrow}
                    />
                  </a>
                </div>
              </figcaption>
            </figure>
          );
        })
        }
      </div>

      <RailHint label="đánh giá" />
    </div>

    {/*
      Chỉ hiện khi dải đã bị `limit` cắt bớt: trên `/about/reviews` mục này in hết
      danh sách, một nút "xem tất cả" ở đó sẽ trỏ về chính trang đang đứng.
    */}
    {limit !== undefined && limit < testimonials().length && (
      <div class="mt-8 flex justify-center">
        <a
          href="/about/reviews"
          class="group inline-flex items-center gap-2 rounded-full border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
        >
          Xem tất cả cảm nhận và đánh giá
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    )}
  </div>

  {/*
    Lớp `reveal` phải do script gắn, không viết sẵn trong HTML: nó đặt `opacity: 0`, hễ
    JS không chạy là thẻ mất luôn. Đây cũng là cách khối reveal chung trong `Layout.astro`
    làm — script đó chạy cuối `<body>`, sau script này, nên khi nó gọi `show()` cho cả
    section thì hai thẻ đã mang sẵn `reveal-child` và nhận được `reveal-in`.

    `is:inline` (chứ không để Astro gói thành module) đúng vì lý do trên: module bị hoãn
    tới sau khi phân tích xong tài liệu, thứ tự với script cuối `<body>` sẽ không chắc.
  */}
  <script is:inline>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      document.querySelectorAll("[data-review-slide]").forEach((el) => {
        el.classList.add(
          "reveal",
          "reveal-child",
          "reveal-x-" + el.dataset.reviewSlide
        );
      });
    })();
  </script>
</section>
