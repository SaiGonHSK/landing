---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import SplitHero from "@/components/SplitHero.astro";
import scheduleImage from "@/assets/hero/hoc-vien-nam-nu-tach-nen.webp";
import ScheduleTable from "@/components/ScheduleTable.astro";
import ClassRegisterDialog from "@/components/ClassRegisterDialog.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { schedule, scheduleTitle } from "@/data/schedule";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { openingScheduleSchema } from "@/lib/schema";

const groups = schedule.reduce<
  {
    key: string;
    title: string;
    rows: typeof schedule;
  }[]
>((acc, row) => {
  const title = row.group || row.code;
  const key = title
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

  const found = acc.find((g) => g.key === key);
  if (found) {
    found.rows = [...found.rows, row];
    return acc;
  }

  acc.push({ key, title, rows: [row] });
  return acc;
}, []);

const scheduleSchemas = [
  openingScheduleSchema(schedule, Astro.site?.origin ?? "", {
    name: site.fullName,
    address: contact.address,
  }),
].filter(Boolean) as Record<string, unknown>[];
---

<Layout
  title="Lịch khai giảng lớp tiếng Trung TPHCM | SaigonHSK"
  description="Lịch khai giảng lớp tiếng Trung tại TP.HCM: sơ cấp, trung cấp, luyện thi HSK, giao tiếp cấp tốc, VIP 1 kèm 1. Có lớp buổi tối và cuối tuần, mở lớp hằng tháng."
  keywords="lịch khai giảng tiếng Trung TPHCM, lich khai giang tieng trung, lớp tiếng Trung buổi tối, lớp tiếng Trung cuối tuần, hoc tieng trung tphcm, học phí tiếng Trung TPHCM"
  schemas={scheduleSchemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 pb-16 lg:gap-24 lg:pb-24">
    <SplitHero
      eyebrow={scheduleTitle || "Lịch khai giảng"}
      title={"Tìm lớp phù hợp\nvới lịch của bạn"}
      lead="Lớp mở hằng tháng, có lớp buổi tối và cuối tuần — học offline tại trung tâm hoặc online."
      cta={{ label: "Xem các lớp đang mở", href: "#tim-lop" }}
      image={scheduleImage}
      imageAlt="Hai học viên SaigonHSK mặc đồng phục cầm giáo trình"
      stats={[
        { icon: ICONS.calendar, value: "Hằng tháng", label: "Mở lớp mới" },
        { icon: ICONS.clock, value: "Tối & cuối tuần", label: "Ngoài giờ hành chính" },
        { icon: ICONS.users, value: "10–15", label: "Học viên mỗi lớp" },
        { icon: ICONS.monitor, value: "Offline & online", label: "Tại trung tâm hoặc từ xa" },
      ]}
    />

    {
      schedule.length === 0 && (
        <section>
          <div class="container mx-auto px-6">
            <div class="rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-10 text-center">
              <p class="text-lg font-black text-brand-ink-900">
                Trung tâm đang cập nhật lịch khai giảng
              </p>
              <p class="mt-2 text-sm text-muted-foreground">
                Lịch đợt tới sẽ được đăng tại đây. Gọi
                <a
                  href={`tel:${contact.phonePrimaryRaw}`}
                  class="font-bold text-brand-red-600 hover:underline"
                >
                  {contact.phonePrimary}
                </a>{" "}
                để được báo lịch sớm và đăng ký trước.
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section id="tim-lop" class:list={["scroll-mt-24", schedule.length === 0 && "hidden"]}>
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            class="font-heading text-[1.75rem] font-black leading-tight tracking-tight text-balance text-brand-ink-900 md:text-[2.5rem]"
          >
            Chọn lớp theo trình độ và{" "}
            <span class="text-brand-red-600">giờ học của bạn</span>
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
            Mỗi lớp bên dưới ghi rõ ngày khai giảng, các buổi học trong tuần, giờ
            học, thời lượng và nơi học — xem đủ rồi hãy đăng ký.
          </p>
        </div>

        <div
          class="mt-10 rounded-2xl border border-border bg-brand-ink-50/60 p-5 md:p-7"
        >
          <label
            for="schedule-search"
            class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-muted-foreground"
          >
            Tìm lớp bạn muốn học
          </label>

          <div class="relative mt-3">
            <span
              class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground [&>svg]:size-4"
              set:html={ICONS.search}
            />
            <input
              id="schedule-search"
              type="search"
              data-schedule-search
              placeholder="Nhập mã lớp hoặc tên lớp: HSK1, HSK5, giao tiếp…"
              class="w-full rounded-sm border border-border bg-background py-3.5 pr-4 pl-11 text-sm font-medium text-foreground outline-none transition-colors placeholder:font-normal placeholder:text-muted-foreground focus:border-brand-red-400"
            />
          </div>

          <div class="mt-5 flex flex-wrap gap-2.5">
            {
              groups.map((g) => (
                <a
                  href={`#lich-${g.key}`}
                  class="group inline-flex items-center gap-2 rounded-lg border border-border bg-background py-2 pr-2 pl-4 text-sm font-bold text-brand-ink-900 transition-colors hover:border-brand-red-300 hover:text-brand-red-700"
                >
                  {g.title}
                  <span class="rounded-full bg-brand-ink-50 px-2.5 py-0.5 text-[0.6875rem] font-bold text-brand-ink-500">
                    {g.rows.length} lớp
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      groups.map((g) => (
        <section id={`lich-${g.key}`} data-group class="scroll-mt-24">
          <div class="container mx-auto px-4 md:px-6">
            <ScheduleTable title={g.title} rows={g.rows} />
          </div>
        </section>
      ))
    }

    <section data-empty hidden>
      <div class="container mx-auto px-6">
        <div
          class="rounded-lg border-2 border-dashed border-border bg-brand-ink-50/60 p-10 text-center"
        >
          <p class="text-lg font-black text-brand-ink-900">
            Không tìm thấy lớp phù hợp
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Thử từ khoá khác, hoặc gọi
            <a
              href={`tel:${contact.phonePrimaryRaw}`}
              class="font-bold text-brand-red-600 hover:underline"
              >{contact.phonePrimary}</a
            > để trung tâm tư vấn lớp đúng trình độ.
          </p>
        </div>
      </div>
    </section>

    <EnrollCta />

    <RegisterSection />

    <ClassRegisterDialog />
  </main>
  <Footer />
  <FloatingContact />
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>(
    "[data-schedule-search]",
  );
  const groups = document.querySelectorAll<HTMLElement>("[data-group]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  if (input) {
    const normalize = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/đ/g, "d")
        .trim();

    input.addEventListener("input", () => {
      const q = normalize(input.value);
      let total = 0;

      groups.forEach((group) => {
        let shown = 0;

        group
          .querySelectorAll<HTMLElement>("[data-class-card]")
          .forEach((card) => {
            const match = !q || (card.dataset.search ?? "").includes(q);
            card.hidden = !match;
            if (match) shown += 1;
          });

        group.hidden = shown === 0;
        total += shown;
      });

      if (empty) empty.hidden = total > 0;
    });
  }
</script>
