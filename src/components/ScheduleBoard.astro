---
import type { ScheduleRow } from "@/data/schedule";

interface Props {
  title: string;
  note?: string;
  rows: ScheduleRow[];
}

const { title, note, rows } = Astro.props;

const COLUMNS = [
  { weekday: 1, label: "Thứ 2" },
  { weekday: 2, label: "Thứ 3" },
  { weekday: 3, label: "Thứ 4" },
  { weekday: 4, label: "Thứ 5" },
  { weekday: 5, label: "Thứ 6" },
  { weekday: 6, label: "Thứ 7", weekend: true },
  { weekday: 0, label: "CN", weekend: true },
];

const MODE_LABELS: Record<string, string> = {
  online: "Online",
  hybrid: "Kết hợp",
};

const fixed = rows.filter((row) => row.slots.length > 0);
const flexible = rows.filter((row) => row.slots.length === 0);

const slotsOn = (row: ScheduleRow, weekday: number) =>
  row.slots
    .filter((slot) => slot.weekday === weekday)
    .sort((a, b) => a.startTime.localeCompare(b.startTime));

const cellBase = "border-t border-brand-red-100 px-3 py-3.5 align-middle";
---

<section class="scroll-mt-24">
  <div class="container mx-auto px-6">
    <div class="overflow-hidden rounded-lg border border-brand-red-200 bg-[#fdf8ef]">
      <div class="h-2.5 bg-brand-red-600"></div>

      <div class="px-5 py-8 md:px-9 md:py-10">
        <div class="flex items-center justify-center gap-4">
          <span class="hidden h-px w-16 bg-brand-red-200 sm:block"></span>
          <h2
            class="rounded-lg bg-brand-red-600 px-6 py-2.5 text-center text-lg font-black tracking-tight text-white md:text-xl"
          >
            {title}
          </h2>
          <span class="hidden h-px w-16 bg-brand-red-200 sm:block"></span>
        </div>

        {
          note && (
            <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-relaxed text-brand-ink-700">
              {note}
            </p>
          )
        }

        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-208 border-collapse text-sm">
            <thead>
              <tr>
                <th class="w-56 px-3 pb-3 text-left">
                  <span
                    class="inline-block rounded-full bg-brand-red-50 px-4 py-1.5 text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-brand-red-700"
                  >
                    Lớp
                  </span>
                </th>
                {
                  COLUMNS.map((column) => (
                    <th class="px-2 pb-3">
                      <span class="inline-block w-full rounded-lg bg-brand-red-600 px-3 py-1.5 text-xs font-bold text-white">
                        {column.label}
                      </span>
                    </th>
                  ))
                }
              </tr>
            </thead>

            <tbody>
              {
                fixed.map((row) => (
                  <tr>
                    <th class:list={[cellBase, "text-left"]} scope="row">
                      <span class="block font-mono text-[0.6875rem] font-bold text-brand-red-700">
                        {row.code}
                      </span>
                      <span class="mt-1 block font-bold leading-snug text-brand-ink-900">
                        {row.name}
                      </span>
                      {row.openDate && (
                        <span class="mt-1 block text-xs font-bold text-brand-red-600">
                          Khai giảng {row.openDate}
                        </span>
                      )}
                      {MODE_LABELS[row.mode] && (
                        <span class="mt-1 block text-xs text-muted-foreground">
                          {MODE_LABELS[row.mode]}
                        </span>
                      )}
                    </th>

                    {COLUMNS.map((column) => {
                      const slots = slotsOn(row, column.weekday);

                      return (
                        <td
                          class:list={[
                            cellBase,
                            "text-center",
                            column.weekend && "bg-[#fbf2e2]",
                          ]}
                        >
                          {slots.length === 0 ? (
                            <span class="text-brand-red-200" aria-hidden="true">
                              —
                            </span>
                          ) : (
                            slots.map((slot) => (
                              <span class="block font-bold leading-snug text-brand-ink-900">
                                {slot.startTime}–{slot.endTime}
                              </span>
                            ))
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {
          flexible.length > 0 && (
            <p class="mt-6 rounded-lg border border-brand-red-100 bg-background px-5 py-4 text-sm leading-relaxed text-brand-ink-700">
              <span class="font-bold text-brand-ink-900">Xếp lịch theo học viên:</span>{" "}
              {flexible.map((row) => `${row.name} (${row.cadence || "gọi hotline"})`).join(" · ")}
            </p>
          )
        }
      </div>

      <div class="h-2.5 bg-brand-red-600"></div>
    </div>
  </div>
</section>
