---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { courses } from "@/data/courses";
import { teachers } from "@/data/teachers";
import { imageAsset } from "@/data/imageAssets";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { registerHref } from "@/lib/registerLink";
import {
  clampDescription,
  courseSchema,
  faqSchema,
  keywordsFor,
  pickTitle,
  toIsoDuration,
} from "@/lib/seo";
import { breadcrumbNodes, programSchema } from "@/lib/schema";

// Tra cứu theo params — xem ghi chú ở src/pages/courses/[...slug].astro. Chín chương
// trình này vẫn sinh từ repo (`src/data/courses.ts`), chưa nằm trong bảng `courses`.
const course = courses.find((entry) => entry.slug === Astro.params.slug);
if (!course) return new Response(null, { status: 404 });

const origin = Astro.site?.origin ?? "";
const url = `${origin}${Astro.url.pathname}`;

/**
 * Các trang này có dữ liệu chi tiết nhất trên site (thời lượng, giáo trình, chuẩn
 * đầu ra của từng cấp lớp) nhưng trước đây không phát ra structured data nào. Mỗi
 * cấp lớp trở thành một CourseInstance để Google hiểu khoá có nhiều lớp.
 */
const schemas: Record<string, unknown>[] = [
  {
    ...courseSchema({
      name: course.title,
      description: course.summary,
      url,
      origin,
      provider: { name: site.fullName, address: contact.address },
      workload: course.levels[0]?.duration?.[0],
      level: course.entry,
      credential: course.goal.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/g, ""),
    }),
    ...(course.levels.length
      ? {
          hasCourseInstance: course.levels.map((level) => {
            const workload = toIsoDuration(level.duration?.[0]);
            return {
              "@type": "CourseInstance",
              name: level.name,
              ...(level.code ? { courseCode: level.code } : {}),
              courseMode: ["Onsite", "Online"],
              ...(workload ? { courseWorkload: workload } : {}),
              location: {
                "@type": "Place",
                name: site.fullName,
                address: contact.address,
              },
            };
          }),
        }
      : {}),
  },
  /*
    `EducationalOccupationalProgram` bên cạnh `Course` — không phải khai trùng.

    `Course` trả lời "môn này dạy gì"; node này trả lời "chương trình dài bao lâu,
    tuyển ai, học xong được chứng chỉ gì" — đúng câu người đi tìm nơi học hỏi, và là
    loại node Google dành riêng cho chương trình đào tạo. Khi AI so sánh các trung tâm,
    nó đọc được thời lượng và chuẩn đầu ra ở đây mà không phải parse văn xuôi.
  */
  programSchema({
    name: course.title,
    description: course.summary,
    url,
    origin,
    duration: course.levels[0]?.duration?.[0],
    credential: course.goal.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/g, ""),
  }),
];

// FAQ lấy từ chính dữ liệu khoá học, trả lời đúng ba câu người học hỏi nhiều nhất:
// học bao lâu, đầu vào cần gì, học phí bao nhiêu.
const faqs = [
  ...(course.levels[0]?.duration?.length
    ? [
        {
          question: `Khoá ${course.title} học trong bao lâu?`,
          // Khoá một cấp (vd Cao cấp chỉ có HSK6) thì câu "gồm 1 lớp theo cấp độ"
          // vừa thừa vừa trái với thời lượng đã nêu là 2 lớp HSK6.1 và HSK6.2.
          answer:
            course.levels.length > 1
              ? `${course.levels[0].duration[0]} Khoá gồm ${course.levels.length} lớp theo cấp độ, học viên có thể vào đúng cấp của mình sau khi test trình độ.`
              : `${course.levels[0].duration[0]} Trung tâm test trình độ miễn phí trước khi xếp lớp để bạn vào đúng chặng của mình.`,
        },
      ]
    : []),
  {
    question: `Cần trình độ gì để học ${course.title}?`,
    answer: `Đầu vào của khoá: ${course.entry}. Trung tâm test trình độ miễn phí trước khi xếp lớp để bạn không phải học lại phần đã biết.`,
  },
  {
    question: `Học phí khoá ${course.title} bao nhiêu?`,
    answer: `Học phí tuỳ hình thức lớp (lớp nhóm 10–15 học viên, VIP 1 kèm 1, lớp doanh nghiệp) và cấp lớp bạn vào. Gọi ${contact.phonePrimary} hoặc nhắn Zalo để nhận bảng học phí và lịch khai giảng mới nhất.`,
  },
];

schemas.push(faqSchema(faqs));

/*
  `tone` tô cả icon lẫn nhãn của mục — cùng một màu thì hàng tiêu đề đọc ra một khối
  thay vì icon một màu, chữ một màu.

  Sáu màu đều chọn bậc 600: đây là chữ chứ không còn là hoạ tiết, nên phải đủ tương
  phản trên nền trắng. Riêng vàng ở bậc 500 đã mờ hẳn khi in chữ.
*/
const blocks = [
  { key: "audience", label: "Đối tượng", icon: ICONS.users, tone: "text-brand-ink-900" },
  { key: "goals", label: "Mục tiêu", icon: ICONS.target, tone: "text-brand-ink-900" },
  { key: "duration", label: "Thời lượng", icon: ICONS.clock, tone: "text-brand-ink-900" },
  { key: "content", label: "Nội dung học", icon: ICONS.book, tone: "text-brand-ink-900" },
  { key: "materials", label: "Giáo trình", icon: ICONS.sparkle, tone: "text-brand-ink-900" },
  { key: "outcomes", label: "Chuẩn đầu ra", icon: ICONS.shield, tone: "text-brand-ink-900" },
] as const;

const others = courses.filter((c) => c.slug !== course.slug).slice(0, 8);

/* ---------- Dữ liệu suy ra cho các khối mới ---------- */

/** Tổng buổi/giờ của cả khoá, lấy từ chuỗi thời lượng của từng cấp lớp. */
const firstNumber = (text: string, re: RegExp) => {
  const m = text.match(re);
  return m ? Number(m[1]) : 0;
};
const parsed = course.levels.map((level) => {
  const text = (level.duration ?? []).join(" ");
  return {
    sessions: firstNumber(text, /(\d+)\s*buổi/i),
    hours: firstNumber(text, /(\d+)\s*giờ/i),
  };
});
const sum = (key: "sessions" | "hours") =>
  parsed.reduce((acc, p) => acc + p[key], 0);
/** Chỉ cộng khi mọi cấp lớp đều đọc được số — thiếu một lớp là tổng sai. */
const totals = {
  sessions: parsed.every((p) => p.sessions > 0) ? sum("sessions") : 0,
  hours: parsed.every((p) => p.hours > 0) ? sum("hours") : 0,
};
const totalsLabel = [
  totals.sessions > 0 ? `${totals.sessions} buổi` : "",
  totals.hours > 0 ? `${totals.hours} giờ học` : "",
]
  .filter(Boolean)
  .join(" · ");

/** "Bạn sẽ đạt được gì" — gom chuẩn đầu ra của mọi cấp lớp, bỏ trùng. */
const benefits = [
  ...new Set(course.levels.flatMap((level) => level.outcomes ?? [])),
].slice(0, 6);

/** Bốn thành phần của khoá, theo đúng dữ liệu khoá đang mở. */
const includes = [
  {
    icon: ICONS.cap,
    title:
      course.levels.length > 1
        ? `${course.levels.length} lớp theo cấp độ`
        : (course.levels[0]?.name ?? "Lộ trình riêng theo học viên"),
    desc: "Test trình độ miễn phí trước khi xếp lớp, vào đúng cấp của bạn — không học lại phần đã biết.",
  },
  {
    icon: ICONS.clock,
    title:
      totalsLabel ||
      course.levels[0]?.duration?.[0] ||
      "Thời lượng linh hoạt",
    desc: "Lớp tối và cuối tuần, hình thức offline tại TP.HCM hoặc online — chọn nhịp học phù hợp lịch của bạn.",
  },
  {
    icon: ICONS.book,
    title: "Giáo trình biên soạn riêng",
    desc:
      course.levels[0]?.materials?.[0] ??
      "Giáo trình chuyên biệt do giảng viên trình độ Thạc sĩ, Tiến sĩ của trung tâm biên soạn lại.",
  },
  {
    icon: ICONS.shield,
    title: "Cam kết 100% đầu ra",
    desc: `Mục tiêu khoá: ${course.goal}. Chưa đạt đầu ra đã cam kết, học viên được học lại hoàn toàn miễn phí.`,
  },
];

/*
  Toàn bộ đội ngũ, người phụ trách chuyên môn lên đầu.

  Trước đây khối này lấy 3 người rồi đặt tiêu đề "Ai dạy khoá này" — một khẳng định
  sai: trung tâm không phân giảng viên cố định theo chương trình, ai cũng có thể đứng
  lớp và việc xếp người là theo lịch từng khoá. Cắt 3 người đầu danh sách thành ra
  ngụ ý ba người đó dạy khoá này còn năm người kia thì không.
*/
const isLead = (t: (typeof teachers)[number]) =>
  Number(Boolean((t as { lead?: boolean }).lead));
const staff = [...teachers].sort((a, b) => isLead(b) - isLead(a));

const crumbs = [
  { label: "Các khoá học", href: "/courses" },
  { label: course.title },
];

// Breadcrumb JSON-LD trước đây do PageHero tự phát; hero đã bỏ nên khai ở đây.
schemas.push(...breadcrumbNodes(crumbs, Astro.url.pathname, Astro.site));

/**
 * Ba thông tin người học hỏi đầu tiên, hiển thị ngay dưới H1 — cùng ngôn ngữ thị
 * giác với trang khoá học (src/components/CatalogDetail.astro).
 *
 * Lưu ý: KHÔNG dùng được các token brand-blue-* / brand-pink-* ở đây — trong theme
 * này chúng chỉ là alias trỏ về brand-red-*, nên sẽ ra đỏ hết.
 */
const heroFacts = [
  {
    icon: ICONS.cap,
    label: "Mục tiêu",
    value: course.goal,
    tone: "bg-linear-to-br from-rose-500 to-red-600 shadow-red-500/30",
  },
  {
    icon: ICONS.pin,
    label: "Hình thức học",
    value: "Offline tại TP.HCM hoặc online",
    tone: "bg-linear-to-br from-sky-400 to-blue-600 shadow-blue-500/30",
  },
  {
    icon: ICONS.target,
    label: "Đầu vào",
    value: course.entry,
    tone: "bg-linear-to-br from-emerald-400 to-green-600 shadow-emerald-500/30",
  },
].filter((f) => f.value);

/*
  Lộ trình dạng các chặng, dựng từ chính chuỗi thời lượng của từng cấp lớp:
    · "2 lớp HSK4.1 và HSK4.2, mỗi lớp 3,5 tháng …" → hai chặng HSK4.1, HSK4.2, mỗi chặng 3,5 tháng
    · "… (3 tháng)." hoặc "3,5 tháng · …"            → một chặng, thời lượng đó
  KHÔNG cộng tổng số tháng cả khoá: cách tính tổng (một cấp hay cả lộ trình) chưa được
  trung tâm xác nhận, nên chỉ ghi thời lượng từng lớp đúng như dữ liệu.
*/
const roadmap = course.levels.flatMap((level) => {
  const text = (level.duration ?? []).join(" ");
  const split = text.match(/2 lớp (\S+) và (\S+), mỗi lớp ([\d,]+ tháng)/);
  const goal = level.goals?.[0] ?? level.outcomes?.[0] ?? "";
  if (split) {
    // Hai chặng cùng cấp: chặng sau lấy mục tiêu kế tiếp để hai thẻ không lặp một câu.
    const goals = [...(level.goals ?? []), ...(level.outcomes ?? [])];
    return [
      { name: split[1], months: split[3], goal: goals[0] ?? "" },
      { name: split[2], months: split[3], goal: goals[1] ?? goals[0] ?? "" },
    ];
  }
  const months =
    text.match(/\(([\d,]+ tháng)\)/)?.[1] ?? text.match(/^([\d,]+ tháng)/)?.[1] ?? "";
  return [{ name: level.name.replace(/^Lớp /, ""), months, goal }];
});
const monthNums = roadmap
  .map((r) => Number(r.months.replace(/[^\d,]/g, "").replace(",", ".")))
  .filter((n) => n > 0);
const fmtMonths = (n: number) => String(n).replace(".", ",");
const perClassLabel =
  monthNums.length === 0
    ? ""
    : Math.min(...monthNums) === Math.max(...monthNums)
      ? `${fmtMonths(monthNums[0])} tháng/lớp`
      : `${fmtMonths(Math.min(...monthNums))}–${fmtMonths(Math.max(...monthNums))} tháng/lớp`;

/** Bốn dữ kiện ngay dưới tiêu đề trong banner. */
const quickFacts = [
  { label: "Đầu vào", value: course.entry },
  { label: "Mục tiêu", value: course.goal },
  { label: "Thời lượng", value: perClassLabel || totalsLabel },
  { label: "Hình thức", value: "Offline / Online" },
].filter((f) => f.value);

const sectionTitle =
  "text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-[2rem]";
---

<Layout
  title={pickTitle(
    `Khoá ${course.title} tại TPHCM — ${course.goal} | ${site.shortName}`,
    `Khoá ${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} tại TPHCM | ${site.shortName}`,
    `${course.title} | ${site.shortName}`,
  )}
  description={clampDescription(
    `Khoá ${course.title} tại TP.HCM: ${course.summary} Mục tiêu ${course.goal.toLowerCase()}, đầu vào ${course.entry.toLowerCase()}. Lớp 10–15 học viên, cam kết đầu ra — gọi hotline nhận học phí.`,
  )}
  keywords={keywordsFor(
    `${course.title} TPHCM`,
    `học ${course.title.toLowerCase()}`,
    `học phí ${course.title.toLowerCase()}`,
  )}
  schemas={schemas}
>
  <Header />
  <main id="main" class="pb-16 lg:pb-24">
    {/*
      Banner đỏ rượu như các trang Giới thiệu/Lịch khai giảng: tên khoá, một câu tóm tắt,
      bốn dữ kiện người chọn khoá hỏi đầu tiên (đầu vào, mục tiêu, thời lượng, hình thức)
      và nút đăng ký — đủ để quyết định có đọc tiếp hay không ngay ở màn đầu.
    */}
    <section class="bg-brand-red-900 pt-[var(--header-overlap,0px)] text-[#ffffff]">
      <div class="container mx-auto px-6 py-12 lg:py-16">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-[#ffffff]/65">
            <li>
              <a href="/" class="transition-colors hover:text-white">Trang chủ</a>
            </li>
            {
              crumbs.map((c) => (
                <>
                  <li
                    aria-hidden="true"
                    class="inline-flex items-center opacity-60 [&>svg]:size-3"
                    set:html={ICONS.chevron}
                  />
                  <li>
                    {c.href ? (
                      <a href={c.href} class="transition-colors hover:text-white">
                        {c.label}
                      </a>
                    ) : (
                      <span class="text-[#ffffff]">{c.label}</span>
                    )}
                  </li>
                </>
              ))
            }
          </ol>
        </nav>

        <p class="mt-8 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.22em] text-[#ffffff]/80 uppercase">
          <span class="h-px w-8 bg-[#ffffff]/50" aria-hidden="true"></span>
          {course.goal}
        </p>
        <h1 class="mt-4 max-w-3xl font-serif text-[2.4rem] leading-[1.08] font-medium text-balance md:text-[3.4rem]">
          {course.title}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-[1.65] text-[#ffffff]/90 md:text-[1.0625rem]">
          {course.summary}
        </p>

        <dl class="mt-9 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-5 border-t border-[#ffffff]/15 pt-6 md:grid-cols-4">
          {
            quickFacts.map((f) => (
              <div class="min-w-0">
                <dt class="text-[11px] font-semibold tracking-[0.12em] text-[#ffffff]/60 uppercase">
                  {f.label}
                </dt>
                <dd class="mt-1.5 text-[0.95rem] leading-snug font-bold">{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={registerHref({ course: course.slug })}
            class="group inline-flex h-12 items-center justify-center gap-2 rounded-md bg-[#ffffff] px-7 text-[0.95rem] font-extrabold text-brand-red-900 shadow-lg shadow-black/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-50"
          >
            Đăng ký test trình độ miễn phí
            <span class="transition-transform group-hover:translate-x-1 [&>svg]:size-4" set:html={ICONS.arrow} />
          </a>
          {
            roadmap.length > 1 && (
              <a
                href="#lo-trinh"
                class="inline-flex h-12 items-center justify-center rounded-md border border-[#ffffff]/40 px-7 text-[0.95rem] font-semibold transition-colors hover:border-[#ffffff] hover:bg-white/5"
              >
                Xem lộ trình
              </a>
            )
          }
        </div>
      </div>
    </section>

    <div class="container mx-auto px-6 pt-12 lg:pt-16">
      <!-- Nội dung chạy dọc bên trái, thẻ đăng ký dính bên phải suốt trang -->
      <div class="grid gap-10 lg:grid-cols-[1fr_21rem] lg:items-start lg:gap-14">
        <div class="space-y-14 lg:space-y-16">
          {/*
            Lộ trình — chỉ khi khoá có từ hai chặng trở lên. Mỗi chặng: tên lớp,
            thời lượng, mục tiêu một dòng. Chi tiết từng lớp vẫn ở khối "Chương trình học".
          */}
          {
            roadmap.length > 1 && (
              <section id="lo-trinh" class="scroll-mt-24">
                <h2 class={sectionTitle}>Lộ trình học tập</h2>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
                  Mỗi chặng có mục tiêu và thời lượng riêng. Đã có nền tảng? Trung tâm test
                  trình độ miễn phí để xếp bạn vào đúng chặng.
                </p>
                <ol class="mt-7 grid gap-3 sm:grid-cols-2">
                  {roadmap.map((step, i) => (
                    <li class="rounded-2xl border border-border bg-background p-5">
                      <div class="min-w-0">
                        <p class="text-lg leading-tight font-extrabold text-brand-ink-900">
                          {step.name}
                        </p>
                        {step.months && (
                          <p class="mt-1 text-xs font-bold tracking-[0.08em] text-brand-red-700 uppercase">
                            {step.months}
                          </p>
                        )}
                        {step.goal && (
                          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                            {step.goal}
                          </p>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <!-- Bạn đạt được sau khoá học -->
          {
            benefits.length > 0 && (
              <section id="dau-ra" class="scroll-mt-24">
                <h2 class={sectionTitle}>Bạn đạt được sau khoá học</h2>
                <div class="mt-7 overflow-hidden rounded-2xl border border-border bg-background">
                  {benefits.map((b, i) => (
                    <div
                      class:list={[
                        "flex items-start gap-3.5 px-6 py-5",
                        i > 0 && "border-t border-border",
                      ]}
                    >
                      <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-red-700 text-white [&>svg]:size-3">
                        <Fragment set:html={ICONS.check} />
                      </span>
                      <p class="text-sm leading-relaxed text-brand-ink-800 md:text-base">
                        {b}
                      </p>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          <!-- Chương trình học: chi tiết từng cấp lớp -->
          <section id="noi-dung" class="scroll-mt-24">
            {
              course.levels.length === 0 ? (
                <div class="rounded-2xl border border-border bg-background p-6 md:p-7">
                  <h2 class={sectionTitle}>Thông tin khoá học</h2>
                  <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
                    {course.note}
                  </p>
                  <div class="mt-7 flex flex-wrap gap-3">
                    <a
                      href={`tel:${contact.phonePrimaryRaw}`}
                      class="inline-flex items-center gap-2 rounded-xl bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
                    >
                      <span class="[&>svg]:size-4" set:html={ICONS.phone} />
                      Gọi {contact.phonePrimary}
                    </a>
                    <a
                      href={contact.zalo}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-2 rounded-xl border border-border px-6 py-3.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
                    >
                      Chat Zalo
                    </a>
                  </div>
                </div>
              ) : (
                <>
                  <div class="flex flex-col justify-between gap-3 md:flex-row md:items-end">
                    <h2 class={sectionTitle}>Chương trình học</h2>
                    <p class="text-sm font-bold text-brand-ink-700">
                      {course.levels.length} lớp
                      {totalsLabel ? ` · ${totalsLabel}` : ""}
                    </p>
                  </div>

                  <div class="mt-7 grid gap-4">
                    {course.levels.map((level, i) => (
                      <details
                        class="group overflow-hidden rounded-2xl border border-border bg-background"
                        open={i === 0}
                      >
                        <summary class="flex cursor-pointer list-none items-center gap-4 p-6 md:p-7">
                          <div class="min-w-0 flex-1">
                            <h3 class="text-lg font-extrabold leading-snug text-brand-ink-900">
                              {level.name}
                            </h3>
                            {level.duration?.[0] && (
                              <p class="mt-1 text-xs font-medium text-muted-foreground">
                                {level.duration[0]}
                              </p>
                            )}
                          </div>

                          <span
                            class="shrink-0 text-brand-ink-400 [&>svg]:size-4 [&>svg]:transition-transform group-open:[&>svg]:rotate-180"
                            set:html={ICONS.chevron}
                          />
                        </summary>

                        <div class="grid gap-x-10 gap-y-8 border-t border-border px-6 py-7 md:grid-cols-2 md:px-7">
                          {blocks.map((b) => {
                            const items = level[b.key];
                            if (!items || items.length === 0) return null;
                            return (
                              <section>
                                <h4
                                  class:list={[
                                    "flex items-center gap-2.5 text-sm font-bold uppercase tracking-[0.12em]",
                                    b.tone,
                                  ]}
                                >
                                  <span class="[&>svg]:size-5" set:html={b.icon} />
                                  {b.label}
                                </h4>
                                <ul class="mt-4 space-y-3">
                                  {items.map((it) => (
                                    <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                                      <span
                                        aria-hidden="true"
                                        class="mt-0.5 shrink-0 text-brand-ink-400 [&>svg]:size-4"
                                        set:html={ICONS.plus}
                                      />
                                      <span>{it}</span>
                                    </li>
                                  ))}
                                </ul>
                              </section>
                            );
                          })}
                        </div>
                      </details>
                    ))}
                  </div>
                </>
              )
            }
          </section>

          <!-- Khoá học gồm những gì -->
          <section id="gom-gi" class="scroll-mt-24">
            <h2 class={sectionTitle}>Quyền lợi &amp; cam kết</h2>
            <div class="mt-7 grid gap-4 sm:grid-cols-2">
              {
                includes.map((item) => (
                  <div class="flex flex-col rounded-2xl border border-border bg-background p-6 md:p-7">
                    <span
                      class="text-brand-ink-400 [&>svg]:size-6"
                      set:html={item.icon}
                    />
                    <h3 class="mt-4 text-lg font-extrabold leading-snug text-brand-ink-900">
                      {item.title}
                    </h3>
                    <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                      {item.desc}
                    </p>
                    {item.icon === ICONS.shield && (
                      <a
                        href="/about/commitments"
                        class="group mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-700"
                      >
                        Xem điều kiện cam kết
                        <span class="transition-transform group-hover:translate-x-0.5 [&>svg]:size-4" set:html={ICONS.arrow} />
                      </a>
                    )}
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Lịch khai giảng của đúng chương trình này -->
          <section id="lop-dang-mo" class="scroll-mt-24">
            <h2 class={sectionTitle}>Lịch học {course.title.toLowerCase()}</h2>

            {/*
              Không còn bảng lớp của riêng chương trình này.

              Nó lọc lịch khai giảng theo `programSlug` của từng lớp, mà một dòng lịch
              không nối tới chương trình nào nữa: tờ lịch trên /schedule là chữ giáo vụ
              gõ, không phải các hàng `classes` gom theo khoá (xem `data/scheduleApi.ts`
              và `migrations/017` bên server). Không có cách nào chọn ra "dòng nào thuộc
              chương trình này" mà không đoán theo tên.

              Thay bằng đúng khối vẫn hiển thị trước đây cho chương trình chưa có lớp
              nào: gọi hotline, hoặc xem lịch đầy đủ — link ngay bên dưới.
            */}
            <div class="mt-7 rounded-2xl border-2 border-dashed border-border bg-brand-ink-50/60 p-8 text-center">
              <p class="text-base font-black text-brand-ink-900">
                Lịch khai giảng {course.title.toLowerCase()} cập nhật theo từng đợt
              </p>
              <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
                Xem đợt đang mở ở trang Lịch khai giảng, hoặc gọi hotline để nhận ngày
                khai giảng gần nhất và giữ chỗ — trung tâm xếp lớp ngay khi đủ học viên
                cùng trình độ.
              </p>
              <a
                href={`tel:${contact.phonePrimaryRaw}`}
                class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
              >
                <span class="[&>svg]:size-4" set:html={ICONS.phone} />
                Gọi {contact.phonePrimary}
              </a>
            </div>

            <a
              href="/schedule"
              class="group mt-5 inline-flex items-center gap-2 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-600"
            >
              Xem lịch khai giảng toàn bộ chương trình
              <span
                class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                set:html={ICONS.arrow}
              />
            </a>
          </section>

          <!-- Giảng viên -->
          <section id="giang-vien" class="scroll-mt-24">
            <h2 class={sectionTitle}>Đội ngũ giảng viên</h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
              Toàn bộ giảng viên của trung tâm đều đứng lớp {course.title.toLowerCase()};
              người phụ trách lớp của bạn được xếp theo lịch khai giảng từng khoá.
            </p>

            <div class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {
                staff.map((t) => (
                  <article class="flex gap-4 rounded-2xl border border-border bg-background p-5">
                    {imageAsset(t.image) && (
                      <Image
                        src={imageAsset(t.image)!}
                        alt={t.name}
                        width={160}
                        densities={[1, 2]}
                        format="webp"
                        quality={88}
                        loading="lazy"
                        decoding="async"
                        class="size-16 shrink-0 rounded-xl object-cover"
                      />
                    )}
                    <div class="min-w-0">
                      <h3 class="text-sm font-extrabold leading-snug text-brand-ink-900">
                        {t.name}
                      </h3>
                      <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                        {t.title}
                      </p>
                      {(t as { role?: string }).role && (
                        <p class="mt-2 text-xs font-bold leading-relaxed text-brand-red-700">
                          {(t as { role?: string }).role}
                        </p>
                      )}
                    </div>
                  </article>
                ))
              }
            </div>

            <a
              href="/about/teachers"
              class="group mt-5 inline-flex items-center gap-2 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-600"
            >
              Xem hồ sơ chi tiết từng giảng viên
              <span
                class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                set:html={ICONS.arrow}
              />
            </a>
          </section>

          <!-- FAQ -->
          <section id="faq" class="scroll-mt-24">
            <h2 class={sectionTitle}>Câu hỏi thường gặp</h2>
            <div class="mt-7 grid gap-4">
              {
                faqs.map((f) => (
                  <details class="group overflow-hidden rounded-2xl border border-border bg-background">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 md:p-7">
                      <h3 class="text-base font-extrabold text-brand-ink-900">
                        {f.question}
                      </h3>
                      <span
                        class="shrink-0 text-brand-ink-400 [&>svg]:size-4 [&>svg]:transition-transform group-open:[&>svg]:rotate-180"
                        set:html={ICONS.chevron}
                      />
                    </summary>
                    <p class="border-t border-border px-6 py-6 text-sm leading-relaxed text-muted-foreground md:px-7">
                      {f.answer}
                    </p>
                  </details>
                ))
              }
            </div>
          </section>

          <!-- Khoá học khác -->
          <section id="khoa-khac" class="scroll-mt-24">
            <h2 class="text-xl font-extrabold text-brand-ink-900">Khoá học khác</h2>
            <div class="mt-5 flex flex-wrap gap-3">
              {
                others.map((c) => (
                  <a
                    href={`/courses/programs/${c.slug}`}
                    class="rounded-full border border-border bg-background px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-brand-ink-50"
                  >
                    {c.title}
                  </a>
                ))
              }
            </div>
          </section>
        </div>

        <!-- Thẻ đăng ký, dính khi cuộn -->
        <aside class="lg:sticky lg:top-24 lg:order-last">
          <div
            class="overflow-hidden rounded-2xl border border-border bg-background shadow-sm"
          >
            <div class="relative grid h-40 place-items-center bg-brand-red-900 text-[#ffffff]">
              <span
                aria-hidden="true"
                class="absolute -right-3 -top-6 select-none text-[8rem] font-black leading-none text-white/10">课</span
              >
              <div class="relative text-center">
                <p class="text-3xl font-black leading-none">100%</p>
                <p class="mt-2 text-xs font-bold uppercase tracking-[0.14em]">
                  Cam kết đầu ra
                </p>
              </div>
            </div>

            <div class="p-6">
              <p class="text-center text-base font-black text-brand-ink-900">
                Test trình độ &amp; học thử miễn phí
              </p>
              <p class="mt-2 text-center text-xs leading-relaxed text-muted-foreground">
                Học thử một buổi cùng lớp đang mở rồi mới quyết định.
              </p>

              <a
                href={registerHref({ course: course.slug })}
                class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
              >
                Đăng ký ngay
                <span class="[&>svg]:size-4" set:html={ICONS.arrow} />
              </a>

              <a
                href={`tel:${contact.phonePrimaryRaw}`}
                class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-full border border-border px-6 py-3.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
              >
                <span class="text-brand-ink-400 [&>svg]:size-4" set:html={ICONS.phone} />
                {contact.phonePrimary}
              </a>

              <ul class="mt-6 space-y-3.5 border-t border-border pt-6">
                {
                  [
                    { icon: ICONS.book, text: "Giáo trình biên soạn riêng" },
                    { icon: ICONS.cap, text: "Giảng viên Thạc sĩ – Tiến sĩ" },
                    { icon: ICONS.shield, text: "Không đạt, học lại miễn phí" },
                  ].map((f) => (
                    <li class="flex items-center gap-3 text-sm text-brand-ink-800">
                      <span class="shrink-0 text-brand-ink-400 [&>svg]:size-4">
                        <Fragment set:html={f.icon} />
                      </span>
                      {f.text}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-16 lg:mt-24 lg:gap-24">
      <EnrollCta
        href={registerHref({ course: course.slug })}
        subtitle={`chọn đúng lớp ${course.title}, đúng nhịp học`}
        lines={[
          "Test trình độ đầu vào miễn phí, xếp lớp đúng sức học",
          `Cam kết đầu ra: ${course.goal} — không đạt, học lại miễn phí`,
        ]}
      />
      <RegisterSection course={course.slug} />
    </div>
  </main>

  <Footer />
  <FloatingContact />
</Layout>
