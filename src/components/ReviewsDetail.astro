---
import { Image } from "astro:assets";
import Stars from "@/components/Stars.astro";
import {
  orderedTestimonials,
  reviewAnchor,
  reviewsSummary,
  sourceLabel,
} from "@/data/testimonials";
import { imageAsset } from "@/data/imageAssets";
import { ICONS } from "@/lib/icons";

/**
 * Bản đầy đủ của mọi cảm nhận — đích của link "Chi tiết" trên thẻ ở dải ngang.
 *
 * Vì sao là một mục riêng chứ không dùng lại `Testimonials.astro` với một `variant`:
 * hai chỗ này hiển thị ngược nhau ở đúng những điểm quyết định bố cục. Dải ngang cắt
 * chữ để mọi thẻ cao bằng nhau, thẻ đứng cạnh nhau theo chiều ngang, và chân thẻ dẫn
 * người xem đi tiếp; ở đây chữ phải in trọn vẹn (đó là lý do người xem bấm sang), thẻ
 * xếp dọc theo một cột đọc được, và chân thẻ dẫn ra nguồn. Nhồi cả hai vào một
 * component thì gần như mỗi dòng markup phải rẽ theo `variant`.
 *
 * Thứ tự lấy nguyên từ `orderedTestimonials()` — mới nhất trước — và KHÔNG sắp lại ở
 * đây: mã neo (`reviewAnchor`) tính theo vị trí trong danh sách đó, nên sắp lại là mọi
 * link "Chi tiết" từ trang chủ trỏ sang thẻ của người khác.
 */
const list = orderedTestimonials();
const summary = reviewsSummary();

const initials = (name: string) =>
  name
    .split(" ")
    .slice(-2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

/**
 * Ngày đối chiếu hai con số tổng, in cho người đọc.
 *
 * `timeZone: "UTC"` chứ không để mặc định: `checkedAt` là ngày trần (không giờ), nên
 * `Date` hiểu nó là nửa đêm UTC — render trên máy chủ đặt ở múi giờ âm sẽ lùi về ngày
 * hôm trước.
 */
/*
  Nhãn chủ đề của từng câu chuyện. Đánh giá nào nhắc tới kết quả thi (HSK, TOCFL, thi
  đậu…) là "Hành trình luyện thi" và được xếp lên đầu — câu chuyện có kết quả cụ thể
  thuyết phục hơn lời khen chung, nên người đọc phải gặp chúng trước.

  Không làm bộ lọc theo nhóm: gần như mọi đánh giá đều nói về giảng viên, chỉ vài bài có
  kết quả thi — bộ lọc khi đó chỉ có một nhóm đầy và vài nhóm gần rỗng. Thêm khi số bài
  ở mỗi nhóm đủ nhiều.

  Thứ tự hiển thị đổi, nhưng mã neo vẫn tính theo vị trí GỐC trong `orderedTestimonials()`
  (`reviewAnchor(t, index)`), nên link "Chi tiết" từ trang chủ vẫn trỏ đúng thẻ.
*/
const isExamStory = (quote: string) =>
  /HSK\s?[1-6]|TOCFL|thi (đậu|đỗ)|đậu HSK|đỗ HSK/i.test(quote);

const stories = list
  .map((t, index) => ({ t, index, exam: isExamStory(t.quote) }))
  .sort((a, b) => Number(b.exam) - Number(a.exam));

/** CTA ngắn chen vào sau chừng này thẻ — đủ để đọc vài câu chuyện, chưa phải cuộn hết. */
const CTA_AFTER = 4;

const checkedAtLabel = new Intl.DateTimeFormat("vi-VN", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(summary.checkedAt));
---

<section id="all-reviews" class="scroll-mt-24">
  <div class="container mx-auto px-6">
    <div class="mx-auto max-w-6xl">
      {/*
        Dải tổng quan dán lại khi cuộn: điểm Google trả lời "mấy đánh giá này ở đâu ra" ở
        bất kỳ chỗ nào trong lúc đọc, và nút đăng ký nằm sẵn ở đó — người đọc đã tin thì
        không phải cuộn hết trang mới tìm được chỗ đăng ký.

        `top-20` bằng chiều cao thanh header dán của cả trang cộng một khoảng thở.
      */}
      <div
        class="sticky top-20 z-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-2xl border border-border bg-background/90 px-5 py-4 shadow-[0_10px_30px_-24px_rgb(15_23_42/0.5)] backdrop-blur-md sm:px-6"
      >
        <div class="flex items-center gap-4">
          <span class="text-3xl leading-none font-black tabular-nums text-brand-ink-900">
            {summary.score}<span class="text-base font-bold text-brand-ink-400">/5</span>
          </span>
          <div>
            <Stars rating={5} size="md" label={`${summary.score} trên 5 sao`} />
            <p class="mt-1.5 text-sm leading-snug text-muted-foreground">
              {summary.count} đánh giá trên {summary.sourceLabel}
              <span class="block sm:inline">
                <span class="hidden sm:inline"> · </span>đối chiếu ngày {checkedAtLabel}
              </span>
            </p>
          </div>
        </div>

        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
          <a
            href={summary.sourceUrl}
            target="_blank"
            rel="noopener nofollow"
            class="group inline-flex items-center justify-center gap-1.5 rounded-full border border-border px-5 py-2.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
          >
            Xem trên {summary.sourceLabel}
            <span class="[&>svg]:size-4" set:html={ICONS.arrowUpRight} />
          </a>
          <a
            href="/register"
            class="group inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-red-600 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
          >
            Đăng ký tư vấn miễn phí
            <span class="transition-transform group-hover:translate-x-0.5 [&>svg]:size-4" set:html={ICONS.arrow} />
          </a>
        </div>
      </div>

      {/*
        Lưới hai cột kiểu "cột báo" (`columns-2`) chứ không `grid`: các bài dài ngắn rất
        khác nhau, lưới hàng sẽ để một bài ba dòng đứng cạnh một bài mười lăm dòng với
        một mảng trống bên dưới. Xếp theo cột thì mỗi thẻ cao đúng nội dung của nó.
        Điện thoại một cột. In TRỌN bài, không cắt — trang này tồn tại để đọc hết.
      */}
      <ol class="mt-8 gap-5 md:columns-2">
        {
          stories.map(({ t, index, exam }, i) => {
            const image = imageAsset(t.image);
            const meta = [sourceLabel(t.source), t.postedAt].filter(Boolean);

            return (
              <>
                {i === CTA_AFTER && (
                  <li class="mb-5 break-inside-avoid rounded-2xl bg-brand-red-900 px-6 py-7 text-white md:px-8">
                    <p class="font-serif text-2xl leading-snug font-medium">
                      Bạn muốn bắt đầu học tiếng Trung?
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-white/80">
                      Nhận tư vấn lộ trình và kiểm tra trình độ miễn phí.
                    </p>
                    <a
                      href="/register"
                      class="group mt-5 inline-flex items-center gap-2 rounded-md bg-[#f8f1e7] px-6 py-3 text-sm font-extrabold text-brand-red-900 transition-colors hover:bg-white"
                    >
                      Đăng ký tư vấn miễn phí
                      <span class="transition-transform group-hover:translate-x-1 [&>svg]:size-4" set:html={ICONS.arrow} />
                    </a>
                  </li>
                )}

                {/* `scroll-mt-44` bù cho header dán và dải tổng quan `sticky` phía trên. */}
                <li
                  id={reviewAnchor(t, index)}
                  class="mb-5 break-inside-avoid scroll-mt-44 rounded-2xl border border-border bg-background p-6 transition-colors target:border-brand-red-300 md:p-7"
                >
                  <div class="flex items-center justify-between gap-3">
                    <span class="inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.1em] text-brand-ink-500 uppercase">
                      <span
                        class:list={["size-1.5 rounded-full", exam ? "bg-brand-red-600" : "bg-brand-ink-300"]}
                        aria-hidden="true"
                      />
                      {exam ? "Hành trình luyện thi" : "Trải nghiệm học tập"}
                    </span>
                    {t.rating && (
                      <Stars
                        rating={t.rating}
                        label={`${t.rating}/5 sao — đánh giá của ${t.name}`}
                        class="shrink-0"
                      />
                    )}
                  </div>

                  {/* Nội suy chứ không `set:html`, cùng lý do như ở `Testimonials.astro`. */}
                  <blockquote class="mt-4 text-[0.95rem] leading-7 whitespace-pre-line text-brand-ink-800 md:text-base">
                    {t.quote}
                  </blockquote>

                  <div class="mt-6 flex items-center gap-3 border-t border-brand-ink-100 pt-5">
                    {image ? (
                      <Image
                        src={image}
                        alt={`Học viên ${t.name}`}
                        width={96}
                        densities={[1, 2]}
                        format="webp"
                        quality={85}
                        loading="lazy"
                        decoding="async"
                        class="size-11 shrink-0 rounded-full object-cover object-top"
                      />
                    ) : (
                      <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-ink-100 text-sm font-bold text-brand-ink-700">
                        {initials(t.name)}
                      </span>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-base leading-tight font-bold text-brand-ink-900">{t.name}</p>
                      {(t.role || meta.length > 0) && (
                        <p class="mt-0.5 truncate text-sm text-muted-foreground">
                          {t.role || meta.join(" · ")}
                        </p>
                      )}
                    </div>
                    {/* Link bài gốc đặt sau bản đầy đủ: đọc xong mới có thứ để kiểm chứng. */}
                    {t.link && (
                      <a
                        href={t.link}
                        target="_blank"
                        rel="noopener nofollow"
                        class="inline-flex shrink-0 items-center gap-1 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-700"
                      >
                        Bài gốc
                        <span class="sr-only"> — đánh giá của {t.name}</span>
                        <span class="[&>svg]:size-4" set:html={ICONS.arrowUpRight} />
                      </a>
                    )}
                  </div>
                </li>
              </>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
