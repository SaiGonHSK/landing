---
import CourseBadge from "@/components/CourseBadge.astro";
import { sessionLines, type ScheduleRow } from "@/data/schedule";
import { contact } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { registerHref } from "@/lib/registerLink";

/**
 * Lưới thẻ lịch khai giảng: badge chương trình (cùng `CourseBadge` với lưới khoá học ở
 * trang chủ) rồi tên lớp và các dòng thông tin có icon — ngày khai giảng, từng buổi học
 * trong tuần, nhịp học, nơi học.
 *
 * Vì sao dạng thẻ này chứ không chỉ bảng (`ScheduleBoard`): bảng tuần trả lời "lớp nào
 * học buổi nào", còn người đang chọn lớp cần đọc trọn một lớp trong một khối — ngày khai
 * giảng, giờ, thời lượng, nơi học — rồi bấm đăng ký ngay tại đó. Hai thành phần bổ sung
 * nhau, không thay nhau.
 *
 * Chỉ có lưới, không có `<section>` hay tiêu đề: trang lịch đặt lưới này trong từng khối
 * chương trình đã có tiêu đề riêng, còn `Schedule.astro` bọc thêm tiêu đề cho trang chủ.
 */
interface Props {
  rows: ScheduleRow[];
  class?: string;
}

const { rows, class: className = "" } = Astro.props;

const MODE_LABELS: Record<string, string> = {
  offline: "Offline",
  online: "Online",
  hybrid: "Kết hợp",
};

/**
 * Nơi học. Địa chỉ đầy đủ chỉ có ở lớp offline và viết ngắn: mười lăm thẻ offline cùng
 * một địa chỉ, in đủ mỗi thẻ thì dòng dài nhất của thẻ lại là dòng ít phân biệt nhất.
 */
const placeOf = (row: ScheduleRow) =>
  row.mode === "online"
    ? "Học online, lớp trực tuyến tương tác"
    : row.mode === "hybrid"
      ? "Kết hợp online và học tại trung tâm"
      : `Học tại trung tâm · ${contact.addressShort.split(",")[0]}`;


/**
 * Bốn dòng thông tin của một thẻ. Mỗi dòng là một mảng chuỗi vì lớp học nhiều buổi mỗi
 * tuần thì phần giờ học chiếm mấy dòng liền nhau dưới cùng một icon.
 */
const detailsOf = (row: ScheduleRow) => {
  /** Lớp GT1, GT2, VIP xếp lịch theo học viên nên `slots` rỗng — dùng `cadenceNote`. */
  const fixed = row.slots.length > 0;

  return [
    {
      icon: ICONS.calendar,
      lines: [
        row.openDate
          ? `Khai giảng ${row.openDate}`
          : "Khai giảng linh hoạt — gọi để xếp lớp",
      ],
      strong: true,
    },
    {
      icon: ICONS.clock,
      lines: fixed
        ? sessionLines(row.slots)
        : [row.cadenceNote || "Giờ học xếp theo học viên"],
      strong: false,
    },
    {
      icon: ICONS.cap,
      lines: [fixed ? `${row.slots.length} buổi/tuần · ${row.duration}` : row.duration],
      strong: false,
    },
    {
      icon: row.mode === "online" ? ICONS.monitor : ICONS.pin,
      lines: [placeOf(row)],
      strong: false,
    },
  ];
};

/** Chuỗi để lọc client-side (`[data-schedule-search]`), bỏ dấu để gõ không dấu vẫn ra. */
const searchKey = (row: ScheduleRow) =>
  `${row.code} ${row.name} ${row.target} ${row.cadence}`
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/đ/g, "d");

const cards = rows.map((row) => ({
  row,
  /**
   * Chữ trên badge.
   *
   * Nhãn khối giáo vụ gõ ("Tiếng Trung Sơ cấp") vì badge là thứ gom cả lưới thẻ về một
   * mối; dòng không có nhãn thì rơi về tên lớp. Không tra sang `programs` nữa — một dòng
   * lịch không nối tới chương trình nào, xem `data/scheduleApi.ts`.
   */
  courseTitle: row.group || row.name,
  details: detailsOf(row),
  /**
   * Khách bấm "Đăng ký giữ chỗ" trên đúng một dòng thì form phải biết dòng nào — mang
   * theo nhãn khối (thử chọn sẵn trong select khoá) lẫn mã lớp (vào ghi chú của lead).
   *
   * Nhãn khối là chữ tự do nên có thể không khớp lựa chọn nào trong select khoá học;
   * khi đó `resolveCourseOption` trả `undefined` và select ở `/register` giữ nguyên
   * trạng thái chưa chọn, không đoán bừa một khoá gần giống.
   *
   * Vẫn giữ dù trang lịch đã có modal (`ClassRegisterDialog`): nút là `<a>` thật, và
   * script chỉ chặn khi modal dựng được. Không JS thì khách vẫn tới được form.
   */
  href: registerHref({
    course: row.group,
    classCode: row.code,
    // `itemId` để `/register` chọn sẵn đúng ca trong ô "Lớp muốn giữ chỗ". Mã lớp một
    // mình không đủ: nhiều ca dùng chung một mã.
    itemId: row.id,
  }),
  /** Dòng phụ trong modal, nhắc lại lớp nào để khách không phải nhớ mình vừa bấm gì. */
  meta: [row.openDate && `Khai giảng ${row.openDate}`, row.cadence, placeOf(row)]
    .filter(Boolean)
    .join(" · "),
}));
---

{/*
  Thẻ lớp, thứ tự thông tin cố định cho mọi lớp để so được bằng mắt:
    mã lớp + hình thức → tên lớp → NGÀY KHAI GIẢNG (khối nổi bật) → lịch học trong tuần
    → thời lượng & nơi học (chữ phụ) → nút đăng ký.
  Nút luôn ở đáy thẻ (`mt-auto`), các thẻ cùng hàng cao bằng nhau nhờ lưới.
*/}
<div class:list={["grid gap-5 md:grid-cols-2 lg:grid-cols-3", className]}>
  {
    cards.map(({ row, courseTitle, details, href, meta }) => (
      <article
        data-class-card
        data-search={searchKey(row)}
        class="flex flex-col overflow-hidden rounded-2xl border border-border bg-background transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-32px_rgb(17_24_39/0.45)]"
      >
        <div class="h-24 border-b border-border">
          <CourseBadge title={courseTitle} />
        </div>

        <div class="px-5 pt-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-brand-ink-200 px-2.5 py-0.5 font-mono text-[0.6875rem] font-bold tracking-[0.06em] text-brand-ink-700 uppercase">
              {row.code}
            </span>
            <span
              class:list={[
                "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[0.6875rem] font-bold",
                row.mode === "online"
                  ? "bg-brand-ink-900 text-white"
                  : "bg-brand-ink-100 text-brand-ink-700",
              ]}
            >
              <span class="[&>svg]:size-3" set:html={row.mode === "online" ? ICONS.monitor : ICONS.pin} />
              {MODE_LABELS[row.mode] ?? row.mode}
            </span>
          </div>
          <h3 class="mt-3 text-lg leading-tight font-black text-brand-ink-900">
            {row.name}
          </h3>
        </div>

        {/* Ngày khai giảng — thứ người tìm lớp so trước tiên, nên nó là khối nổi bật duy
            nhất trong thẻ. */}
        <div class="mx-5 mt-4 flex items-center gap-3 rounded-xl bg-brand-red-50 px-4 py-3">
          <span class="text-brand-red-700 [&>svg]:size-5" set:html={ICONS.calendar} />
          <div class="min-w-0">
            <p class="text-[0.6875rem] font-semibold tracking-[0.08em] text-brand-red-700/80 uppercase">
              Khai giảng
            </p>
            <p class="text-base leading-tight font-black text-brand-ink-900">
              {row.openDate || "Linh hoạt — gọi để xếp lớp"}
            </p>
          </div>
        </div>

        <div class="px-5 pt-4">
          <p class="text-[0.6875rem] font-semibold tracking-[0.08em] text-brand-ink-400 uppercase">
            Lịch học
          </p>
          <ul class="mt-1.5 space-y-1 text-sm leading-relaxed font-semibold text-brand-ink-800">
            {details[1].lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>

        <div class="space-y-1 px-5 pt-3 pb-5 text-[13px] leading-relaxed text-brand-ink-500">
          <p class="flex gap-2">
            <span class="mt-0.5 shrink-0 [&>svg]:size-3.5" set:html={ICONS.cap} />
            {details[2].lines[0]}
          </p>
          <p class="flex gap-2">
            <span class="mt-0.5 shrink-0 [&>svg]:size-3.5" set:html={row.mode === "online" ? ICONS.monitor : ICONS.pin} />
            {details[3].lines[0]}
          </p>
        </div>

        <div class="mt-auto border-t border-border p-5">
          {row.openDate ? (
            /*
              `<a>` thật, không phải `<button>`: `ClassRegisterDialog` chặn cú bấm và mở
              modal ngay tại trang, nhưng chỉ khi modal dựng được — không JS, hoặc trình
              duyệt không có `dialog.showModal`, thì link vẫn đưa khách tới `/register`.

              `data-class-id` là id dòng lịch: modal in tên đúng ca vào ghi chú của lead,
              và mang theo khi phải lùi sang `/register`. Mã lớp không dùng được vì nhiều
              ca chung một mã.
            */
            <a
              href={href}
              data-class-register
              data-class-id={row.id}
              data-class-name={row.name}
              data-class-code={row.code}
              data-course={row.group}
              data-class-meta={meta}
              class="block rounded-full bg-brand-red-600 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
            >
              Đăng ký giữ chỗ
            </a>
          ) : (
            <a
              href={`tel:${contact.phonePrimaryRaw}`}
              class="flex items-center justify-center gap-2 rounded-full border border-border py-3 text-center text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
            >
              <span class="[&>svg]:size-4" set:html={ICONS.phone} />
              Gọi để xếp lớp
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>
