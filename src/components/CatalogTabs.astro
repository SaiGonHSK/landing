---
import type { CatalogTab } from "@/components/CourseCatalog.astro";

interface Props {
  tabs: CatalogTab[];
  allLabel?: string;
}

const { tabs, allLabel = "Tất cả" } = Astro.props;

const filled = tabs.filter((tab) => tab.cards.length > 0);

const chips = [
  { key: "all", label: allLabel, count: filled.reduce((n, tab) => n + tab.cards.length, 0) },
  ...filled.map((tab) => ({ key: tab.key, label: tab.label, count: tab.cards.length })),
];
---
<nav aria-label="Nhóm khoá học" class="mt-8 w-full">
  <ul class="flex flex-wrap justify-center gap-2.5">
    {
      chips.map((chip, index) => {
        const active = index === 0;

        return (
          <li>
            <button
              type="button"
              data-catalog-tab={chip.key}
              aria-pressed={active ? "true" : "false"}
              class:list={[
                "inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-semibold transition-colors",
                active
                  ? "border-brand-ink-900 bg-brand-ink-900 text-white"
                  : "border-border text-foreground hover:border-brand-ink-900 hover:bg-brand-ink-50",
              ]}
            >
              {chip.label}
              <span
                data-catalog-count
                class:list={[
                  "rounded-full px-1.5 py-0.5 text-[0.6875rem] font-bold tabular-nums",
                  active ? "bg-white/15 text-white" : "bg-brand-ink-50 text-muted-foreground",
                ]}
              >
                {chip.count}
              </span>
            </button>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  const ACTIVE = ["border-brand-ink-900", "bg-brand-ink-900", "text-white"];
  const IDLE = [
    "border-border",
    "text-foreground",
    "hover:border-brand-ink-900",
    "hover:bg-brand-ink-50",
  ];
  const ACTIVE_COUNT = ["bg-white/15", "text-white"];
  const IDLE_COUNT = ["bg-brand-ink-50", "text-muted-foreground"];

  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-catalog-tab]");
  const groups = document.querySelectorAll<HTMLElement>("[data-catalog-group]");

  const select = (key: string) => {
    for (const tab of tabs) {
      const on = tab.dataset.catalogTab === key;
      tab.setAttribute("aria-pressed", String(on));
      for (const cls of ACTIVE) tab.classList.toggle(cls, on);
      for (const cls of IDLE) tab.classList.toggle(cls, !on);

      const count = tab.querySelector<HTMLElement>("[data-catalog-count]");
      if (count) {
        for (const cls of ACTIVE_COUNT) count.classList.toggle(cls, on);
        for (const cls of IDLE_COUNT) count.classList.toggle(cls, !on);
      }
    }

    for (const group of groups) {
      group.hidden = key !== "all" && group.dataset.catalogGroup !== key;
    }
  };

  for (const tab of tabs) {
    tab.addEventListener("click", () => select(tab.dataset.catalogTab ?? "all"));
  }
</script>
