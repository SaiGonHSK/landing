---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import ArticleGrid from "@/components/ArticleGrid.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { site } from "@/data/site";
import { clampDescription, itemListSchema } from "@/lib/seo";
import { collectionPageSchema } from "@/lib/schema";
import type { LibraryArticle } from "@/data/library";

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  crumbs: { label: string; href?: string }[];
  glyph?: string;

  articles: LibraryArticle[];
  emptyMessage?: string;
}

const {
  title,
  metaTitle,
  description,
  crumbs,
  glyph = "书",
  articles,
  emptyMessage,
} = Astro.props;

const origin = Astro.site?.origin ?? "";
const schemas = [
  collectionPageSchema({ pathname: Astro.url.pathname, site: Astro.site }),
  itemListSchema(
    metaTitle ?? title,
    articles.map((article) => ({ title: article.title, href: article.slug })),
    origin,
  ),
];
---

<Layout
  title={`${metaTitle ?? title} | ${site.shortName}`}
  description={clampDescription(description)}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col">
    <PageHero
      title={title}
      description={description}
      crumbs={crumbs}
      glyph={glyph}
      align="center"
    />

    <section class="bg-background pb-16 lg:pb-20">
      <div class="container mx-auto px-6">
        <ArticleGrid articles={articles} emptyMessage={emptyMessage} />
      </div>
    </section>
  </main>
  <Footer />
  <FloatingContact />
</Layout>
