---
import Logo from "@/components/Logo.astro";
import { contact } from "@/data/site";
import { menu, groupChildren, plainChildren, type MenuChild } from "@/data/pages";
import { ICONS } from "@/lib/icons";

interface Props {
  path?: string;
}
const { path = Astro.url.pathname } = Astro.props;

const clean = path.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return clean === "/";
  return clean === href || clean.startsWith(`${href}/`);
};

/**
 * Trong một dropdown chỉ đánh dấu mục khớp sâu nhất: ở `/about/differences` thì
 * `/about` cũng khớp theo tiền tố, nếu không lọc sẽ sáng cả "Về chúng tôi".
 */
const deepestSlug = (children: MenuChild[]) =>
  children
    .map((c) => c.slug)
    .filter(isActive)
    .sort((a, b) => b.length - a.length)[0];

/*
  Header trong suốt — đè lên banner đỏ rượu ở đầu trang; cuộn xuống thì về
  nền đỏ đặc như mọi trang khác. Chỉ bật ở những trang mở đầu bằng banner tối (`HeroV5`,
  `AboutHero`): ở trang nền sáng, header kính chữ trắng sẽ không đọc được.
  Thêm trang có banner tối thì thêm đường dẫn vào đây.
*/
const GLASS_PATHS = ["/", "/about", "/about/achievements", "/about/commitments", "/schedule"];
const glass = GLASS_PATHS.includes(clean) || clean.startsWith("/courses/programs/");

const visibleNav = menu.filter((entry) => !entry.hidden);
const mainNav = visibleNav.filter((entry) => !entry.cta);
const ctaNav = visibleNav.find((entry) => entry.cta);
---

<header
  id="site-header"
  data-scrolled="false"
  data-glass={glass ? "true" : undefined}
  class="sticky top-0 z-40 border-b border-white/10 bg-brand-red-600 backdrop-blur-sm transition-all duration-300 data-[scrolled=true]:shadow-lg data-[scrolled=true]:shadow-brand-red-950/25"
>
  <div class="container mx-auto flex items-center gap-4 px-6 py-3">
    {/* Logo co theo nội dung, menu đẩy sang phải (`ml-auto`). Bản trước chia ba cột
        `flex-1` để menu nằm chính giữa — ở khổ 1024 menu tràn chạm mép phải. */}
    <div class="flex shrink-0 items-center">
      <Logo onDark />
    </div>

    <nav class="ml-auto hidden items-center gap-0.5 lg:flex xl:gap-1">
      {
        mainNav.map((item) => {
          const active = isActive(item.slug);
          const groups = groupChildren(item.children);
          const plain = plainChildren(item.children);
          const hasMenu = groups.length > 0 || plain.length > 0;
          const current = deepestSlug(item.children);

          const linkClass = `inline-flex items-center gap-1.5 rounded-full px-2.5 py-2 text-sm font-medium whitespace-nowrap xl:px-3.5 text-white transition-colors ${
            active ? "bg-white/15 font-semibold" : "hover:bg-white/10"
          }`;

          if (!hasMenu) {
            return (
              <a href={item.slug} class={linkClass}>
                {item.label}
              </a>
            );
          }

          return (
            <div class="group/menu relative" data-menu data-open="false">
              <button
                type="button"
                data-menu-trigger
                aria-haspopup="true"
                aria-expanded="false"
                class={`${linkClass} cursor-pointer`}
              >
                {item.label}
                <span
                  class="[&>svg]:size-3.5 [&>svg]:transition-transform group-data-[open=true]/menu:[&>svg]:rotate-180"
                  set:html={ICONS.chevron}
                />
              </button>

              {groups.length > 0 ? (
                <div
                  data-menu-panel
                  data-mega
                  data-open="false"
                  class="invisible fixed inset-x-0 z-30 translate-y-1 opacity-0 transition-all duration-200 data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
                >
                  <div class="container mx-auto px-4">
                    <div class="overflow-hidden rounded-3xl border border-border bg-background/98 shadow-2xl backdrop-blur-md">
                      <div class="grid gap-x-6 gap-y-8 p-7 md:grid-cols-4">
                        {groups.map((group) => (
                          <div>
                            <a
                              href={group.slug ?? item.slug}
                              class="block text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600 transition-opacity hover:opacity-70"
                            >
                              {group.title}
                            </a>
                            <ul class="mt-3.5 space-y-0.5">
                              {group.items.map((link) => (
                                <li>
                                  <a
                                    href={link.slug}
                                    aria-current={
                                      link.slug === current ? "page" : undefined
                                    }
                                    class:list={[
                                      "block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-muted",
                                      link.slug === current
                                        ? "font-semibold text-brand-red-700"
                                        : "font-medium text-foreground/80",
                                    ]}
                                  >
                                    {link.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      <a
                        href={item.slug}
                        class="group/all flex items-center justify-between gap-3 border-t border-border bg-brand-ink-50 px-7 py-4 text-sm font-bold text-foreground transition-colors hover:text-brand-red-600"
                      >
                        Xem tất cả {item.label.toLowerCase()}
                        <span
                          class="transition-transform group-hover/all:translate-x-1 [&>svg]:size-4"
                          set:html={ICONS.arrow}
                        />
                      </a>
                    </div>
                  </div>
                </div>
              ) : (
                <div
                  data-menu-panel
                  data-open="false"
                  class="invisible absolute left-0 top-full z-30 w-72 translate-y-1 opacity-0 transition-all duration-200 data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
                >
                  <div class="overflow-hidden rounded-2xl border border-border bg-background/98 p-2 shadow-xl backdrop-blur-md">
                    {plain.map((link) => (
                      <a
                        href={link.slug}
                        aria-current={link.slug === current ? "page" : undefined}
                        class:list={[
                          "block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-muted",
                          link.slug === current
                            ? "font-semibold text-brand-red-700"
                            : "font-medium text-foreground/80",
                        ]}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center justify-end gap-2 lg:ml-0">
      {
        ctaNav && (
          <a
            href={ctaNav.slug}
            class="hidden shrink-0 items-center gap-2 rounded-full bg-white px-6 py-2.5 text-sm font-bold whitespace-nowrap text-brand-red-700 shadow-[0_10px_24px_-14px_rgba(0,0,0,0.55)] transition-transform hover:-translate-y-0.5 lg:inline-flex"
          >
            {ctaNav.label}
          </a>
        )
      }

      <a
        href={`tel:${contact.phonePrimaryRaw}`}
        aria-label={`Gọi ${contact.phonePrimary}`}
        class="inline-flex size-9 items-center justify-center rounded-full bg-white text-brand-ink-500 lg:hidden [&>svg]:size-4"
        set:html={ICONS.phone}
      />
      <button
        type="button"
        id="mobile-menu-trigger"
        aria-label="Mở menu"
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-lg border border-white/35 text-white transition-colors hover:bg-white/10 lg:hidden [&>svg]:size-5"
        set:html={ICONS.menu}
      />
    </div>
  </div>
</header>

<div
  id="mobile-drawer-overlay"
  data-open="false"
  class="pointer-events-none fixed inset-0 z-50 bg-black/50 opacity-0 transition-opacity duration-300 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
>
</div>
<aside
  id="mobile-drawer"
  data-open="false"
  class="fixed inset-y-0 right-0 z-50 w-[88vw] max-w-sm translate-x-full overflow-y-auto bg-background shadow-2xl transition-transform duration-300 data-[open=true]:translate-x-0"
>
  <div
    class="flex items-center justify-between border-b border-border px-5 py-4"
  >
    <Logo />
    <button
      type="button"
      id="mobile-menu-close"
      aria-label="Đóng menu"
      class="inline-flex size-9 cursor-pointer items-center justify-center rounded-lg border border-border [&>svg]:size-4"
      set:html={ICONS.close}
    />
  </div>

  <nav class="flex flex-col gap-1 px-4 py-5">
    {
      visibleNav.map((item) => {
        const groups = groupChildren(item.children);
        const plain = plainChildren(item.children);
        const hasMenu = groups.length > 0 || plain.length > 0;
        if (!hasMenu) {
          return (
            <a
              href={item.slug}
              class:list={[
                "rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors",
                item.cta
                  ? "bg-brand-red-600 text-center text-white"
                  : "text-foreground hover:bg-muted",
              ]}
            >
              {item.label}
            </a>
          );
        }

        return (
          <details class="group rounded-lg">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 text-sm font-semibold text-foreground">
              {item.label}
              <span
                class="text-muted-foreground [&>svg]:size-4 [&>svg]:transition-transform group-open:[&>svg]:rotate-180"
                set:html={ICONS.chevron}
              />
            </summary>

            <div class="mt-1 flex flex-col gap-0.5 pb-3 pl-3">
              <a
                href={item.slug}
                class="rounded-md px-3 py-2 text-sm font-bold text-brand-red-600"
              >
                Tổng quan
              </a>

              {plain.map((link) => (
                <a
                  href={link.slug}
                  class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              ))}

              {groups.map((group) => (
                <div class="mt-2">
                  {group.slug ? (
                    <a
                      href={group.slug}
                      class="block px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-brand-red-600"
                    >
                      {group.title}
                    </a>
                  ) : (
                    <p class="px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-brand-red-600">
                      {group.title}
                    </p>
                  )}
                  {group.items.map((link) => (
                    <a
                      href={link.slug}
                      class="block rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </details>
        );
      })
    }
  </nav>

  <div class="mt-2 border-t border-border px-5 py-5">
    <a
      href={`tel:${contact.phonePrimaryRaw}`}
      class="flex w-full items-center justify-center gap-2 rounded-full bg-brand-red-600 px-4 py-3 text-sm font-bold text-white"
    >
      <span class="[&>svg]:size-4" set:html={ICONS.phone} />
      Gọi {contact.phonePrimary}
    </a>
    <a
      href={contact.zalo}
      target="_blank"
      rel="noopener"
      class="mt-2 flex w-full items-center justify-center gap-2 rounded-full bg-brand-ink-50 px-4 py-3 text-sm font-bold text-foreground"
    >
      Chat Zalo
    </a>
  </div>
</aside>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (header) header.dataset.scrolled = String(window.scrollY > 8);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /*
    Header kính đè lên banner: header kéo nội dung phía sau lên đúng bằng chiều cao của
    nó (`margin-bottom` âm), banner bù lại bằng `padding-top: var(--header-overlap)`.
    Đo bằng script vì header cao khác nhau giữa mobile và desktop. Không có JS thì biến
    không được đặt, header nằm trong luồng như bình thường — không đè, không mất chữ.
  */
  if (header?.dataset.glass === "true") {
    const root = document.documentElement;
    const measure = () => {
      root.style.setProperty("--header-overlap", `${header.offsetHeight}px`);
    };
    measure();
    window.addEventListener("resize", measure, { passive: true });
    if (document.fonts) document.fonts.ready.then(measure);
  }

  document.querySelectorAll<HTMLElement>("[data-menu]").forEach((wrap) => {
    const panel = wrap.querySelector<HTMLElement>("[data-menu-panel]");
    if (!panel) return;
    let timer: ReturnType<typeof setTimeout>;

    /** Mọi panel đều bắt đầu ngay dưới đáy header, cách đúng GAP — kể cả panel
     *  absolute (neo theo link, thấp hơn đáy header) và panel mega (fixed). */
    const GAP = 8;
    const align = () => {
      const headerBottom = header?.getBoundingClientRect().bottom ?? 0;

      if (panel.hasAttribute("data-mega")) {
        panel.style.top = `${headerBottom}px`;
        panel.style.paddingTop = `${GAP}px`;
        return;
      }

      const wrapBottom = wrap.getBoundingClientRect().bottom;
      panel.style.paddingTop = `${Math.max(0, headerBottom - wrapBottom) + GAP}px`;
    };

    const trigger = wrap.querySelector<HTMLElement>("[data-menu-trigger]");

    const setOpen = (value: boolean) => {
      wrap.dataset.open = String(value);
      panel.dataset.open = String(value);
      trigger?.setAttribute("aria-expanded", String(value));
    };

    const open = () => {
      clearTimeout(timer);
      align();
      setOpen(true);
    };
    const closeNow = () => {
      clearTimeout(timer);
      setOpen(false);
    };
    const close = () => {
      clearTimeout(timer);
      timer = setTimeout(() => setOpen(false), 140);
    };

    wrap.addEventListener("mouseenter", open);
    wrap.addEventListener("mouseleave", close);
    wrap.addEventListener("focusin", open);
    wrap.addEventListener("focusout", close);

    /** Nút cha không điều hướng — chỉ mở/đóng panel (quan trọng cho touch). */
    trigger?.addEventListener("click", () => {
      if (wrap.dataset.open === "true") closeNow();
      else open();
    });

    document.addEventListener("click", (e) => {
      if (!wrap.contains(e.target as Node)) closeNow();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNow();
    });
  });

  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-drawer-overlay");
  const setDrawer = (open: boolean) => {
    if (drawer) drawer.dataset.open = String(open);
    if (overlay) overlay.dataset.open = String(open);
    document.body.style.overflow = open ? "hidden" : "";
  };
  document
    .getElementById("mobile-menu-trigger")
    ?.addEventListener("click", () => setDrawer(true));
  document
    .getElementById("mobile-menu-close")
    ?.addEventListener("click", () => setDrawer(false));
  overlay?.addEventListener("click", () => setDrawer(false));
  drawer
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setDrawer(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setDrawer(false);
  });
</script>

<style>
  #site-header[data-glass="true"] {
    margin-bottom: calc(-1 * var(--header-overlap, 0px));
  }

  /* Trong suốt hẳn khi CHƯA cuộn — banner phía sau lộ nguyên màu. Cuộn xuống thì rơi về
     nền đỏ của lớp tiện ích như mọi trang khác. */
  #site-header[data-glass="true"][data-scrolled="false"] {
    background-color: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
</style>
