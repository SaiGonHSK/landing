---
import SectionHeading from "@/components/SectionHeading.astro";
import RoadmapIllustration from "@/components/RoadmapIllustration.astro";
import { roadmap } from "@/data/courses";
import { ICONS } from "@/lib/icons";
---

<section id="roadmap" class="relative bg-background scroll-mt-24">
  <div class="container mx-auto px-6">
    <SectionHeading
      title="Bốn chặng rõ ràng từ"
      highlight="vỡ lòng đến HSK6"
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        roadmap.map((s) => (
          <article class="group flex flex-col rounded-lg border border-border bg-background p-5 transition-colors hover:border-brand-ink-300">
            <div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-lg bg-brand-ink-50">
              <RoadmapIllustration
                step={s.step}
                alt={`Minh hoạ chặng ${s.step} — ${s.title}`}
                class="p-2"
              />
            </div>

            <div class="mt-5 flex items-center gap-3">
              <span class="text-sm font-black text-brand-red-600">
                {s.step}
              </span>
              <span class="h-px flex-1 bg-border" />
              <span class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-muted-foreground">
                {s.code}
              </span>
            </div>

            <h3 class="mt-3 text-xl font-black leading-tight text-brand-ink-900">
              {s.title}
            </h3>
            <p class="mt-1.5 text-sm font-bold text-brand-red-600">
              {s.result}
            </p>
            <p class="mt-3 text-sm leading-[1.75] text-brand-ink-700">
              {s.desc}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-5 rounded-lg border border-border bg-brand-ink-50 p-7 md:flex-row md:items-center md:p-8"
    >
      <div>
        <p class="text-xl font-black text-brand-ink-900 md:text-2xl">
          Không chắc mình đang ở chặng nào?
        </p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">
          Trung tâm test năng lực đầu vào miễn phí dựa trên vốn từ, giáo trình bạn đã
          học và ngữ pháp bạn đã nắm.
        </p>
      </div>

      <a
        href="/register"
        class="group inline-flex shrink-0 items-center gap-2 rounded-lg border border-border bg-background px-7 py-3.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-background/60"
      >
        Đăng ký test miễn phí
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>
    </div>
  </div>
</section>
