---
import { Image } from "astro:assets";
import { ICONS } from "@/lib/icons";
import { teachers } from "@/data/teachers";
import { imageAsset } from "@/data/imageAssets";

/**
 * Đội ngũ giảng viên ở dạng chân dung tròn — bản rút gọn của `Teacher.astro` (dải thẻ
 * vuông có lớp phủ thành tích khi rê chuột).
 *
 * Trang /about cần *khuôn mặt* của trung tâm chứ không cần hồ sơ đầy đủ: tên, học vị,
 * một dòng nói rõ thầy cô làm gì, rồi dẫn sang /about/teachers cho ai muốn đọc tiếp.
 * Dải thẻ có lớp phủ để nguyên ở trang giảng viên, nơi nó là nội dung chính.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;

  /**
   * Số chân dung hiển thị. Mặc định 4 — vừa **một** hàng ở desktop.
   *
   * Cả tám thầy cô thì thành hai hàng, và hàng thứ hai ở trang giới thiệu không thêm
   * thông tin nào: người đọc đã hiểu "đội ngũ có học vị cao" từ hàng đầu, phần còn lại
   * là việc của /about/teachers — nơi nút cuối khối này dẫn tới.
   */
  limit?: number;
}

const {
  eyebrow = "Đội ngũ của chúng tôi",
  title,
  description,
  ctaHref = "/about/teachers",
  ctaLabel = "Xem đầy đủ đội ngũ giảng viên",
  limit = 4,
} = Astro.props;

const shown = teachers.slice(0, limit);

/**
 * Chữ cái đầu của tên, dùng khi giảng viên chưa có ảnh. Bỏ "Cô/Thầy" vì mọi tên đều có,
 * giữ tối đa 2 chữ cái cho vừa vòng tròn.
 */
const initialsOf = (name: string) =>
  name
    .replace(/^(cô|thầy)\s+/i, "")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

/**
 * Một dòng giới thiệu ngắn: lấy `role` nếu có (giảng viên phụ trách chuyên môn), còn
 * lại lấy gạch đầu dòng thứ hai của banner — dòng đầu là học vị, đã hiện ở `title`.
 */
const blurbOf = (t: (typeof teachers)[number]) => {
  const role = (t as { role?: string }).role;
  if (role) return role;
  const points = (t as { points?: readonly string[] }).points ?? [];
  return points[1] ?? points[0] ?? "";
};

/*
  Ảnh giảng viên đều là banner vuông theo cùng một khuôn: người đứng giữa, đầu ở khoảng
  1/4 trên, nửa dưới là dải đỏ có tên. Cắt tròn nguyên tấm sẽ dính dải đỏ và chữ, nên
  phóng ảnh lên ~2.2 lần rồi dịch sao cho khung tròn ôm đúng phần đầu–vai.

  Con số lấy từ khuôn chung của bộ banner (tâm khuôn mặt ≈ 52% chiều ngang, 30% chiều
  dọc), đã đối chiếu cả 8 tấm. Banner mới chụp theo đúng khuôn thì không phải sửa gì;
  chụp khác khuôn thì phần lệch sẽ thấy ngay ở khung tròn này.
*/

/* Cùng khuôn đó, cắt vào khung 4:5: ảnh vuông rộng 270% khung (tức cao 216% khung), dịch
   trái để tâm mặt (52% bề ngang ảnh) về giữa khung. Khung lấy từ ~0.5% đến ~47% chiều cao
   banner — dải đỏ có tên bắt đầu ở ~53%, nên không lộ vào chân ảnh. */
const PORTRAIT_CROP = "width:270%;left:-90.4%;top:-1%";

---

{/*
  Phần nặng ký nhất của trang Giới thiệu, nên nó có nền riêng (trắng ngà, cùng tông với chữ
  trên hero đỏ rượu) và mỗi giảng viên là một tấm hồ sơ: chân dung cắt cùng một khung, học
  vị + trường, chuyên môn, và lối vào hồ sơ đầy đủ. `id="doi-ngu"` là đích của nút "Khám
  phá đội ngũ" trên hero.
*/}
<section id="doi-ngu" class="about-team scroll-mt-24 py-16 lg:py-24">
  <div class="container mx-auto px-6">
    <div class="flex flex-col items-center text-center">
      <p class="text-[11px] font-bold tracking-[0.18em] text-brand-red-700 uppercase">
        {eyebrow}
      </p>

      <h2
        class="mt-4 font-serif text-[2.1rem] leading-[1.1] font-medium tracking-tight text-balance text-brand-ink-900 md:text-[2.9rem]"
      >
        {title}
      </h2>

      {
        description && (
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-brand-ink-600">
            {description}
          </p>
        )
      }
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        shown.map((t) => (
          <li class="group flex flex-col overflow-hidden rounded-2xl border border-[#eadfd3] bg-white shadow-[0_18px_40px_-32px_rgb(17_24_39/0.5)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_50px_-30px_rgb(17_24_39/0.55)]">
            {/* Chân dung: banner gốc vuông, nửa dưới là dải đỏ có tên — phóng lên rồi cắt
                lấy phần đầu–vai trong khung 4:5, mọi giảng viên cùng một khung. */}
            <div class="relative aspect-[4/5] overflow-hidden bg-[#f6efe6]">
              {imageAsset(t.image) ? (
                <Image
                  src={imageAsset(t.image)!}
                  alt={t.title ? `${t.name} — ${t.title}` : t.name}
                  loading="lazy"
                  decoding="async"
                  width={640}
                  densities={[1, 2]}
                  format="webp"
                  quality={88}
                  class="absolute h-auto max-w-none transition-transform duration-500 group-hover:scale-[1.03]"
                  style={PORTRAIT_CROP}
                />
              ) : (
                <span class="flex size-full items-center justify-center font-serif text-5xl text-brand-ink-900/25">
                  {initialsOf(t.name)}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-serif text-[1.3rem] leading-tight font-semibold text-brand-ink-900">
                {t.name}
              </h3>

              {t.title && (
                <p class="mt-2 text-[13px] leading-snug font-semibold text-brand-red-700">
                  {t.title}
                </p>
              )}

              {/* Chặn 3 dòng: các dòng thành tích lấy nguyên văn từ banner rất dài, để tự
                  do thì các thẻ trong cùng hàng lệch chân nhau. */}
              <p class="mt-3 line-clamp-3 min-h-[3lh] text-[13px] leading-relaxed text-brand-ink-600">
                {blurbOf(t)}
              </p>

              <a
                href={ctaHref}
                class="mt-auto inline-flex items-center gap-1.5 border-t border-dashed border-[#eadfd3] pt-4 text-[13px] font-bold text-brand-ink-900 transition-colors hover:text-brand-red-700"
              >
                Xem hồ sơ
                <span class="[&>svg]:size-3.5" set:html={ICONS.arrow} />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex justify-center">
      <a
        href={ctaHref}
        class="group inline-flex h-12 items-center gap-2 rounded-md bg-brand-red-900 px-7 text-sm font-bold text-white transition-colors hover:bg-brand-red-800"
      >
        {ctaLabel}
        <span
          class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
          set:html={ICONS.arrow}
        />
      </a>
    </div>
  </div>
</section>

<style>
  .about-team {
    background: #faf6f1;
  }
</style>
