---
import { formatArticleDate, type LibraryArticle } from "@/data/library";

interface Props {
  articles: LibraryArticle[];
  emptyMessage?: string;
  eagerFirst?: boolean;
}

const { articles, emptyMessage, eagerFirst = true } = Astro.props;
---

{
  articles.length === 0 && emptyMessage && (
    <p class="rounded-3xl bg-brand-ink-50 px-6 py-10 text-center text-sm leading-relaxed text-muted-foreground">
      {emptyMessage}
    </p>
  )
}

{
  articles.length > 0 && (
    <div class="grid gap-5 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {articles.map((article, index) => (
        <article class="overflow-hidden rounded-3xl border border-border transition-colors hover:border-brand-red-600/40">
          <a href={article.slug} class="group flex h-full flex-col">
            {article.coverImage && (
              <div class="overflow-hidden">
                <img
                  src={article.coverImage}
                  alt=""
                  loading={eagerFirst && index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="aspect-video w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
                />
              </div>
            )}

            <div class="flex flex-1 flex-col p-6 md:p-7">
              <h3 class="text-xl font-extrabold leading-snug text-balance text-brand-ink-900 transition-colors group-hover:text-brand-red-600 md:text-[1.375rem]">
                {article.title}
              </h3>

              {article.summary && (
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {article.summary}
                </p>
              )}

              <p class="mt-auto pt-6 text-sm text-muted-foreground">
                <time datetime={article.publishedAt ?? undefined}>
                  {formatArticleDate(article.publishedAt)}
                </time>
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>
  )
}
