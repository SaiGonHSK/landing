---
import { Image } from "astro:assets";
import { site, contact, footerLinks, legal } from "@/data/site";
import { ICONS } from "@/lib/icons";
import logoMark from "@/assets/logo-mark.webp";

const year = new Date().getFullYear();

const glyph = (d: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="${d}"/></svg>`;

const socials = [
  { label: "Facebook", href: contact.facebook, icon: ICONS.facebook },
  { label: "TikTok", href: contact.tiktok, icon: ICONS.tiktok },
  {
    label: "Zalo",
    href: contact.zalo,
    icon: glyph(
      "M12 2C6.5 2 2 5.8 2 10.4c0 2.6 1.4 4.9 3.6 6.5-.1.9-.5 2.3-1.4 3.6-.2.3.1.7.5.6 1.9-.5 3.4-1.5 4.3-2.2 1 .2 1.9.3 3 .3 5.5 0 10-3.8 10-8.4S17.5 2 12 2z",
    ),
  },
];

const [coursesGroup, practiceGroup, centerGroup] = footerLinks;

const HEAD = "border-b border-white/20 pb-3 text-sm font-bold tracking-[0.04em] text-white uppercase";
const LINK = "text-[15px] text-white/85 transition-colors hover:text-white";
---

<footer class="bg-brand-red-600 text-white">
  <div class="container mx-auto px-6 pt-14 pb-10 lg:pt-16">
    <a href="/" class="inline-flex items-center gap-3">
      <span class="inline-flex size-12 items-center justify-center rounded-full bg-white">
        <Image
          src={logoMark}
          alt={`${site.name} logo`}
          width={36}
          densities={[1, 2]}
          format="webp"
          quality={90}
          class="size-9 object-contain"
        />
      </span>
      <span class="text-xl leading-tight font-extrabold tracking-[0.04em] uppercase">
        Hoa văn<br />SaigonHSK
      </span>
    </a>

    <div class="mt-12 grid gap-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.8fr)_minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
      <div class="flex flex-col gap-10">
        <section>
          <h3 class={HEAD}>Cơ sở tại TP.HCM</h3>
          <ul class="mt-4 space-y-3 text-[15px] text-white/85">
            <li>
              <span class="font-bold text-white">Cơ sở chính:</span>{" "}
              <a href={contact.mapsUrl} target="_blank" rel="noopener" class="hover:text-white hover:underline">
                {contact.address}
              </a>
            </li>
            <li>
              <span class="font-bold text-white">Giờ làm việc:</span> {contact.workingHours}
            </li>
          </ul>
        </section>

        <section>
          <h3 class={HEAD}>Thông tin liên hệ</h3>
          <ul class="mt-4 space-y-3 text-[15px] text-white/85">
            <li>
              <span class="font-bold text-white">Hotline:</span>{" "}
              {
                contact.phones.map((p, i) => (
                  <>
                    {i > 0 && " – "}
                    <a href={`tel:${p.replace(/\./g, "")}`} class="hover:text-white hover:underline">
                      {p}
                    </a>
                  </>
                ))
              }
            </li>
            <li>
              <span class="font-bold text-white">Email:</span>{" "}
              <a href={`mailto:${contact.email}`} class="hover:text-white hover:underline">{contact.email}</a>
            </li>
            <li>
              <span class="font-bold text-white">Inbox:</span>{" "}
              <a href={contact.zalo} target="_blank" rel="noopener" class="hover:text-white hover:underline">
                Nhắn tin qua Zalo
              </a>
            </li>
          </ul>
        </section>

        <section>
          <h3 class="text-[15px] font-bold">Theo dõi SaigonHSK tại</h3>
          <div class="mt-4 flex items-center gap-3">
            {
              socials.map(({ href, label, icon }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener"
                  aria-label={label}
                  class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white hover:text-brand-red-700"
                >
                  <span aria-hidden="true" class="[&>svg]:size-4" set:html={icon} />
                </a>
              ))
            }
          </div>
        </section>
      </div>

      <section>
        <h3 class={HEAD}>{coursesGroup.title}</h3>
        <ul class="mt-4 space-y-3">
          {coursesGroup.items.map((item) => (
            <li><a href={item.href} class={LINK}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <div class="flex flex-col gap-10">
        <section>
          <h3 class={HEAD}>{practiceGroup.title}</h3>
          <ul class="mt-4 space-y-3">
            {practiceGroup.items.map((item) => (
              <li><a href={item.href} class={LINK}>{item.label}</a></li>
            ))}
          </ul>
        </section>

        <section>
          <h3 class={HEAD}>Về SaigonHSK</h3>
          <ul class="mt-4 space-y-3">
            {centerGroup.items.map((item) => (
              <li><a href={item.href} class={LINK}>{item.label}</a></li>
            ))}
            <li><a href="/privacy" class={LINK}>Chính sách bảo mật</a></li>
          </ul>
        </section>
      </div>
    </div>

    <div class="mt-14 space-y-1.5 border-t border-white/20 pt-8 text-[15px] text-white/75">
      <p>© {year} Hoa văn SaigonHSK. All rights reserved.</p>
      <p>{site.license.label} — {site.license.authority}.</p>
      {legal.company && <p>Thuộc sở hữu của {legal.company}</p>}
      {legal.taxCode && <p>MST: {legal.taxCode}</p>}
    </div>
  </div>
</footer>
