---
import { Image } from "astro:assets";
import { ICONS } from "@/lib/icons";
import registerTeacher from "@/assets/register-teacher.webp";

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  lines?: string[];
  href?: string;
  label?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  cutout?: boolean;
  class?: string;
}

const {
  badge = "Khai giảng hằng tháng",
  title = "Ghi danh sớm",
  subtitle = "chọn đúng lớp, đúng nhịp học",
  lines = [
    "Test trình độ đầu vào miễn phí, xếp lớp đúng sức học",
    "Cam kết 100% đầu ra — không đạt, học lại miễn phí",
  ],
  href = "/register",
  label = "Đăng ký ngay",
  image = registerTeacher,
  imageAlt = "Giảng viên Hoa văn SaigonHSK mời đăng ký khoá học tiếng Trung",
  cutout,
  class: className = "",
} = Astro.props;

const isCutout = cutout ?? image === registerTeacher;
---

<section class:list={[className]}>
  <div class="container mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-2xl bg-brand-red-600 px-7 py-10 md:px-12 md:py-14 lg:min-h-[24rem]"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 right-0 hidden w-1/2 [background-image:radial-gradient(rgb(255_255_255/0.28)_1.5px,transparent_1.5px)] [background-size:12px_12px] [mask-image:linear-gradient(to_right,transparent,#000_45%)] lg:block"
      ></span>

      {
        isCutout && (
          <>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-10 right-4 hidden size-[24rem] rounded-full bg-white/25 blur-2xl lg:block xl:right-16"
            />
            <span
              aria-hidden="true"
              class="pointer-events-none absolute bottom-0 right-10 hidden h-[19rem] w-[15rem] -rotate-6 rounded-[3rem] bg-white/10 lg:block xl:right-24"
            />
          </>
        )
      }

      <div
        class:list={[
          "relative",
          isCutout
            ? "lg:max-w-[31rem] xl:max-w-[39rem]"
            : "grid items-center gap-10 lg:grid-cols-[1fr_0.8fr]",
        ]}
      >
        <div>
          <h2
            class="text-[2rem] font-black leading-[1.1] tracking-tight text-balance text-white md:text-[2.5rem]"
          >
            {title}
            {subtitle && <span class="block">{subtitle}</span>}
          </h2>

          {
            lines.length > 0 && (
              <ul class="mt-7 space-y-3.5">
                {lines.map((line) => (
                  <li class="flex items-center gap-3 text-sm font-medium text-white md:text-base">
                    <span
                      class="shrink-0 text-white/80 [&>svg]:size-4"
                      set:html={ICONS.check}
                    />
                    {line}
                  </li>
                ))}
              </ul>
            )
          }

          <a
            href={href}
            class="group mt-9 inline-flex items-center gap-2 rounded-lg bg-white px-7 py-4 text-sm font-bold text-brand-red-700 transition-transform hover:-translate-y-0.5"
          >
            {label}
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>

        {
          !isCutout && (
            <Image
              src={image}
              alt={imageAlt}
              width={480}
              densities={[1, 2]}
              format="webp"
              quality={88}
              loading="lazy"
              decoding="async"
              class="hidden aspect-4/3 w-full rounded-lg object-cover lg:block"
            />
          )
        }
      </div>

      {
        isCutout && (
          <Image
            src={image}
            alt={imageAlt}
            height={416}
            densities={[1, 2]}
            format="webp"
            quality={88}
            loading="lazy"
            decoding="async"
            class="pointer-events-none absolute bottom-0 right-6 hidden h-[26rem] w-auto object-contain object-bottom [filter:drop-shadow(0_0_2px_rgb(255_255_255/0.5))_drop-shadow(0_18px_30px_rgb(0_0_0/0.28))] lg:block xl:right-20"
          />
        )
      }
    </div>
  </div>
</section>
