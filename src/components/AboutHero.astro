---
import type { ImageMetadata } from "astro";
import SplitHero from "@/components/SplitHero.astro";
import studentsCutout from "@/assets/hero/hoc-vien-hsk1-hsk4-tach-nen.webp";

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  /** Ảnh chụp thường (không tách nền) — hiển thị dạng thẻ bo góc. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Giữ để các trang cũ không phải sửa — hero mới không dùng các tuỳ chọn này. */
  facts?: { value: string; label: string }[];
  imageShape?: "photo" | "square";
  motion?: "reveal" | "wipe" | "circle";
}

const {
  title,
  lead,
  eyebrow = "Về Hoa văn SaigonHSK",
  cta = { label: "Khám phá đội ngũ", href: "#doi-ngu" },
  image,
  imageAlt,
} = Astro.props;
---

<SplitHero
  title={title}
  eyebrow={eyebrow}
  lead={lead}
  cta={cta}
  image={image ?? studentsCutout}
  imageAlt={image ? imageAlt : "Học viên SaigonHSK cầm giáo trình HSK1 và HSK4"}
  cutout={!image}
/>
