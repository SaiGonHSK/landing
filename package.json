{
  "name": "hoavan-hsk-landingpage",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "kill:port": "lsof -ti tcp:4321 | xargs kill -9 2>/dev/null || true",
    "predev": "yarn kill:port",
    "dev": "astro dev",
    "build:dev": "astro build",
    "build:prod": "PUBLIC_API_BASE=/ astro build && yarn check:prod && ./scripts/build-prod.sh",
    "check:prod": "if grep -rq 'localhost:9909' dist/client/; then echo '✗ dist/client còn localhost:9909 — KHONG duoc rsync len VPS'; exit 1; else echo '✓ dist/client sach, dua len VPS duoc'; fi",
    "prepreview": "yarn kill:port",
    "preview": "astro preview",
    "gen:values": "node scripts/gen-value-images.mjs",
    "gen:og": "node scripts/gen-og-image.mjs",
    "astro": "astro",
    "gen:teachers": "node scripts/gen-teacher-images.mjs",
    "gen:library": "node scripts/gen-library-images.mjs",
    "gen:faculty": "node scripts/gen-faculty-image.mjs",
    "gen:hero": "node scripts/gen-hero-cutout.mjs",
    "gen:favicon": "node scripts/gen-favicons.mjs",
    "img:webp": "node scripts/to-webp.mjs",
    "check:schema": "node scripts/check-schema.mjs"
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/fuzzy-bubbles": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
