---
import SectionHeading from "@/components/SectionHeading.astro";
import RegisterForm from "@/components/RegisterForm.astro";
import { contact } from "@/data/site";

interface Props {
  course?: string;
  note?: string;
}

const { course, note } = Astro.props;
---

<section id="register" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Nhận tư vấn lộ trình và"
      highlight="test trình độ miễn phí"
      description="Để lại thông tin, giảng viên của trung tâm sẽ liên hệ tư vấn lộ trình phù hợp với mục tiêu, trình độ và thời gian của bạn."
    />

    <div class="mt-16 flex flex-col gap-8">

      <div class="rounded-3xl bg-brand-ink-50 p-6 md:p-9">
        <RegisterForm course={course} note={note} />
      </div>

      <div class="overflow-hidden rounded-3xl">
        <iframe
          src={contact.mapEmbedUrl}
          title="Bản đồ đường đi tới Trung tâm Hoa văn SaigonHSK"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-[320px] w-full border-0 md:h-[400px]"></iframe>
      </div>
    </div>
  </div>
</section>
