---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import RailHint from "@/components/RailHint.astro";
import HeroBackdrop from "@/components/HeroBackdrop.astro";
import Stars from "@/components/Stars.astro";
import {
  orderedTestimonials,
  reviewDetailHref,
  reviewsSummary,
  sourceLabel,
  testimonials,
} from "@/data/testimonials";
import { imageAsset } from "@/data/imageAssets";
import { ICONS } from "@/lib/icons";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const summary = reviewsSummary();

const initials = (name: string) =>
  name
    .split(" ")
    .slice(-2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

const list = orderedTestimonials()
  .slice(0, limit ?? Infinity)
  .map((item, index) => ({ item, index }));

const badgeOf = (quote: string) => {
  const hsk = quote.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/, "");
  const tocfl = quote.match(/TOCFL(\s+Band\s+[A-C]\d?)?/i)?.[0];
  if (hsk && tocfl) return `${hsk.toUpperCase()} · TOCFL`;
  return hsk?.toUpperCase() ?? tocfl ?? "Học viên SaigonHSK";
};
---
<section
  id="reviews"
  class="relative isolate scroll-mt-24 overflow-hidden pt-12 pb-28 sm:pb-36 lg:pt-16 lg:pb-44"
>
  <HeroBackdrop stickers="wide" />

  <div class="container relative mx-auto px-6">
    <SectionHeading
      title="Chuyện của"
      highlight="học viên SaigonHSK"
      description="Những trải nghiệm thực tế trên hành trình chinh phục tiếng Trung."
    />

    <div class="mt-8 flex justify-center">
      <a
        href={summary.sourceUrl}
        target="_blank"
        rel="noopener nofollow"
        class="group/summary inline-flex items-center gap-4 rounded-2xl border border-[#eadfd3] bg-white px-6 py-4 shadow-[0_18px_40px_-32px_rgb(17_24_39/0.5)] transition-colors hover:border-brand-red-300"
      >
        <span class="text-4xl leading-none font-black tracking-tight text-brand-ink-900">
          {summary.score}<span class="text-lg font-bold text-brand-ink-400"> / 5</span>
        </span>
        <span class="h-10 w-px bg-[#eadfd3]" aria-hidden="true"></span>
        <span class="flex flex-col items-start gap-1">
          <Stars rating={5} label={`${summary.score} trên 5 sao`} />
          <span class="text-sm font-medium text-brand-ink-600">
            {summary.count} đánh giá trên {summary.sourceLabel}
          </span>
        </span>
        <span
          class="text-brand-red-700 transition-transform group-hover/summary:translate-x-0.5 [&>svg]:size-4"
          set:html={ICONS.arrowUpRight}
        />
      </a>
    </div>

    <div data-rail class="group/rail relative mt-10">
      <div
        data-rail-track
        class="flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto md:gap-5 scroll-smooth pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
        list.map(({ item: t, index }, i) => {
          const image = imageAsset(t.image);

          const slide = i === 0 ? "left" : i === 1 ? "right" : undefined;

          return (
            <figure
              data-review-card
              data-review-slide={slide}
              class="flex w-[min(88vw,34rem)] shrink-0 snap-start flex-col overflow-hidden rounded-2xl border border-[#eadfd3] bg-white shadow-[0_18px_40px_-34px_rgb(17_24_39/0.5)] lg:w-[calc((100%-1.25rem)/2)]"
            >
              <div class="flex flex-1 gap-6 p-6 md:p-8">
                <div class="flex flex-1 flex-col justify-center">
                  <div class="flex items-center justify-between gap-4">
                    <span
                      aria-hidden="true"
                      class="font-serif text-7xl leading-[0.55] text-brand-red-600/80"
                    >
                      &ldquo;
                    </span>
                    {t.rating && (
                      <Stars
                        rating={t.rating}
                        label={`${t.rating}/5 sao — đánh giá của ${t.name}`}
                      />
                    )}
                  </div>
                  <blockquote class="mt-5 line-clamp-9 whitespace-pre-line text-[0.95rem] leading-7 text-brand-ink-800 md:text-base md:leading-[1.8]">
                    {t.quote}
                  </blockquote>
                </div>

                {image && (
                  <Image
                    src={image}
                    alt={`Học viên ${t.name}`}
                    width={288}
                    densities={[1, 2]}
                    format="webp"
                    quality={85}
                    loading="lazy"
                    decoding="async"
                    class="hidden aspect-[3/4] w-36 shrink-0 self-start rounded-2xl object-cover object-top sm:block"
                  />
                )}
              </div>

              <figcaption class="mt-auto flex items-center justify-between gap-4 border-t border-brand-ink-100 px-6 py-4 md:px-8">
                <div class="flex min-w-0 items-center gap-3">
                  {image ? (
                    <Image
                      src={image}
                      alt=""
                      width={96}
                      densities={[1, 2]}
                      format="webp"
                      quality={85}
                      loading="lazy"
                      decoding="async"
                      class="size-12 shrink-0 rounded-full object-cover object-top"
                    />
                  ) : (
                    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-ink-100 text-sm font-bold text-brand-ink-700">
                      {initials(t.name)}
                    </span>
                  )}

                  <div class="min-w-0">
                    <p class="truncate text-base font-bold text-brand-ink-900">
                      {t.name}
                    </p>
                    <p class="truncate text-sm text-muted-foreground">
                      {t.role ||
                        [sourceLabel(t.source), t.postedAt]
                          .filter(Boolean)
                          .join(" · ")}
                    </p>
                  </div>
                </div>

                <div class="flex shrink-0 items-center gap-5">
                  <span class="hidden text-[11px] font-semibold tracking-[0.08em] text-brand-ink-400 uppercase sm:inline">
                    {badgeOf(t.quote)}
                  </span>

                  <a
                    href={reviewDetailHref(t, index)}
                    class="group/detail inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink-900 transition-colors hover:text-brand-red-700"
                  >
                    Chi tiết
                    <span class="sr-only">
                      {" "}đánh giá của {t.name}
                    </span>
                    <span
                      class="transition-transform group-hover/detail:translate-x-0.5 [&>svg]:size-4"
                      set:html={ICONS.arrow}
                    />
                  </a>
                </div>
              </figcaption>
            </figure>
          );
        })
        }
      </div>

      <RailHint label="đánh giá" />
    </div>

    {limit !== undefined && limit < testimonials().length && (
      <div class="mt-8 flex justify-center">
        <a
          href="/about/reviews"
          class="group inline-flex items-center gap-2 rounded-lg border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
        >
          Xem tất cả cảm nhận và đánh giá
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      document.querySelectorAll("[data-review-slide]").forEach((el) => {
        el.classList.add(
          "reveal",
          "reveal-child",
          "reveal-x-" + el.dataset.reviewSlide
        );
      });
    })();
  </script>
</section>
