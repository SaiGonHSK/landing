---
import SectionHeading from "@/components/SectionHeading.astro";
import CourseBadge from "@/components/CourseBadge.astro";
import RailHint from "@/components/RailHint.astro";
import { featuredPrograms, visiblePrograms } from "@/data/programsApi";
import { ICONS } from "@/lib/icons";

interface Props {

  showHeading?: boolean;

  limit?: number;
}
const { showHeading = true, limit } = Astro.props;

/*
  Chương trình lấy từ trang quản trị (bảng `landing_programs`), không còn danh sách
  cứng trong repo.

  "Nổi bật" là một ô tích ở console, thứ tự là thứ tự trong màn hình Chương trình đào
  tạo — trung tâm tự quyết trang chủ hiện gì mà không cần deploy. Phần văn dài của
  trang chi tiết vẫn sinh từ repo và ghép theo `slug`; xem `programsApi.ts`.
*/
const all = visiblePrograms();
const featured = featuredPrograms();

// Chưa tích chương trình nào thì lấy tạm những mục đầu danh sách — một khối trống
// trên trang chủ tệ hơn nhiều so với việc hiện đại diện vài chương trình.
const source = featured.length > 0 ? featured : all;
const list = limit ? source.slice(0, limit) : source;
const hasMore = list.length < all.length;

/*
  Nhãn đối tượng — để người mới biết ngay khoá nào dành cho mình, người luyện thi thấy ngay
  khoá luyện thi. Suy từ `icon` của chương trình (đã khai sẵn theo đúng nhóm này) chứ không
  thêm trường mới ở trang quản trị.
*/
const AUDIENCE: Record<string, string> = {
  hsk: "Luyện thi chứng chỉ",
  seed: "Cho người mới bắt đầu",
  chat: "Cho người mới bắt đầu",
  growth: "Nâng cao trình độ",
  peak: "Nâng cao trình độ",
  briefcase: "Cho doanh nghiệp",
  vip: "Học 1 kèm 1",
  kids: "Cho thiếu nhi",
  senior: "Cho người lớn tuổi",
};

/*
  Thời lượng: lấy số tháng ghi trong `levels[].duration` ("… (3 tháng)."), gộp thành một
  khoảng. Chương trình nào không khai thì bỏ dòng này — không tự đoán.
*/
const durationOf = (c: (typeof list)[number]) => {
  const months = (c.levels ?? [])
    .flatMap((l) => l.duration)
    .map((d) => d.match(/\(([\d,]+)\s*tháng\)/)?.[1])
    .filter((m): m is string => Boolean(m))
    .map((m) => Number(m.replace(",", ".")));
  if (months.length === 0) return null;
  const lo = Math.min(...months);
  const hi = Math.max(...months);
  const fmt = (n: number) => String(n).replace(".", ",");
  return lo === hi ? `${fmt(lo)} tháng/khoá` : `${fmt(lo)}–${fmt(hi)} tháng/khoá`;
};
---

<section id="courses" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    {
      showHeading && (
        <SectionHeading
          title={hasMore ? "Chương trình" : "Mười chương trình cho"}
          highlight={hasMore ? "nổi bật nhất" : "mọi mục tiêu tiếng Trung"}
          description="Từ lớp vỡ lòng, luyện thi cam kết đầu ra đến giao tiếp cấp tốc, doanh nghiệp và VIP 1 kèm 1 — chương trình nào cũng rõ lộ trình và chuẩn đầu ra."
        />
      )
    }

    <div data-rail class="group/rail relative mt-10 lg:mt-12">
      <div
        data-rail-track
        class="course-rail -mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0 lg:pb-0"
      >
      {
        list.map((c) => (
          <a
            href={`/courses/programs/${c.slug}`}
            class={"group flex w-[78vw] max-w-80 shrink-0 snap-start flex-col rounded-3xl bg-brand-ink-50 p-3 transition-transform duration-300 hover:-translate-y-1.5 sm:w-80 lg:w-auto lg:max-w-none"}
          >

            {/* Banner thấp hơn bản cũ (h-40 → h-32) và mảng đỏ hẹp lại: nó là nhận diện,
                không phải nội dung — chỗ dành lại cho ba dòng thông tin bên dưới. */}
            <div class="relative h-32 overflow-hidden rounded-2xl">
              <CourseBadge
                title={c.title}
                class="transition-transform duration-300 group-hover:scale-105"
              />
            </div>

            <div class="flex flex-1 flex-col px-3 pt-5 pb-2 sm:px-4">
              <span class="w-fit rounded-full bg-brand-red-50 px-2.5 py-1 text-[11px] font-bold text-brand-red-700 ring-1 ring-brand-red-100">
                {AUDIENCE[c.icon] ?? c.goal}
              </span>

              <h3 class="mt-3 text-xl font-extrabold leading-snug text-brand-ink-900">
                {c.title}
              </h3>

              {/* Ba điều người chọn khoá cần biết, đọc dọc là ra: học từ đâu, đạt được gì,
                  học bao lâu. Đoạn tóm tắt và chuỗi chip dài đã bỏ — chúng ở trang chi
                  tiết. */}
              <dl class="mt-4 space-y-2.5 border-t border-brand-ink-200/70 pt-4 text-sm">
                <div class="flex gap-3">
                  <dt class="w-[4.75rem] shrink-0 pt-0.5 text-[11px] font-semibold tracking-[0.06em] text-brand-ink-400 uppercase">Bắt đầu</dt>
                  <dd class="font-semibold leading-snug text-brand-ink-800">{c.entry}</dd>
                </div>
                <div class="flex gap-3">
                  <dt class="w-[4.75rem] shrink-0 pt-0.5 text-[11px] font-semibold tracking-[0.06em] text-brand-ink-400 uppercase">Đạt được</dt>
                  <dd class="font-semibold leading-snug text-brand-ink-800">{c.goal}</dd>
                </div>
                {durationOf(c) && (
                  <div class="flex gap-3">
                    <dt class="w-[4.75rem] shrink-0 pt-0.5 text-[11px] font-semibold tracking-[0.06em] text-brand-ink-400 uppercase">Thời gian</dt>
                    <dd class="font-semibold leading-snug text-brand-ink-800">{durationOf(c)}</dd>
                  </div>
                )}
              </dl>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {c.tags.slice(0, 2).map((t) => (
                  <span class="rounded-full bg-background px-2.5 py-1 text-[11px] font-medium text-brand-ink-600">
                    {t}
                  </span>
                ))}
              </div>

              <span class="mt-auto flex items-center gap-2 pt-5 text-sm font-bold text-brand-red-700">
                Xem chi tiết<span class="sr-only"> khoá {c.title}</span>
                <span
                  class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                  set:html={ICONS.arrow}
                />
              </span>
            </div>
          </a>
        ))
      }
      </div>

      <RailHint label="khoá học" hideFrom="lg" />
    </div>

    {
      hasMore && (
        <div class="mt-8 text-center">
          <a
            href="/courses"
            class="group inline-flex items-center gap-2 rounded-full border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
          >
            Xem thêm {all.length - list.length} chương trình khác
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .course-rail {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .course-rail::-webkit-scrollbar {
    display: none;
  }
</style>
