---
import { Image } from "astro:assets";
import bannerPhoto from "@/assets/daily/giang-vien-di-quanh-lop.webp";
import { ICONS } from "@/lib/icons";

/**
 * Hero trang Giới thiệu — nền kem `brand-cream` (cùng màu khối đội ngũ), tiêu đề serif, nội dung gói trong `container` như header. Khác ở việc nó KHÔNG bán gì:
 * không poster ưu đãi, không nút đăng ký. Người vào trang này muốn biết trung tâm là ai,
 * nên nửa phải là ảnh lớp học thật (giảng viên đi quanh lớp hướng dẫn từng bạn) và nút duy
 * nhất dẫn xuống phần đội ngũ — phần nặng ký nhất của trang.
 *
 * Ba dữ kiện ở chân khối chữ là ba điều kiểm chứng được (năm bắt đầu, lộ trình, giấy
 * phép), không phải ba lời quảng cáo — đó là việc của trang chủ.
 */

interface Props {
  /** Dòng thứ hai (sau `\n`) in nghiêng. */
  title: string;
  lead: string;
  facts?: { value: string; label: string }[];
  /** Dòng nhỏ trên tiêu đề. */
  eyebrow?: string;
  /** Nút duy nhất của hero — mặc định dẫn xuống phần đội ngũ của trang Giới thiệu. */
  cta?: { label: string; href: string };
  /** Ảnh nửa phải. Mặc định là ảnh lớp học thật. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** `photo` 4:3 phủ kín khung; `square` cho poster/ảnh vuông, hiện trọn không cắt. */
  imageShape?: "photo" | "square";
  /**
   * Kiểu chuyển động lúc vào trang (GSAP). Mỗi trang mục Giới thiệu một kiểu để đi qua
   * các trang không thấy lặp lại; bỏ trống thì giữ hiệu ứng trồi nhẹ bằng CSS như cũ.
   * - `reveal`: tiêu đề hiện từng chữ, ảnh mở từ dưới lên kèm zoom lùi.
   * - `wipe`: chữ trượt vào từ trái, ảnh quét ngang mở ra, rê chuột thì ảnh nghiêng theo.
   * - `circle`: chữ hiện từ nhoè sang nét, ảnh mở hình tròn từ tâm rồi phóng chậm.
   */
  motion?: "reveal" | "wipe" | "circle";
}

const {
  title,
  lead,
  eyebrow = "Về Hoa văn SaigonHSK",
  cta = { label: "Khám phá đội ngũ", href: "#doi-ngu" },
  image = bannerPhoto,
  imageAlt = "Giảng viên Hoa văn SaigonHSK đi quanh lớp hướng dẫn học viên làm bài",
  imageShape = "photo",
  motion,
  facts = [
    { value: "Từ 2019", label: "Đào tạo tiếng Trung tại TP.HCM" },
    { value: "HSK 1–6", label: "Lộ trình từ vỡ lòng đến cao cấp" },
    { value: "Có giấy phép", label: "Sở Giáo dục và Đào tạo TP.HCM" },
  ],
} = Astro.props;

const [line1, ...rest] = title.split("\n");
const line2 = rest.join(" ");

/** Mỗi chữ một khung `overflow-hidden` để GSAP cho chữ trồi lên từ mép dưới khung. */
const words = (line: string) => line.split(" ").filter(Boolean);
---

<section
  class="about-hero relative isolate overflow-hidden bg-brand-cream"
  data-motion={motion}
>
  {
    motion && (
      <script
        is:inline
        set:html={`(function (s) {
          if (!s || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          s.dataset.intro = "pending";
          setTimeout(function () { if (s.dataset.intro === "pending") delete s.dataset.intro; }, 3000);
        })(document.currentScript && document.currentScript.parentElement);`}
      />
    )
  }
  <div
    class="container mx-auto grid items-center gap-10 px-6 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14 lg:py-20 xl:gap-20"
  >
    <div class="mx-auto w-full max-w-[40rem] text-center lg:mx-0 lg:text-left">
      <p
        class="about-rise about-step inline-flex items-center gap-3 text-xs font-semibold tracking-[0.22em] text-brand-red-700 uppercase"
      >
        <span class="h-px w-8 bg-brand-red-300" aria-hidden="true"></span>
        {eyebrow}
      </p>

      <h1
        class="about-rise mt-6 font-serif text-[2.2rem] leading-[1.1] font-medium tracking-[-0.015em] text-balance text-brand-ink-900 sm:text-[2.9rem] lg:text-[2.6rem] xl:text-[3.1rem]"
        style="--about-delay: 80ms"
      >
        {words(line1).map((w) => (
          <span class="inline-block">
            <span class="about-word inline-block">{w}</span>
          </span>
        ))}
        {
          line2 && (
            <span class="block text-brand-red-600 italic">
              {words(line2).map((w) => (
                <span class="inline-block">
                  <span class="about-word inline-block">{w}</span>
                </span>
              ))}
            </span>
          )
        }
      </h1>

      {/* `data-speakable`: câu tóm tắt của trang, khớp selector trong src/lib/schema.ts. */}
      <p
        data-speakable
        class="about-rise about-step mx-auto mt-6 max-w-[32rem] text-base leading-[1.65] lg:mx-0 lg:text-[1.0625rem] text-brand-ink-500"
        style="--about-delay: 150ms"
      >
        {lead}
      </p>

      <div
        class="about-rise about-step mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start"
        style="--about-delay: 230ms"
      >
        <a
          href={cta.href}
          class="group inline-flex h-12 items-center justify-center gap-2 rounded-md bg-brand-red-600 px-8 text-[0.95rem] font-extrabold text-white shadow-lg shadow-brand-red-600/20 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700 sm:h-[3.25rem]"
        >
          {cta.label}
          <span
            class="transition-transform group-hover:translate-y-0.5 [&>svg]:size-[1.1rem] [&>svg]:rotate-90"
            set:html={ICONS.arrow}
          />
        </a>
      </div>

      <dl
        class="about-rise about-step mt-10 grid grid-cols-3 divide-x divide-brand-ink-100 border-t border-brand-ink-100 pt-6 lg:mt-12"
        style="--about-delay: 310ms"
      >
        {
          facts.map((f) => (
            <div class="about-fact px-2 first:pl-0 last:pr-0 sm:px-4 xl:px-5">
              <dt class="text-[0.85rem] leading-tight font-bold text-brand-ink-900 sm:text-base">
                {f.value}
              </dt>
              <dd class="mt-1.5 text-xs leading-snug text-muted-foreground sm:text-[0.8125rem]">
                {f.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* Ảnh thật của trung tâm. Ảnh vuông (poster) thu hẹp khung lại cho khỏi cao hơn
        khối chữ bên trái, và canh giữa cột. */}
    <div
      class:list={[
        "about-media mx-auto w-full overflow-hidden rounded-[20px] [perspective:1000px]",
        imageShape === "square"
          ? "max-w-[28rem] lg:max-w-[30rem]"
          : "max-w-[36rem] lg:mx-0 lg:max-w-none",
      ]}
    >
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 50vw, min(36rem, 100vw)"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class:list={[
          "about-img w-full object-cover",
          imageShape === "square" ? "aspect-square" : "aspect-[4/3]",
        ]}
      />
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.querySelectorAll<HTMLElement>(".about-hero[data-motion]").forEach((hero) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const motion = hero.dataset.motion;
    const q = gsap.utils.selector(hero);
    const words = q(".about-word");
    const steps = q(".about-step");
    const media = hero.querySelector<HTMLElement>(".about-media");
    const img = hero.querySelector<HTMLElement>(".about-img");
    const facts = q(".about-fact");

    // Xoá transform mà CSS chờ-intro đặt sẵn, kẻo GSAP giữ lại làm độ lệch.
    gsap.set(words, { clearProps: "transform" });
    delete hero.dataset.intro;

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    if (motion === "reveal") {
      tl.from(words, { y: 28, autoAlpha: 0, duration: 0.9, stagger: 0.05 })
        .from(steps, { y: 18, autoAlpha: 0, duration: 0.7, stagger: 0.1 }, "-=0.6")
        .fromTo(
          media,
          { clipPath: "inset(100% 0% 0% 0% round 20px)" },
          { clipPath: "inset(0% 0% 0% 0% round 20px)", duration: 1.3, ease: "expo.inOut" },
          0.1,
        )
        .from(img, { scale: 1.3, duration: 1.8, ease: "expo.out" }, 0.3);
    }

    if (motion === "wipe") {
      tl.from(words, { xPercent: -30, autoAlpha: 0, duration: 0.8, stagger: 0.04 })
        .from(steps, { x: -24, autoAlpha: 0, duration: 0.7, stagger: 0.08 }, "-=0.55")
        .from(facts, { y: 24, autoAlpha: 0, duration: 0.6, stagger: 0.1 }, "-=0.4")
        .fromTo(
          media,
          { clipPath: "inset(0% 0% 0% 100% round 20px)" },
          { clipPath: "inset(0% 0% 0% 0% round 20px)", duration: 1.1, ease: "expo.inOut" },
          0.15,
        )
        .from(img, { xPercent: 12, scale: 1.15, duration: 1.4, ease: "expo.out" }, 0.3);

      // Rê chuột trên ảnh: nghiêng 3D nhẹ theo vị trí con trỏ, rời chuột thì về thẳng.
      if (media && img && matchMedia("(hover: hover)").matches) {
        const rx = gsap.quickTo(img, "rotationX", { duration: 0.6, ease: "power3.out" });
        const ry = gsap.quickTo(img, "rotationY", { duration: 0.6, ease: "power3.out" });
        media.addEventListener("pointermove", (e) => {
          const r = media.getBoundingClientRect();
          ry(((e.clientX - r.left) / r.width - 0.5) * 10);
          rx(-((e.clientY - r.top) / r.height - 0.5) * 10);
        });
        media.addEventListener("pointerleave", () => {
          rx(0);
          ry(0);
        });
      }
    }

    if (motion === "circle") {
      tl.from(words, { y: 24, autoAlpha: 0, filter: "blur(12px)", duration: 1, stagger: 0.06, ease: "power3.out" })
        .from(steps, { autoAlpha: 0, filter: "blur(8px)", duration: 0.8, stagger: 0.1 }, "-=0.7")
        .fromTo(
          media,
          { clipPath: "circle(0% at 50% 50%)" },
          { clipPath: "circle(75% at 50% 50%)", duration: 1.4, ease: "expo.inOut" },
          0.1,
        )
        // Xong thì phóng rất chậm qua lại — ảnh "thở", không đứng im như poster.
        .add(() => {
          gsap.to(img, { scale: 1.06, duration: 8, ease: "sine.inOut", repeat: -1, yoyo: true });
        });
    }
  });
</script>

<style>
  .about-media {
    box-shadow:
      0 0 0 1px rgb(178 24 43 / 0.08),
      0 24px 48px -28px rgb(94 11 22 / 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Có `motion` thì GSAP lo hết, tắt hiệu ứng CSS để hai thứ không chồng nhau. */
    .about-hero:not([data-motion]) .about-rise {
      animation: about-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--about-delay, 0ms);
    }
  }

  /* Chữ không bọc khung cắt `overflow-hidden`: khung đó cắt mất dấu tiếng Việt phía
     trên (Đồ, ế…). Giấu bằng opacity, GSAP cho chữ trượt lên + hiện dần. */
  .about-hero[data-intro="pending"] .about-word,
  .about-hero[data-intro="pending"] .about-step,
  .about-hero[data-intro="pending"] .about-media {
    opacity: 0;
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
