---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { ICONS } from "@/lib/icons";
import { site } from "@/data/site";
import { clampDescription, itemListSchema } from "@/lib/seo";
import { collectionPageSchema } from "@/lib/schema";

export type HubCard = {
  title: string;
  summary: string;
  href: string;
  tag?: string;
  entry?: string;

  image?: string;
};
export type HubGroup = { title: string; desc?: string; cards: HubCard[] };

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  crumbs: { label: string; href?: string }[];
  glyph?: string;
  groups: HubGroup[];

  columns?: 3 | 4;

  keywords?: string;

  emptyMessage?: string;
}

const {
  title,
  description,
  metaTitle,
  crumbs,
  glyph = "课",
  groups,
  columns = 3,
  keywords,
  emptyMessage,
} = Astro.props;

const filledGroups = groups.filter((group) => group.cards.length > 0);

const origin = Astro.site?.origin ?? "";
const schemas = [
  collectionPageSchema({ pathname: Astro.url.pathname, site: Astro.site }),
  itemListSchema(
    metaTitle ?? title,
    groups.flatMap((g) => g.cards.map((c) => ({ title: c.title, href: c.href }))),
    origin,
  ),
];

const gridClass =
  columns === 4
    ? "grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
    : "grid gap-5 sm:grid-cols-2 lg:grid-cols-3";
---

<Layout
  title={`${metaTitle ?? title} | ${site.shortName}`}
  description={clampDescription(description)}
  keywords={keywords}
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero title={title} description={description} crumbs={crumbs} glyph={glyph} />

    <section class="bg-background">
      <div class="container mx-auto space-y-16 px-6">
        {filledGroups.length === 0 && emptyMessage && (
          <p class="rounded-3xl bg-brand-ink-50 px-6 py-8 text-center text-sm leading-relaxed text-muted-foreground">
            {emptyMessage}
          </p>
        )}
        {
          filledGroups.map((group) => (
            <div>
              <h2 class="text-2xl font-black text-brand-ink-900 md:text-3xl">
                {group.title}
              </h2>
              {group.desc && (
                <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground md:text-base">
                  {group.desc}
                </p>
              )}

              <div class:list={["mt-8", gridClass]}>
                {group.cards.map((card) => (
                  <a
                    href={card.href}
                    class="group flex flex-col overflow-hidden rounded-3xl bg-brand-ink-50 transition-transform duration-300 hover:-translate-y-1.5"
                  >
                    {card.image && (
                      <img
                        src={card.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="aspect-video w-full object-cover"
                      />
                    )}
                    <div class="flex flex-1 flex-col p-6">
                      {card.tag && (
                        <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-red-600">
                          {card.tag}
                        </span>
                      )}
                      <h3 class="mt-1 text-lg font-extrabold leading-snug text-brand-ink-900">
                        {card.title}
                      </h3>
                      <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                        {card.summary}
                      </p>
                      {card.entry && (
                        <p class="mt-4 text-xs leading-relaxed text-muted-foreground">
                          <span class="font-bold text-foreground">Đầu vào:</span>{" "}
                          {card.entry}
                        </p>
                      )}
                      <span class="mt-auto flex items-center gap-2 pt-5 text-sm font-bold text-brand-red-600">
                        Xem chi tiết<span class="sr-only"> {card.title}</span>
                        <span
                          class="transition-transform group-hover:translate-x-1.5 [&>svg]:size-4"
                          set:html={ICONS.arrow}
                        />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <EnrollCta />
    <RegisterSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
