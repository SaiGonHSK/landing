---
import { Image, getImage } from "astro:assets";
import BrandHeading from "@/components/BrandHeading.astro";
import HeroBackdrop from "@/components/HeroBackdrop.astro";
import { activityPosters } from "@/data/activities";

const CARD = 360;

const PER_ROW = 4;

const TILTS = [-3, 2, -1.5, 3, 1];

const posters = await Promise.all(
  activityPosters.map(async (p) => {
    const shortest = Math.min(p.image.width, p.image.height);
    const card = Math.min(CARD, shortest);

    const density = Math.min(2, shortest / card);

    return {
      ...p,
      card,
      densities: density >= 1.05 ? [1, Number(density.toFixed(2))] : [1],
      full: (
        await getImage({
          src: p.image,
          width: Math.min(1400, p.image.width),
          format: "webp",
          quality: 90,
        })
      ).src,
    };
  }),
);

const dropAt = (col: number) => {
  const x = (2 * col + 1) / (2 * PER_ROW);
  return 4 * x * (1 - x);
};

const rows = Array.from(
  { length: Math.ceil(posters.length / PER_ROW) },
  (_, r) => posters.slice(r * PER_ROW, r * PER_ROW + PER_ROW),
);
---

{
  posters.length > 0 && (
    <section
      id="activities"
      class="activities relative isolate scroll-mt-24 overflow-hidden pt-12 pb-28 sm:pb-32 lg:pt-16 lg:pb-40"
    >
      <HeroBackdrop stickers="wide" />

      <div class="container relative mx-auto px-6">
        <BrandHeading
          title="Sự kiện tại "
          highlight="SaigonHSK"
        />

        <div class="relative mt-14 lg:mt-16">
          <div class="flex flex-col gap-3 sm:gap-12 lg:gap-16">
            {rows.map((row, r) => (
              <div class="relative">
                <svg
                  class="pointer-events-none absolute inset-x-0 top-0 h-20 w-full sm:h-30"
                  viewBox="0 0 1000 120"
                  preserveAspectRatio="none"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M0 12Q500 188 1000 12"
                    stroke="var(--brand-ink-300)"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>

                {row.length > 2 && (
                  <svg
                    class="pointer-events-none absolute inset-x-0 top-[calc(50%+0.375rem)] h-20 w-full sm:hidden"
                    viewBox="0 0 1000 120"
                    preserveAspectRatio="none"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M0 12Q500 188 1000 12"
                      stroke="var(--brand-ink-300)"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                )}

                <ul class="grid grid-cols-2 items-start gap-3 sm:grid-cols-4 sm:gap-4 lg:gap-5">
                    {row.map((p, col) => {
                      const i = r * PER_ROW + col;

                      return (
                        <li
                          class="activity-card"
                          style={`--drop: ${dropAt(col)}; --tilt: ${TILTS[i % TILTS.length]}deg`}
                        >
                          <span class="activity-peg" aria-hidden="true">
                            <span class="activity-peg-spring" />
                          </span>

                          <button
                            type="button"
                            data-lightbox={p.full}
                            data-caption={p.caption}
                            class="activity-frame group block w-full cursor-zoom-in"
                          >
                            <span class="relative block overflow-hidden rounded-lg bg-brand-ink-50">
                              <Image
                                src={p.image}
                                alt={p.caption}
                                width={p.card}
                                height={p.card}
                                fit="cover"
                                densities={p.densities}
                                format="webp"
                                quality={90}
                                loading="lazy"
                                decoding="async"
                                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                              />

                              <span
                                aria-hidden="true"
                                class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-linear-to-t from-brand-ink-950/85 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                              />

                              <span class="pointer-events-none absolute inset-x-0 bottom-0 p-4 text-left text-[13px] leading-snug font-extrabold text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 lg:p-5 lg:text-[15px]">
                                {p.caption}
                              </span>
                            </span>
                          </button>
                        </li>
                      );
                    })}
                </ul>
              </div>
            ))}
          </div>

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-2 -bottom-2 hidden size-20 rotate-6 place-items-center rounded-full bg-brand-red-600 text-center text-xs leading-tight font-bold text-white shadow-[0_18px_40px_-20px_rgba(178,24,43,0.8)] lg:grid"
          >
            为你的
            <br />
            成功
          </span>
        </div>
      </div>
    </section>
  )
}

<style>
  .activity-card {
    position: relative;
    margin-top: 3.25rem;
  }

  @media (min-width: 640px) {
    .activity-card {
      margin-top: calc(0.75rem + var(--drop) * 5.5rem);
    }
  }

  .activity-peg {
    position: absolute;
    top: -0.625rem;
    left: 50%;
    z-index: 1;
    width: 0.625rem;
    height: 1.25rem;
    translate: -50% 0;
    border-radius: 0.1875rem;
    background: var(--brand-red-600);
    box-shadow: 0 2px 4px rgba(18, 19, 22, 0.18);
  }

  .activity-peg-spring {
    position: absolute;
    inset: 0.5rem 0.1875rem 0.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.4);
  }

  .activity-frame {
    position: relative;
    padding: 0.3125rem;
    border-radius: 0.75rem;
    background: #ffffff;
    rotate: var(--tilt);
    transform-origin: top center;
    box-shadow:
      0 1px 2px rgba(18, 19, 22, 0.06),
      0 12px 24px -12px rgba(18, 19, 22, 0.28);
  }

  @media (min-width: 640px) {
    .activity-frame {
      padding: 0.4375rem;
      border-radius: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .activity-frame {
      transition:
        rotate 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.35s ease;
    }

    .activity-frame:hover,
    .activity-frame:focus-visible {
      rotate: 0deg;
      box-shadow:
        0 2px 4px rgba(18, 19, 22, 0.08),
        0 22px 40px -18px rgba(18, 19, 22, 0.4);
    }
  }
</style>
