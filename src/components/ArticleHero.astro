---
import type { LibraryArticle } from "@/data/library";
import { breadcrumbGraph } from "@/lib/schema";

interface Props {
  article: LibraryArticle;
}

const { article } = Astro.props;

const breadcrumbSchema = breadcrumbGraph(
  [
    { label: "Thư viện", href: "/library" },
    { label: article.category.label, href: article.category.slug },
    { label: article.title },
  ],
  Astro.url.pathname,
  Astro.site,
);
---
<section class="relative overflow-hidden bg-background pt-10 lg:pt-14">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -right-4 -top-6 select-none text-[11rem] font-black leading-none text-brand-red-900/[0.05] lg:text-[15rem]"
  >
    文
  </span>

  <div class="container relative z-10 mx-auto px-6 text-center">
    <h1
      class="text-[2.25rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-[3.25rem]"
    >
      {article.title}
    </h1>

    {
      article.intro && (
        <p class="mx-auto mt-5 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">
          {article.intro}
        </p>
      )
    }
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</section>
