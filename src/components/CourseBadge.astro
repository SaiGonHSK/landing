---
/**
 * Badge tên khoá học: chia chéo dọc — nửa trái đỏ chữ trắng, nửa phải trắng chữ đỏ.
 */
interface Props {
  /** Tên khoá đầy đủ, ví dụ "Tiếng Trung Giao tiếp Cấp tốc" */
  title: string;
  class?: string;
  /** SVG thô của icon chương trình (`COURSE_ICONS`). Có thì vẽ ở góc trên–phải của nửa
   *  trắng — chi tiết riêng của từng khoá, để các badge không còn giống hệt nhau. */
  icon?: string;
}

const { title, class: className = "", icon } = Astro.props;

/** Tách "Luyện thi HSK" → LUYỆN THI | HSK, "Tiếng Trung Sơ cấp" → TIẾNG TRUNG | SƠ CẤP */
const PREFIXES: { match: string; label: string }[] = [
  { match: "Luyện thi", label: "Luyện thi" },
  { match: "Tiếng Trung", label: "Tiếng Trung" },
];
const split = (name: string) => {
  const prefix = PREFIXES.find((p) =>
    name.toLowerCase().startsWith(p.match.toLowerCase()),
  );
  if (!prefix) return { lead: name, tail: "" };

  const tail = name
    .slice(prefix.match.length)
    .replace(/[()]/g, "")
    .replace(/^\s*cho\s+/i, "")
    .trim();
  return { lead: prefix.label, tail };
};

const { lead, tail } = split(title);

/** Chữ dài thì thu nhỏ để không tràn khỏi nửa badge. */
const sizeOf = (text: string) =>
  text.length > 16
    ? "text-[0.8125rem] md:text-sm"
    : text.length > 10
      ? "text-base md:text-lg"
      : "text-lg md:text-2xl";
---

<div
  class:list={["relative isolate size-full overflow-hidden bg-white", className]}
  role="img"
  aria-label={title}
>
  <span
    aria-hidden="true"
    class="absolute inset-0 bg-brand-red-600 [clip-path:polygon(0_0,50%_0,34%_100%,0_100%)]"
  ></span>

  {
    icon && (
      <span
        aria-hidden="true"
        class="absolute top-3 right-3 flex size-8 items-center justify-center rounded-full bg-brand-red-50 text-brand-red-700 ring-1 ring-brand-red-100 [&>svg]:size-4"
        set:html={icon}
      />
    )
  }

  <div class="relative flex size-full items-center">
    <p
      class:list={[
        "w-[42%] shrink-0 pl-5 pr-2 font-black uppercase leading-tight tracking-tight text-white",
        sizeOf(lead),
      ]}
    >
      {lead}
    </p>

    {
      tail && (
        <p
          class:list={[
            "flex-1 self-end pb-5 pl-2 pr-5 text-right font-black uppercase leading-tight tracking-tight text-brand-red-600",
            sizeOf(tail),
          ]}
        >
          {tail}
        </p>
      )
    }
  </div>
</div>
