---
import type { ImageMetadata } from "astro";
import SplitHero, { type HeroStat } from "@/components/SplitHero.astro";
import { breadcrumbGraph } from "@/lib/schema";

interface Props {
  title: string;
  description?: string | string[];
  crumbs?: { label: string; href?: string }[];
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  cutout?: boolean;
  cta?: { label: string; href: string };
  secondary?: { label: string; href: string };
  stats?: HeroStat[];
  decor?: boolean;
  /** Giữ để các trang cũ không phải sửa — hero mới không dùng các tuỳ chọn này. */
  glyph?: string;
  align?: "left" | "center";
  compactBottom?: boolean;
  motion?: "flip" | "blur" | "burst";
}

const { title, description, crumbs = [], eyebrow, image, imageAlt, cutout, cta, secondary, stats, decor } = Astro.props;

const lead = [description ?? []].flat().filter(Boolean).join(" ");

const breadcrumbSchema = breadcrumbGraph(crumbs, Astro.url.pathname, Astro.site);
const hasSlot = Astro.slots.has("default");
---

<SplitHero
  title={title}
  eyebrow={eyebrow ?? crumbs[0]?.label}
  lead={lead}
  image={image}
  imageAlt={imageAlt}
  cutout={cutout}
  cta={cta}
  secondary={secondary}
  stats={stats}
  decor={decor}
/>

{
  hasSlot && (
    <div class="container mx-auto mt-6 px-6 lg:mt-10">
      <slot />
    </div>
  )
}

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
