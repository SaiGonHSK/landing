---
import { ICONS } from "@/lib/icons";

interface Props {
  label: string;

  hideFrom?: "sm" | "md" | "lg";
}

const { label, hideFrom } = Astro.props;

const hideClass = hideFrom
  ? { sm: "sm:hidden", md: "md:hidden", lg: "lg:hidden" }[hideFrom]
  : "";
---

<div
  data-rail-hint
  data-rail-label={label}
  data-scrollable="false"
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute left-1/2 top-1/2 z-20 flex -translate-x-1/2 -translate-y-1/2 items-center gap-2",
    "rounded-full bg-brand-ink-900/85 px-5 py-3 text-sm font-bold text-white",
    "scale-95 opacity-0 shadow-[0_18px_40px_-18px_rgb(15_23_42/0.65)] backdrop-blur-sm",
    "transition duration-200 ease-out",
    "group-hover/rail:scale-100 group-hover/rail:opacity-100",
    "group-data-[dragging=true]/rail:opacity-0",
    "data-[scrollable=false]:hidden [@media(hover:none)]:hidden",
    hideClass,
  ]}
>
  Kéo qua
  <span class="[&>svg]:size-4" set:html={ICONS.arrow} />
</div>

<script>
  const FINE_POINTER = "(hover: hover) and (pointer: fine)";

  document.querySelectorAll<HTMLElement>("[data-rail]").forEach((rail) => {
    const track = rail.querySelector<HTMLElement>("[data-rail-track]");
    const hint = rail.querySelector<HTMLElement>("[data-rail-hint]");
    if (!track) return;

    const overflows = () => track.scrollWidth - track.clientWidth > 1;

    const syncA11y = (on: boolean) => {
      if (on) {
        track.setAttribute("tabindex", "0");
        track.setAttribute("role", "group");
        const label = hint?.dataset.railLabel;
        if (label) track.setAttribute("aria-label", `Dải ${label} — cuộn ngang`);
      } else {
        track.removeAttribute("tabindex");
        track.removeAttribute("role");
        track.removeAttribute("aria-label");
      }
    };

    const sync = () => {
      const on = overflows();
      if (hint) hint.dataset.scrollable = String(on);
      syncA11y(on);
      track.style.cursor = on && window.matchMedia(FINE_POINTER).matches ? "grab" : "";
    };

    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();

    let startX = 0;
    let startScroll = 0;
    let down = false;
    let dragged = false;

    const stop = () => {
      if (!down) return;
      down = false;
      rail.dataset.dragging = "false";
      track.style.removeProperty("scroll-snap-type");
      track.style.cursor = overflows() ? "grab" : "";
    };

    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      if (!overflows()) return;
      down = true;
      dragged = false;
      startX = event.clientX;
      startScroll = track.scrollLeft;
    });

    track.addEventListener("pointermove", (event) => {
      if (!down) return;
      const dx = event.clientX - startX;
      if (!dragged && Math.abs(dx) <= 4) return;

      if (!dragged) {
        dragged = true;
        rail.dataset.dragging = "true";
        track.style.cursor = "grabbing";
        track.style.scrollSnapType = "none";
      }
      event.preventDefault();
      track.scrollLeft = startScroll - dx;
    });

    track.addEventListener("pointerup", stop);
    track.addEventListener("pointercancel", stop);
    track.addEventListener("pointerleave", stop);

    track.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
        dragged = false;
      },
      true,
    );

    track.addEventListener("dragstart", (event) => {
      if (down) event.preventDefault();
    });

    track.addEventListener("selectstart", (event) => {
      if (dragged) event.preventDefault();
    });
  });
</script>
