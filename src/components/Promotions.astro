---
import SectionHeading from "@/components/SectionHeading.astro";
import { promotions } from "@/data/promotions";

const lastSpansRow = promotions.length % 2 === 1;
---
<section id="promotions" class="relative scroll-mt-24">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between md:gap-10">
      <p
        class="mb-5 w-fit -rotate-2 rounded-2xl border border-dashed border-brand-red-200 bg-brand-red-50 px-4 py-2 font-hand text-xl leading-tight text-brand-red-700 md:order-last md:mb-0 md:shrink-0 md:text-2xl"
      >
        Ưu đãi cố định
      </p>

      <SectionHeading
        align="left"
        title="Ưu đãi học phí"
        highlight="áp dụng quanh năm"
        description="Ba chương trình áp dụng cố định tại SaigonHSK, không giới hạn thời gian."
      />
    </div>

    <ul
      class="mt-10 grid items-stretch gap-6 md:grid-cols-2 lg:mt-12 lg:grid-cols-3"
    >
      {
        promotions.map((p, i) => (
          <li
            class:list={[
              "promo-ticket",
              `is-${p.accent}`,
              lastSpansRow &&
                i === promotions.length - 1 &&
                "md:col-span-2 lg:col-span-1",
            ]}
          >
            <div class="promo-ticket-shadow h-full">
              <div class="promo-ticket-body flex h-full flex-col">
                <div class="relative flex-1 overflow-hidden px-5 pt-5 pb-6 sm:px-6 sm:pt-6">
                  <svg
                    class="promo-ticket-gift pointer-events-none absolute -top-2 -right-5 w-28 sm:w-32"
                    viewBox="0 0 96 96"
                    fill="none"
                    aria-hidden="true"
                  >
                    <g class="promo-ticket-confetti">
                      <path
                        d="M30 26 24 16"
                        stroke-width="3"
                        stroke-linecap="round"
                      />
                      <path
                        d="M48 18 48 6"
                        stroke-width="3"
                        stroke-linecap="round"
                      />
                      <path
                        d="M66 26 73 16"
                        stroke-width="3"
                        stroke-linecap="round"
                      />
                      <circle cx="16" cy="34" r="3" stroke-width="0" />
                      <circle cx="82" cy="38" r="2.5" stroke-width="0" />
                    </g>

                    <path
                      class="promo-ticket-star"
                      d="M48 22 52.4 32.2 63.4 33.2 55.1 40.5 57.5 51.3 48 45.6 38.5 51.3 40.9 40.5 32.6 33.2 43.6 32.2Z"
                    />

                    <rect
                      class="promo-ticket-lid"
                      x="18"
                      y="50"
                      width="60"
                      height="14"
                      rx="4"
                    />
                    <rect
                      class="promo-ticket-box"
                      x="24"
                      y="64"
                      width="48"
                      height="30"
                      rx="4"
                    />
                    <rect
                      class="promo-ticket-ribbon"
                      x="42"
                      y="50"
                      width="12"
                      height="44"
                    />
                  </svg>

                  <div class="relative">
                    <h3 class="text-[0.95rem] leading-snug font-black text-brand-ink-900">
                      {p.title}
                    </h3>

                    <p class="mt-4 flex max-w-60 flex-wrap items-baseline gap-x-1.5">
                      {p.valuePrefix && (
                        <span class="promo-ticket-value text-base font-black">
                          {p.valuePrefix}
                        </span>
                      )}
                      <span
                        class:list={[
                          "promo-ticket-value leading-none font-black tracking-[-0.02em] whitespace-nowrap",
                          p.value.length <= 4
                            ? "text-[2.4rem]"
                            : "text-[1.9rem]",
                        ]}
                      >
                        {p.value}
                      </span>
                      <span class="text-[0.8rem] leading-snug font-semibold text-brand-ink-500">
                        {p.unit}
                      </span>
                    </p>

                    <p class="mt-2.5 max-w-60 text-[0.82rem] leading-relaxed text-muted-foreground">
                      {p.desc}
                    </p>
                  </div>
                </div>

                <ul class="promo-ticket-terms grid grid-cols-3 gap-2 px-5 pt-4 pb-5 sm:px-6">
                  {p.terms.map((t) => (
                    <li class="min-w-0">
                      <p class="text-[0.62rem] leading-tight font-semibold tracking-[0.06em] text-brand-ink-400 uppercase">
                        {t.label}
                      </p>
                      <p class="promo-ticket-term-value mt-1 text-[0.78rem] leading-snug font-bold">
                        {t.value}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .promo-ticket {
    --notch: 13px;
    --terms: 4.9rem;
  }

  .promo-ticket-body {
    background: var(--tint);
    border-radius: 1.15rem;
    -webkit-mask-image:
      radial-gradient(
        circle var(--notch) at 0 calc(100% - var(--terms)),
        transparent 99%,
        #000 100%
      ),
      radial-gradient(
        circle var(--notch) at 100% calc(100% - var(--terms)),
        transparent 99%,
        #000 100%
      );
    mask-image:
      radial-gradient(
        circle var(--notch) at 0 calc(100% - var(--terms)),
        transparent 99%,
        #000 100%
      ),
      radial-gradient(
        circle var(--notch) at 100% calc(100% - var(--terms)),
        transparent 99%,
        #000 100%
      );
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .promo-ticket-shadow {
    filter: drop-shadow(0 14px 26px rgba(18, 19, 22, 0.09));
  }

  .promo-ticket-terms {
    position: relative;
  }

  .promo-ticket-terms::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--notch);
    right: var(--notch);
    border-top: 1.5px dashed var(--perf);
  }

  .promo-ticket-body {
    background-image: repeating-conic-gradient(
      from 0deg at 110% 130%,
      var(--ray) 0deg 4deg,
      transparent 4deg 9deg
    );
    background-color: var(--tint);
  }

  .promo-ticket-value,
  .promo-ticket-term-value {
    color: var(--ink);
  }

  .promo-ticket-lid {
    fill: var(--gift-deep);
  }

  .promo-ticket-box {
    fill: var(--gift-mid);
  }

  .promo-ticket-ribbon {
    fill: var(--gift-light);
  }

  .promo-ticket-star {
    fill: var(--ink);
  }

  .promo-ticket-confetti {
    stroke: var(--gift-deep);
    fill: var(--gift-deep);
  }

  .promo-ticket {
    --tint: #fbf4f1;
    --ray: #f8eeea;
    --ink: var(--brand-red-800);
    --perf: #e9c9c6;
    --gift-deep: var(--brand-red-800);
    --gift-mid: var(--brand-red-500);
    --gift-light: var(--brand-red-200);
  }
</style>
