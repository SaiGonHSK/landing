---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import teacherCutout from "@/assets/hero/giang-vien-tach-nen.webp";
import Teacher from "@/components/Teacher.astro";
import TeacherStories from "@/components/TeacherStories.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { teachers } from "@/data/teachers";
import { aboutPageSchema, teacherListSchema } from "@/lib/schema";

const origin = Astro.site?.origin ?? "";

const schemas = [
  aboutPageSchema({ pathname: Astro.url.pathname, site: Astro.site }),
  teacherListSchema(teachers, origin),
];
---

<Layout
  title="Đội ngũ giảng viên tiếng Trung Thạc sĩ, Tiến sĩ | SaigonHSK"
  description="Giảng viên SaigonHSK tốt nghiệp Thạc sĩ, Tiến sĩ tại ĐH Sư phạm Hoa Đông, Ngôn ngữ Bắc Kinh, Tây Nam Trùng Khánh và đang dạy tại các ĐH lớn ở TP.HCM."
  keywords="giảng viên tiếng Trung TPHCM, giang vien tieng trung tphcm, giảng viên Thạc sĩ Tiến sĩ tiếng Trung"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title={"Đội ngũ giảng viên\nThạc sĩ, Tiến sĩ"}
      image={teacherCutout}
      imageAlt="Cô Dương Mai Phương và thầy Lý Hiển Tín, giảng viên Hoa văn SaigonHSK"
      cta={{ label: "Học thử miễn phí", href: "/trial" }}
      secondary={{ label: "Xem lịch khai giảng", href: "/schedule" }}
      stats={[]}
      decor
      description="Đội ngũ giảng viên chính là niềm tự hào của Hoa văn SaigonHSK. Phần lớn giảng viên có trình độ Thạc sĩ, Tiến sĩ, từng học tập hoặc nghiên cứu tại các trường đại học uy tín ở Trung Quốc và hiện đang giảng dạy tại nhiều trường đại học tại Tp HCM. Với chuyên môn vững vàng, phương pháp giảng dạy hiện đại và sự tận tâm, các thầy cô không chỉ truyền đạt kiến thức mà còn truyền cảm hứng, giúp học viên tự tin chinh phục tiếng Trung và đạt được mục tiêu học tập của mình."
      crumbs={[{ label: "Giới thiệu", href: "/about" }, { label: "Đội ngũ giảng viên" }]}
    />
    <Teacher heading={false} />
    <TeacherStories />
    <RegisterSection />
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
