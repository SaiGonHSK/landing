---
import { Image } from "astro:assets";
import SectionHeading from "@/components/SectionHeading.astro";
import TextbookSet from "@/components/TextbookSet.astro";
import HonorStack from "@/components/HonorStack.astro";
import { valuePanels as slides } from "@/data/valuePanels";
---

<section id="why-us" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    <SectionHeading
      title="Vì sao học viên chọn"
      highlight="Hoa văn SaigonHSK?"
      description="Trung tâm đào tạo tiếng Trung chất lượng cao, uy tín tại TP.HCM — mang tinh hoa ngôn ngữ đến cộng đồng bằng những giá trị khác biệt."
    />

    <div
      data-value-tabs
      class="mt-10 flex flex-col overflow-hidden rounded-[2rem] border border-border bg-background"
    >
      {
        /*
          Sàn `min-h` chỉ đặt từ `lg` — nơi dải tab nằm DƯỚI panel, nên panel cao thấp
          khác nhau là bốn tab xê dịch mỗi lần đổi tab.

          Dưới `lg` tab nằm TRÊN panel: đổi tab thì phần trên đứng yên, chỉ nội dung
          bên dưới dài ngắn khác nhau — đúng như mọi khối tab trên mobile. Ép sàn theo
          panel cao nhất ("Ứng dụng luyện đề", ~708px ở khổ 430) thì ba panel còn lại
          phải độn thêm 100–200px trống giữa ảnh và chữ, đổi một mảng trống thấy rõ
          lấy một thứ không ai thấy.
        */
        slides.map((s, i) => (
          <div
            data-panel={i}
            role="tabpanel"
            id={`why-panel-${i}`}
            aria-labelledby={`why-tab-${i}`}
            hidden={i !== 0}
            class="why-panel grid lg:min-h-[36rem] lg:grid-cols-[1fr_1.1fr]"
          >
            <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
              <span class="inline-flex w-fit items-center rounded-full bg-brand-red-900 px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-widest text-white">
                {s.badge}
              </span>

              <h3 class="mt-6 max-w-md text-[1.75rem] font-black leading-tight text-brand-ink-900 sm:text-[2.25rem]">
                {s.title}
              </h3>

              <p class="mt-4 max-w-md text-[0.95rem] leading-[1.65] text-brand-ink-600 sm:text-base">
                {s.desc}
              </p>

              <div class="mt-8 max-w-md border-t border-border pt-6">
                <p class="text-xl font-black leading-none text-brand-red-700">
                  {s.strong}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-brand-ink-600">
                  {s.note}
                </p>
              </div>
            </div>

            {/*
              Mọi minh hoạ đều nằm tuyệt đối trong cột này, kể cả loại `contain`.

              Bốn panel có bốn tỉ lệ ảnh khác hẳn nhau — poster vuông, ảnh ghép ngang,
              hai khung điện thoại dọc, ảnh chụp lớp. Để ảnh nằm trong luồng thì mỗi
              panel cao một kiểu, mà tại một thời điểm chỉ một panel ở trong luồng, nên
              bấm đổi tab là cả khung giật lên giật xuống. Tách ảnh khỏi luồng rồi chốt
              `min-h` ở panel thì bốn tab cao bằng nhau, đổi tab không xê dịch gì.
            */}
            <div
              class:list={[
                "relative order-first min-h-64 sm:min-h-96 lg:order-0 lg:min-h-0",
                (s.contain || s.devices) && "bg-brand-ink-50",
              ]}
            >
              {
                s.illustration ? (
                  /*
                    Minh hoạ vector — bó theo cùng một cách với ảnh `contain`: dưới `lg`
                    chạy theo bề ngang cho ô cao theo hình, từ `lg` nằm tuyệt đối và vừa
                    khít chiều cao ô.

                    Khác ảnh ở chỗ không cần `max-w-96`: SVG không có độ phân giải gốc để
                    mà bị kéo mờ, nên ở khổ hẹp cứ cho nó rộng hết ô — xấp sáu cuốn càng
                    rộng thì chữ trên bìa càng đọc được.
                  */
                  <div class="p-4 sm:p-6 lg:absolute lg:inset-0 lg:p-5">
                    {s.illustration === "honor-stack" ? (
                      <HonorStack class="h-auto w-full lg:size-full" />
                    ) : (
                      <TextbookSet class="h-auto w-full lg:size-full" />
                    )}
                  </div>
                ) : s.devices ? (
                  /*
                    Hai khung điện thoại cạnh nhau, không đè nhau, không nghiêng.

                    ── Vì sao chỉ hai, và vì sao đo theo BỀ NGANG ─────────────────────
                    Ô ảnh này rộng 419px ở viewport 1024 và 550px từ 1280, cao 512px (đo
                    bằng `getBoundingClientRect`, không suy ra). Ảnh chụp app tỉ lệ
                    1 : 2,17, nên một máy vừa đúng chiều cao ô thì rộng tối đa 236px —
                    trần đó là do chiều cao ô, không nới được bằng cách xếp lại.

                    Từ đó ra số khung: `w-[46%]` cho hai khung là 193px (1024) đến 253px
                    (1440) mỗi cái — đọc được tiêu đề màn, con số lớn, thanh tiến độ và
                    chữ Hán mẫu. Ba khung thì còn ~150px, bốn khung còn 88–116px, ở khổ
                    đó chữ thân trong app chỉ còn 3px, tức một vệt xám. Đã thử cả hai.

                    Bản trước buộc `h-[88%]` rồi để bề ngang tự suy ra. Cách đó chặn được
                    lỗi khung cao quá ô (ở khổ hẹp khung từng tràn lên đè cả dải tab),
                    nhưng không chặn được tràn NGANG — mà ba khung × 186px = 558px thì
                    vượt 419px của ô ở khổ 1024, hai khung ngoài bị `overflow-hidden` cắt
                    mất một nửa. Đo theo bề ngang (`w-[46%]` + `gap-[3%]` = 95%) thì không
                    bao giờ tràn, ở mọi khổ màn; `max-h-full` lo phần chiều cao, cắt bớt
                    đáy máy — chỗ đó là thanh tab dưới của app, mất không sao.

                    Không nghiêng: nghiêng làm hộp bao rộng thêm ~14px mỗi khung, đúng chỗ
                    đang thiếu. Thay bằng lệch dọc vài phần trăm — không tốn pixel ngang.

                    ── Còn muốn đọc được chữ thân trong app ──────────────────────────
                    Thì phải cắt ảnh lấy từng thẻ (thẻ chuỗi ngày học, danh sách bài, ô
                    viết chữ) rồi phóng lên gần cỡ thật, chứ không thu nhỏ cả màn hình.
                    Không phải chuyện nén ảnh: bản gửi tới trình duyệt là 520×1131, và
                    1040×2262 cho dpr2 — thừa điểm ảnh cho khung 253px.
                  */
                  <div class="absolute inset-0 flex items-center justify-center gap-[3%] overflow-hidden p-6 lg:p-10">
                    {s.devices.map((device, k) => (
                      <div
                        class:list={[
                          "w-[46%] max-w-60 shrink-0 self-center max-h-full overflow-hidden rounded-[1.5rem] border-[6px] border-brand-ink-900 bg-brand-ink-900 shadow-[0_24px_52px_-28px_rgb(17_24_39/0.6)]",
                          k % 2 === 0 ? "translate-y-[-2%]" : "translate-y-[2%]",
                        ]}
                      >
                        {/*
                          `quality` 95 chứ không 88 như ảnh khác: đây là ảnh chụp giao
                          diện, chữ nhỏ và nét mảnh 1px. Bản gốc trong `src/assets` đã là
                          WebP q95, nén lại lần hai ở q88 thì các nét mảnh đó nhoè ra —
                          cùng lý do đã ghi ở nhánh `contain` bên dưới.

                          Ghi chú đặt NGOÀI thẻ như khối này, không nhét vào giữa các
                          attribute của `<Image>`: chú thích nằm trong thẻ bị Astro đọc
                          thành từng attribute rời (`chứ`, `95`, `88`…) và `astro check`
                          báo lỗi type. Xem đúng lỗi đó đang còn ở `about/differences.astro`.
                        */}
                        <Image
                          src={device.src}
                          alt={device.alt}
                          width={520}
                          densities={[1, 2]}
                          format="webp"
                          quality={95}
                          loading="lazy"
                          decoding="async"
                          class="block h-auto w-full"
                        />
                      </div>
                    ))}
                  </div>
                ) : s.contain ? (
                  /*
                    Hai ảnh đi qua nhánh này (ảnh ghép đội ngũ giảng viên và poster thành tích)
                    đều có CHỮ nướng sẵn trong ảnh — tên, học vị, tên trường, điểm thi.

                    Vì vậy phát một bản duy nhất khoảng 2x thay vì cặp 1x/2x qua `densities`:
                    ô ảnh thật rộng ~550px, cặp 720w/1440w làm máy dpr=1 nhận bản 720w, tức
                    1,3 điểm ảnh cho mỗi px CSS — ảnh thường thì không sao, ảnh có chữ thì nhoè
                    rõ. Triệu chứng đúng như báo lại: phải zoom vào rồi zoom ra mới hết mờ, vì
                    zoom đẩy dpr lên, trình duyệt mới đổi sang bản 1440w rồi giữ bản đó.

                    1200w phủ cả dpr=1 và dpr=2 cho ô 550px (550 × 2 = 1100 ≤ 1200), và ảnh
                    ghép phần lớn là nền phẳng nên 1200w q82 chỉ ~43 KB — nhẹ hơn cả cặp cũ.
                  */
                  /*
                    Chỉ từ `lg` ảnh mới nằm tuyệt đối và bị bó theo chiều cao ô.

                    Dưới `lg` ô ảnh chỉ cao 256–384px, mà ba ảnh đi qua nhánh này đều
                    cao hơn rộng: bó theo chiều cao thì ảnh co lại còn ~200px ngang, nằm
                    lọt thỏm giữa một mảng xám rộng gần gấp đôi. Ở khổ đó cho ảnh chạy
                    theo *bề ngang* (tối đa 24rem, canh giữa) rồi để ô cao theo ảnh —
                    `min-h` là sàn nên ô tự giãn, và dưới `lg` panel vốn được phép cao
                    thấp khác nhau.
                  */
                  <div class="p-4 sm:p-6 lg:absolute lg:inset-0 lg:p-6">
                    <Image
                      src={s.image}
                      alt={`${s.title} — ${s.note}`}
                      width={1200}
                      format="webp"
                      quality={82}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      class="mx-auto h-auto w-full max-w-96 rounded-2xl object-contain lg:size-full lg:max-w-none"
                    />
                  </div>
                ) : (
                  /*
                    Ảnh chụp lớp học phủ kín nửa panel — cắt cạnh thay vì hiện trọn.

                    Có bản 1600px vì `sizes` khai 50vw: màn 1440 rộng thì ô ảnh đã là 720px
                    CSS, màn Retina cần 1440px thật. Dừng ở 1024 như trước thì trình duyệt
                    phải kéo bản 1024 lên gấp rưỡi — đó là chỗ ảnh giáo trình bị nhoè.
                  */
                  <Image
                    src={s.image}
                    alt={s.title}
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    format="webp"
                    quality={88}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="absolute inset-0 size-full object-cover"
                  />
                )
              }

              {
                /* Vệt mờ nối ảnh phủ kín vào cột chữ — chỉ những panel không `contain`,
                   vì ảnh `contain` đã có lề xám bao quanh, phủ thêm vệt mờ lên đó chỉ
                   làm bẩn một góc nền. */
                !s.contain && (
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-background via-background/10 to-transparent lg:block"
                  />
                )
              }
            </div>
          </div>
        ))
      }

      {/*
        Dưới lg dải tab nằm TRÊN panel: để dưới thì bấm tab xong nội dung nhảy khỏi
        khung nhìn.

        Lưới 2×2 chứ không cuộn ngang. Cuộn ngang thì tab thứ ba luôn bị mép thẻ cắt
        ngang chữ ("Ứng dụ…") — trông như lỗi dựng trang chứ không như một gợi ý là
        còn tab bên phải, mà tab bị cắt thì cũng không đọc được để mà muốn cuộn. Hai
        hàng cao ~140px, đổi lại là thấy đủ bốn lựa chọn ngay.
      */}
      <div
        role="tablist"
        aria-label="Giá trị khác biệt của SaigonHSK"
        class="grid grid-cols-2 gap-px border-b border-border bg-border order-first lg:order-0 lg:grid-cols-4 lg:border-b-0 lg:border-t"
      >
        {
          slides.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`why-tab-${i}`}
              data-tab={i}
              data-active={i === 0 ? "true" : "false"}
              aria-controls={`why-panel-${i}`}
              aria-selected={i === 0}
              class="group relative flex cursor-pointer items-center bg-background px-3.5 py-4 text-left transition-colors hover:bg-brand-ink-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-red-600 data-[active=true]:bg-brand-red-50 sm:px-6 sm:py-6"
            >
              {/* Vạch đỏ 3px đánh dấu tab đang mở — ở mép giáp panel (trên từ `lg`, dưới
                  khi tab nằm trên panel) để đọc ra là tab này "nối" với nội dung kia. */}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-0 h-[3px] bg-brand-red-600 opacity-0 transition-opacity group-data-[active=true]:opacity-100 lg:bottom-auto lg:top-0"
              />
              <span class="min-w-0">
                <span class="block text-sm font-bold leading-snug text-brand-ink-700 transition-colors group-hover:text-brand-ink-900 group-data-[active=true]:text-brand-red-700 sm:text-[0.95rem]">
                  {s.tab}
                </span>
                <span class="mt-0.5 block text-xs leading-snug text-brand-ink-500 sm:mt-1 sm:text-[0.8125rem]">
                  {s.tabNote}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-value-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const show = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.dataset.active = String(active);
        tab.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
  });
</script>

<style>
  /* Đổi tab: panel mới hiện ra bằng một nhịp mờ–rõ ngắn, để thấy rõ nội dung vừa đổi theo
     tab vừa bấm. Tắt khi người xem chọn giảm chuyển động. */
  @media (prefers-reduced-motion: no-preference) {
    .why-panel:not([hidden]) {
      animation: why-panel-in 0.35s ease-out both;
    }
  }

  @keyframes why-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
