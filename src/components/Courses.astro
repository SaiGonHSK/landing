---
import SectionHeading from "@/components/SectionHeading.astro";
import CourseBadge from "@/components/CourseBadge.astro";
import { featuredPrograms, visiblePrograms } from "@/data/programsApi";
import { ICONS } from "@/lib/icons";

interface Props {
  showHeading?: boolean;
  limit?: number;
}
const { showHeading = true, limit } = Astro.props;

const all = visiblePrograms();
const featured = featuredPrograms();

const source = featured.length > 0 ? featured : all;
const list = limit ? source.slice(0, limit) : source;
const hasMore = list.length < all.length;

const durationOf = (c: (typeof list)[number]) => {
  const months = (c.levels ?? [])
    .flatMap((l) => l.duration)
    .map(
      (d) =>
        d.match(/\(([\d,]+)\s*tháng\)/)?.[1] ??
        d.match(/mỗi lớp ([\d,]+)\s*tháng/)?.[1] ??
        d.match(/^([\d,]+)\s*tháng/)?.[1],
    )
    .filter((m): m is string => Boolean(m))
    .map((m) => Number(m.replace(",", ".")));
  if (months.length === 0) return null;
  const lo = Math.min(...months);
  const hi = Math.max(...months);
  const fmt = (n: number) => String(n).replace(".", ",");
  return lo === hi ? `${fmt(lo)} tháng/lớp` : `${fmt(lo)}–${fmt(hi)} tháng/lớp`;
};

const attrsOf = (c: (typeof list)[number]) => [
  { label: "Đầu vào", value: c.entry, icon: ICONS.book },
  { label: "Mục tiêu", value: c.goal, icon: ICONS.target },
  { label: "Lộ trình", value: c.tags[0] ?? "—", icon: ICONS.cap },
  { label: "Thời lượng", value: durationOf(c) ?? "Theo lịch lớp", icon: ICONS.clock },
];
---

<section id="courses" class="relative overflow-hidden bg-background scroll-mt-24">
  <div class="container relative z-10 mx-auto px-6">
    {
      showHeading && (
        <SectionHeading
          title={hasMore ? "Chương trình" : "Mười chương trình cho"}
          highlight={hasMore ? "nổi bật nhất" : "mọi mục tiêu tiếng Trung"}
        />
      )
    }

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 xl:grid-cols-4">
      {
        list.map((c) => (
          <li>
            <a
              href={`/courses/programs/${c.slug}`}
              class="group flex h-full flex-col rounded-3xl bg-brand-ink-50 p-3 transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-32px_rgb(17_24_39/0.45)]"
            >
              <div class="relative h-32 overflow-hidden rounded-2xl">
                <CourseBadge
                  title={c.title}
                  class="transition-transform duration-300 group-hover:scale-105"
                />
              </div>

              <div class="flex flex-1 flex-col gap-4 px-2 pt-5 pb-2">

                <h3 class="text-xl leading-snug font-bold text-balance text-brand-ink-900 xl:min-h-[2lh]">
                  {c.title}
                </h3>

                <dl class="divide-y divide-border border-y border-border">
                  {attrsOf(c).map((a) => (
                    <div class="flex items-start gap-3 py-3">
                      <span
                        aria-hidden="true"
                        class="mt-0.5 shrink-0 text-brand-ink-400 [&>svg]:size-[1.125rem]"
                        set:html={a.icon}
                      />
                      <div class="min-w-0">
                        <dt class="text-[10.5px] font-semibold tracking-[0.1em] text-brand-ink-400 uppercase">
                          {a.label}
                        </dt>
                        <dd class="mt-0.5 line-clamp-2 text-[13px] leading-snug font-semibold text-brand-ink-800">
                          {a.value}
                        </dd>
                      </div>
                    </div>
                  ))}
                </dl>

                <span class="mt-auto inline-flex items-center gap-1.5 pt-1 text-sm font-bold text-brand-ink-900 transition-colors group-hover:text-brand-red-700">
                  Xem chương trình<span class="sr-only"> {c.title}</span>
                  <span
                    class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
                    set:html={ICONS.arrow}
                  />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {
      hasMore && (
        <div class="mt-8 text-center">
          <a
            href="/courses"
            class="group inline-flex items-center gap-2 rounded-lg border border-border bg-background px-8 py-4 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
          >
            Xem thêm {all.length - list.length} chương trình khác
            <span
              class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
              set:html={ICONS.arrow}
            />
          </a>
        </div>
      )
    }
  </div>
</section>
