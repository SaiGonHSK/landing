---
import { Image } from "astro:assets";
import bannerPhoto from "@/assets/daily/giang-vien-di-quanh-lop.webp";
import { ICONS } from "@/lib/icons";

/**
 * Hero trang Giới thiệu — cùng ngôn ngữ với hero trang chủ (`HeroV5`): nền đỏ rượu vang,
 * tiêu đề serif, nội dung gói trong `container` như header. Khác ở việc nó KHÔNG bán gì:
 * không poster ưu đãi, không nút đăng ký. Người vào trang này muốn biết trung tâm là ai,
 * nên nửa phải là ảnh lớp học thật (giảng viên đi quanh lớp hướng dẫn từng bạn) và nút duy
 * nhất dẫn xuống phần đội ngũ — phần nặng ký nhất của trang.
 *
 * Ba dữ kiện ở chân khối chữ là ba điều kiểm chứng được (năm bắt đầu, lộ trình, giấy
 * phép), không phải ba lời quảng cáo — đó là việc của trang chủ.
 */

interface Props {
  /** Dòng thứ hai (sau `\n`) in nghiêng. */
  title: string;
  lead: string;
  facts?: { value: string; label: string }[];
  /** Dòng nhỏ trên tiêu đề. */
  eyebrow?: string;
  /** Nút duy nhất của hero — mặc định dẫn xuống phần đội ngũ của trang Giới thiệu. */
  cta?: { label: string; href: string };
  /** Ảnh nửa phải. Mặc định là ảnh lớp học thật. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** `photo` 4:3 phủ kín khung; `square` cho poster/ảnh vuông, hiện trọn không cắt. */
  imageShape?: "photo" | "square";
}

const {
  title,
  lead,
  eyebrow = "Về Hoa văn SaigonHSK",
  cta = { label: "Khám phá đội ngũ", href: "#doi-ngu" },
  image = bannerPhoto,
  imageAlt = "Giảng viên Hoa văn SaigonHSK đi quanh lớp hướng dẫn học viên làm bài",
  imageShape = "photo",
  facts = [
    { value: "Từ 2019", label: "Đào tạo tiếng Trung tại TP.HCM" },
    { value: "HSK 1–6", label: "Lộ trình từ vỡ lòng đến cao cấp" },
    { value: "Có giấy phép", label: "Sở Giáo dục và Đào tạo TP.HCM" },
  ],
} = Astro.props;

const [line1, ...rest] = title.split("\n");
const line2 = rest.join(" ");
---

<section class="about-hero bg-[var(--about-wine)] pt-[var(--header-overlap,0px)]">
  <div
    class="container mx-auto grid items-center gap-10 px-6 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14 lg:py-20 xl:gap-20"
  >
    <div class="mx-auto w-full max-w-[40rem] text-center lg:mx-0 lg:text-left">
      <p
        class="about-rise inline-flex items-center gap-3 text-xs font-semibold tracking-[0.22em] text-[var(--about-ivory)]/80 uppercase"
      >
        <span class="h-px w-8 bg-[var(--about-ivory)]/50" aria-hidden="true"></span>
        {eyebrow}
      </p>

      <h1
        class="about-rise mt-6 font-serif text-[2.2rem] leading-[1.1] font-medium tracking-[-0.015em] text-balance text-[var(--about-ivory)] sm:text-[2.9rem] lg:text-[2.6rem] xl:text-[3.1rem]"
        style="--about-delay: 80ms"
      >
        {line1}
        {line2 && <span class="block italic">{line2}</span>}
      </h1>

      {/* `data-speakable`: câu tóm tắt của trang, khớp selector trong src/lib/schema.ts. */}
      <p
        data-speakable
        class="about-rise mx-auto mt-6 max-w-[32rem] text-base leading-[1.65] text-[var(--about-ivory)]/90 lg:mx-0 lg:text-[1.0625rem]"
        style="--about-delay: 150ms"
      >
        {lead}
      </p>

      <div
        class="about-rise mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start"
        style="--about-delay: 230ms"
      >
        <a
          href={cta.href}
          class="group inline-flex h-12 items-center justify-center gap-2 rounded-md bg-[var(--about-ivory)] px-8 text-[0.95rem] font-extrabold text-[var(--about-wine)] shadow-lg shadow-black/25 transition-all hover:-translate-y-0.5 hover:bg-white sm:h-[3.25rem]"
        >
          {cta.label}
          <span
            class="transition-transform group-hover:translate-y-0.5 [&>svg]:size-[1.1rem] [&>svg]:rotate-90"
            set:html={ICONS.arrow}
          />
        </a>
      </div>

      <dl
        class="about-rise mt-10 grid grid-cols-3 divide-x divide-[var(--about-ivory)]/15 border-t border-[var(--about-ivory)]/15 pt-6 lg:mt-12"
        style="--about-delay: 310ms"
      >
        {
          facts.map((f) => (
            <div class="px-2 first:pl-0 last:pr-0 sm:px-4 xl:px-5">
              <dt class="text-[0.85rem] leading-tight font-bold text-[var(--about-ivory)] sm:text-base">
                {f.value}
              </dt>
              <dd class="mt-1.5 text-xs leading-snug text-[var(--about-ivory)]/75 sm:text-[0.8125rem]">
                {f.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* Ảnh thật của trung tâm. Ảnh vuông (poster) thu hẹp khung lại cho khỏi cao hơn
        khối chữ bên trái, và canh giữa cột. */}
    <div
      class:list={[
        "about-media mx-auto w-full overflow-hidden rounded-[20px]",
        imageShape === "square"
          ? "max-w-[28rem] lg:max-w-[30rem]"
          : "max-w-[36rem] lg:mx-0 lg:max-w-none",
      ]}
    >
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 50vw, min(36rem, 100vw)"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class:list={[
          "w-full object-cover",
          imageShape === "square" ? "aspect-square" : "aspect-[4/3]",
        ]}
      />
    </div>
  </div>
</section>

<style>
  .about-hero {
    --about-wine: var(--brand-red-900);
    --about-ivory: #f8f1e7;
  }

  .about-media {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 24px 48px -28px rgba(0, 0, 0, 0.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-rise {
      animation: about-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--about-delay, 0ms);
    }
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
