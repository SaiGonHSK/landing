<script>
  import { gsap } from "gsap";

  const hero = document.querySelector<HTMLElement>(".xc-hero");
  if (hero?.dataset.gated) {
    hero.addEventListener(
      "xc:open",
      () => (hero.dataset.intro === "pending" ? intro(hero) : snow(hero.querySelector<HTMLCanvasElement>("[data-xc-snow]")!)),
      { once: true },
    );
  } else if (hero?.dataset.intro === "pending") intro(hero);

  function intro(hero: HTMLElement) {
    hero.dataset.introJs = "1";
    const $ = <T extends Element = HTMLElement>(sel: string) => gsap.utils.toArray<T>(sel, hero);
    const garland = hero.querySelector<SVGElement>(".xc-garland");
    const hangs = $(".xc-hang");
    const merry = $(".xc-merry .xc-letter");
    const christmas = $(".xc-christmas .xc-letter");
    const decos = $<SVGElement>(".xc-deco");
    const snowman = hero.querySelector<SVGElement>(".xc-snowman");
    const wire = hero.querySelector<SVGPathElement>(".xc-wire");
    const bulbs = $<SVGElement>(".xc-bulb");
    const fades = $(".xc-fade");
    const tree = hero.querySelector<SVGElement>(".xc-tree");
    const gifts = $<SVGElement>(".xc-gift");
    const canvas = hero.querySelector<HTMLCanvasElement>("[data-xc-snow]")!;
    const wireLen = wire?.getTotalLength() ?? 0;

    gsap.set(garland, { y: -140 });
    gsap.set(hangs, { y: -400 });
    gsap.set([...merry, ...christmas], { scale: 0, rotation: () => gsap.utils.random(-30, 30), transformOrigin: "50% 80%" });
    gsap.set(decos, { y: -40, scale: 0.4, autoAlpha: 0, transformOrigin: "50% 100%" });
    gsap.set(snowman, { scale: 0, transformOrigin: "50% 100%" });
    if (wire) gsap.set(wire, { strokeDasharray: wireLen, strokeDashoffset: wireLen });
    gsap.set(bulbs, { scale: 0, transformOrigin: "50% 0%", transformBox: "fill-box" });
    gsap.set(fades, { y: 16, autoAlpha: 0 });
    gsap.set(tree, { scaleY: 0, transformOrigin: "50% 100%" });
    gsap.set(gifts, { y: -320, autoAlpha: 0 });
    delete hero.dataset.intro;

    gsap
      .timeline({ delay: 0.1 })
      .to(garland, { y: 0, duration: 1.2, ease: "elastic.out(1, 0.55)" }, 0)
      .to(hangs, { y: 0, duration: 1.4, ease: "elastic.out(1, 0.5)", stagger: 0.08 }, 0.1)
      .to(tree, { scaleY: 1, duration: 0.9, ease: "back.out(1.4)" }, 0.2)
      .to(gifts, { y: 0, autoAlpha: 1, duration: 0.7, ease: "bounce.out", stagger: 0.12 }, 0.35)
            .to(merry, { scale: 1, rotation: 0, duration: 0.7, ease: "back.out(2.2)", stagger: 0.07 }, 0.45)
      .to(decos, { y: 0, scale: 1, autoAlpha: 1, duration: 0.7, ease: "bounce.out", stagger: 0.08 }, 1.1)
      .to(christmas, { scale: 1, rotation: 0, duration: 0.7, ease: "back.out(2.2)", stagger: 0.05 }, 0.8)
      .to(snowman, { scale: 1, duration: 0.8, ease: "elastic.out(1, 0.5)" }, 1.3)
      .to(wire, { strokeDashoffset: 0, duration: 1, ease: "power2.inOut" }, 1.3)
      .to(bulbs, { scale: 1, duration: 0.35, ease: "back.out(3)", stagger: 0.06 }, 1.5)
      .to(fades, { y: 0, autoAlpha: 1, duration: 0.7, stagger: 0.12, ease: "power3.out" }, 1.8)
      .add(() => snow(canvas), 0);
  }

  function snow(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0;
    let h = 0;
    const resize = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    type Flake = { x: number; y: number; r: number; a: number; vx: number; vy: number };
    const flakes: Flake[] = [];
    const max = Math.round(Math.min(200, w / 7));
    const spawn = (): Flake => ({
      x: Math.random() * w,
      y: -10,
      r: 1 + Math.random() * 3,
      a: 0.3 + Math.random() * 0.6,
      vx: -0.3 + Math.random() * 0.6,
      vy: 0.6 + Math.random() * 0.7,
    });

    let running = true;
    let raf = 0;
    const tick = () => {
      if (flakes.length < max) flakes.push(spawn());
      ctx.clearRect(0, 0, w, h);
      for (const f of flakes) {
        f.vx += (Math.random() - 0.5) * 0.08;
        f.x += f.vx;
        f.y += f.vy;
        if (f.y > h + 10) Object.assign(f, spawn());
        ctx.fillStyle = `rgba(255,255,255,${f.a})`;
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fill();
      }
      if (running) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !running) {
        running = true;
        raf = requestAnimationFrame(tick);
      } else if (!entry.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }).observe(canvas);
  }
</script>
