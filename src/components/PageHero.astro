---
import { Image } from "astro:assets";
import { breadcrumbGraph } from "@/lib/schema";

interface Props {
  title: string;
  /** Một đoạn, hoặc mảng nhiều đoạn khi lời dẫn dài hơn một ý. */
  description?: string | string[];

  /**
   * Chỉ dùng cho schema BreadcrumbList (JSON-LD) — breadcrumb không còn hiển thị
   * trên trang, nhưng vẫn khai báo cho Google hiểu cấu trúc site.
   */
  crumbs?: { label: string; href?: string }[];

  glyph?: string;

  /**
   * Canh giữa tiêu đề + mô tả — mặc định của mọi trang. Bỏ qua khi hero có ảnh
   * (bố cục 2 cột, canh giữa sẽ đá nhau với cột ảnh).
   */
  align?: "left" | "center";

  /** Nhãn nhỏ phía trên tiêu đề, kèm chấm báo hiệu đang mở */
  eyebrow?: string;

  /** Ảnh minh hoạ bên phải. Có ảnh thì hero chuyển sang bố cục 2 cột. */
  image?: ImageMetadata;
  imageAlt?: string;

  /**
   * Thu gọn đệm dưới của hero.
   *
   * Dành cho trang đưa một hàng điều khiển vào slot (Thư viện đưa hàng chip chuyên
   * mục): hàng đó thuộc về nội dung bên dưới chứ không thuộc hero, nên đệm dưới
   * mặc định cộng với khoảng cách giữa các section đẩy nó trôi lơ lửng ở giữa.
   */
  compactBottom?: boolean;

  /**
   * Chuyển động lúc vào trang (GSAP), bật riêng từng trang — bỏ trống thì hero đứng yên
   * như mọi trang khác. Các trang con mục Giới thiệu mỗi trang một kiểu:
   * - `flip`: tiêu đề lật từng ký tự 3D; chữ Hán nền xoay vào.
   * - `blur`: chữ hiện từ nhoè sang nét; chữ Hán nền trôi lơ lửng.
   * - `burst`: chữ bung từ giữa ra hai bên; chữ Hán nền chạy theo chuột.
   */
  motion?: "flip" | "blur" | "burst";
}

const {
  title,
  description,
  crumbs = [],
  glyph = "华",
  align = "center",
  eyebrow,
  image,
  imageAlt = "",
  compactBottom = false,
  motion,
} = Astro.props;

/** Ký tự theo grapheme, để chữ có dấu tiếng Việt không bị tách khỏi dấu. */
const graphemes = (w: string) =>
  Array.from(new Intl.Segmenter("vi", { granularity: "grapheme" }).segment(w), (g) => g.segment);
const titleWords = title.split(" ").filter(Boolean);

const paragraphs = [description ?? []].flat();

/** Ảnh nằm đúng chỗ chữ 华 nền, có ảnh thì bỏ chữ để không chồng lên nhau. */
const showGlyph = !image;

const centered = align === "center" && !image;

const breadcrumbSchema = breadcrumbGraph(crumbs, Astro.url.pathname, Astro.site);
---

<section
  data-page-motion={motion}
  class:list={[
    "page-hero relative isolate overflow-hidden pt-14 lg:pt-20",
    // Trang bật `motion` (mục Giới thiệu) dùng nền kem, cùng tông với `AboutHero`.
    motion ? "bg-brand-cream" : "bg-background",
    compactBottom ? "pb-6 lg:pb-8" : "pb-14 lg:pb-20",
  ]}
>
  {
    showGlyph && (
      <span
        aria-hidden="true"
        class="page-glyph pointer-events-none absolute -right-4 -top-6 select-none text-[11rem] font-black leading-none text-brand-red-900/[0.05] lg:text-[15rem]"
      >
        {glyph}
      </span>
    )
  }

  <div class="container relative z-10 mx-auto px-6">
    <div
      class:list={[
        image && "grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14",
      ]}
    >
      <div class:list={[centered && "flex flex-col items-center text-center"]}>
        {
          eyebrow && (
            <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-brand-red-100 bg-brand-red-50 py-1.5 pl-2.5 pr-4 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-brand-red-700">
              <span class="relative flex size-2">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-red-500 opacity-75" />
                <span class="relative inline-flex size-2 rounded-full bg-brand-red-600" />
              </span>
              {eyebrow}
            </p>
          )
        }

        <h1
          class="max-w-4xl text-[2.25rem] font-black leading-[1.02] tracking-tight text-balance text-brand-ink-900 md:text-6xl"
          aria-label={motion ? title : undefined}
        >
          {
            motion
              ? titleWords.map((w, i) => (
                  <>
                    {i > 0 && " "}
                    {/* Chữ bọc `nowrap` để xuống dòng theo từ, không giữa từ. */}
                    <span class="page-word inline-block whitespace-nowrap [perspective:600px]" aria-hidden="true">
                      {motion === "flip"
                        ? graphemes(w).map((c) => <span class="page-char inline-block">{c}</span>)
                        : w}
                    </span>
                  </>
                ))
              : title
          }
        </h1>

        {
          /* `data-speakable` ở đoạn đầu: đây là câu trả lời gọn nhất của trang, và
             `speakable` trong src/lib/schema.ts trỏ vào đúng selector này. Chỉ đoạn
             đầu — trợ lý giọng nói đọc tối đa vài câu, gắn cả khối thì nó đọc lan. */
          paragraphs.map((p, i) => (
            <p
              class="page-step mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg"
              data-speakable={i === 0 ? "" : undefined}
            >
              {p}
            </p>
          ))
        }

        <slot />
      </div>

      {
        image && (
          <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
            <Image
              src={image}
              alt={imageAlt}
              widths={[384, 560, 1120]}
              sizes="(min-width: 1024px) 560px, 100vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              class="w-full rounded-[2rem] object-cover"
            />

            <slot name="image-overlay" />
          </div>
        )
      }
    </div>
  </div>
  {
    motion && (
      <script
        is:inline
        set:html={`(function (s) {
          if (!s || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          s.dataset.intro = "pending";
          setTimeout(function () { if (s.dataset.intro === "pending") delete s.dataset.intro; }, 3000);
        })(document.currentScript && document.currentScript.closest("section"));`}
      />
    )
  }
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</section>

<script>
  import { gsap } from "gsap";

  document.querySelectorAll<HTMLElement>(".page-hero[data-page-motion]").forEach((hero) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const motion = hero.dataset.pageMotion;
    const q = gsap.utils.selector(hero);
    const words = q(".page-word");
    const steps = q(".page-step");
    const glyph = hero.querySelector<HTMLElement>(".page-glyph");
    delete hero.dataset.intro;

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    if (motion === "flip") {
      tl.from(q(".page-char"), {
        rotationX: -90,
        yPercent: 40,
        autoAlpha: 0,
        transformOrigin: "50% 100%",
        duration: 0.8,
        stagger: 0.018,
        ease: "back.out(1.6)",
      })
        .from(steps, { y: 16, autoAlpha: 0, duration: 0.7, stagger: 0.1 }, "-=0.5")
        .from(glyph, { scale: 0.5, rotation: -25, autoAlpha: 0, duration: 1.6, ease: "expo.out" }, 0);
    }

    if (motion === "blur") {
      tl.from(words, { autoAlpha: 0, filter: "blur(14px)", y: 12, duration: 1, stagger: 0.08, ease: "power3.out" })
        .from(steps, { autoAlpha: 0, filter: "blur(8px)", duration: 0.9, stagger: 0.1 }, "-=0.7")
        .from(glyph, { autoAlpha: 0, y: 60, duration: 1.6, ease: "expo.out" }, 0)
        .add(() => {
          gsap.to(glyph, { y: -14, rotation: 3, duration: 4, ease: "sine.inOut", repeat: -1, yoyo: true });
        });
    }

    if (motion === "burst") {
      tl.from(words, {
        autoAlpha: 0,
        scale: 0.6,
        y: 30,
        duration: 0.8,
        stagger: { each: 0.06, from: "center" },
        ease: "back.out(1.8)",
      })
        .from(steps, { y: 16, autoAlpha: 0, duration: 0.7, stagger: 0.1 }, "-=0.45")
        .from(glyph, { autoAlpha: 0, scale: 1.4, duration: 1.4, ease: "expo.out" }, 0);

      // Chữ Hán nền lệch nhẹ ngược chiều con trỏ — chiều sâu, không cần thêm lớp trang trí.
      if (glyph && matchMedia("(hover: hover)").matches) {
        const gx = gsap.quickTo(glyph, "x", { duration: 1, ease: "power3.out" });
        const gy = gsap.quickTo(glyph, "y", { duration: 1, ease: "power3.out" });
        hero.addEventListener("pointermove", (e) => {
          const r = hero.getBoundingClientRect();
          gx(-((e.clientX - r.left) / r.width - 0.5) * 60);
          gy(-((e.clientY - r.top) / r.height - 0.5) * 40);
        });
      }
    }
  });
</script>

<style>
  .page-hero[data-intro="pending"] .page-word,
  .page-hero[data-intro="pending"] .page-step,
  .page-hero[data-intro="pending"] .page-glyph {
    opacity: 0;
  }
</style>
