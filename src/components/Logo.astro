---
import { Image } from "astro:assets";
import logoMark from "@/assets/logo-mark.webp";
import { site } from "@/data/site";

interface Props {

  markOnly?: boolean;

  onDark?: boolean;
  class?: string;
}
const { markOnly = false, onDark = false, class: className = "" } = Astro.props;
---

<a
  href="/"
  aria-label={`${site.fullName} — Trang chủ`}
  class:list={[
    "flex select-none items-center gap-2.5 leading-none transition-transform duration-200 hover:scale-[1.03]",
    className,
  ]}
>
  <Image
    src={logoMark}
    alt={`Logo ${site.fullName}`}
    width={44}
    densities={[1, 2]}
    format="webp"
    quality={90}
    loading="eager"
    class:list={[
      "size-10 shrink-0 object-contain md:size-11",
      onDark && "rounded-full bg-white p-0.5",
    ]}
  />

  {
    !markOnly && (
      <span class="flex flex-col gap-0.5">
        <span
          class:list={[
            /* `whitespace-nowrap`: tên luôn trên một hàng — ô logo trong header là cột
               `flex-1 basis-0`, ở khổ vừa nó hẹp lại và tên bị bẻ thành hai dòng. */
            "text-sm font-extrabold whitespace-nowrap uppercase tracking-[0.08em] md:text-base",
            onDark ? "text-white" : "text-foreground",
          ]}
        >
          Hoa văn SaigonHSK
        </span>
        <span
          class:list={[
            "text-[11px] font-semibold tracking-[0.12em]",
            onDark
              ? "text-white/75"
              : "text-brand-red-600",
          ]}
        >
          {site.slogan}
        </span>
      </span>
    )
  }
</a>
