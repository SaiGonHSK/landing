---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TextbookSet from "@/components/TextbookSet.astro";
import HonorStack from "@/components/HonorStack.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { reasons } from "@/data/site";
import { valuePanels } from "@/data/valuePanels";
import { ICONS } from "@/lib/icons";
import { aboutPageSchema } from "@/lib/schema";

/* Trang nhánh của mục Giới thiệu: khai `AboutPage` gộp vào node `WebPage` của Layout,
   `mainEntity` trỏ về `#organization` để AI biết trang này nói *về* trung tâm. */
const schemas = [aboutPageSchema({ pathname: Astro.url.pathname, site: Astro.site })];
---

<Layout
  title="Điểm khác biệt của trung tâm tiếng Trung SaigonHSK"
  description="Giáo trình biên soạn riêng cho người Việt, giảng viên Thạc sĩ – Tiến sĩ, ứng dụng luyện đề riêng của trung tâm và cam kết đầu ra HSK — những điểm khác biệt của Hoa văn SaigonHSK."
  keywords="trung tâm tiếng Trung uy tín TPHCM, trung tam tieng trung uy tin tphcm, cam kết đầu ra HSK, tại sao chọn SaigonHSK"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-16 lg:gap-24">
    <PageHero
      title={reasons.closingTitle}
      description={reasons.closingParagraphs}
      crumbs={[{ label: "Giới thiệu", href: "/about" }, { label: "Điểm khác biệt" }]}
      glyph="异"
      motion="flip"
    />

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <div class="flex flex-col gap-6">
          {
            valuePanels.map((v, i) => (
              <article class="grid overflow-hidden rounded-[2rem] border border-border bg-background lg:grid-cols-2">
                <div
                  class:list={[
                    "flex flex-col justify-center p-8 sm:p-10 lg:p-14",
                    i % 2 === 1 && "lg:order-last",
                  ]}
                >
                  <span class="inline-flex w-fit items-center rounded-full bg-brand-ink-900 px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-widest text-white">
                    {v.badge}
                  </span>

                  <h2 class="mt-6 max-w-md text-2xl font-black leading-tight text-brand-ink-900 sm:text-3xl">
                    {v.title}
                  </h2>

                  <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
                    {v.desc}
                  </p>

                  <div class="mt-8 max-w-md border-t border-border pt-6">
                    <p class="text-lg font-black leading-none text-brand-ink-900">
                      {v.strong}
                    </p>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                      {v.note}
                    </p>
                  </div>
                </div>

                <div
                  class:list={[
                    "relative order-first min-h-56 lg:order-0 lg:min-h-96",
                    (v.contain || v.devices) && "bg-brand-ink-50 p-6 lg:p-10",
                  ]}
                >
                  {v.illustration === "honor-stack" ? (
                    <HonorStack class="h-auto w-full lg:size-full" />
                  ) : v.illustration ? (
                    <TextbookSet class="h-auto w-full lg:size-full" />
                  ) : v.devices ? (
                    /* Hai khung cạnh nhau, không đè, không nghiêng — cách tính bề ngang
                       và vì sao chỉ hai ghi ở `WhyUs.astro`. */
                    <div class="flex h-full items-center justify-center gap-[3%]">
                      {v.devices.map((device, k) => (
                        <div
                          class:list={[
                            "w-[46%] max-w-60 shrink-0 max-h-full overflow-hidden rounded-[1.5rem] border-[6px] border-brand-ink-900 bg-brand-ink-900 shadow-[0_24px_52px_-28px_rgb(17_24_39/0.6)]",
                            k % 2 === 0 ? "translate-y-[-2%]" : "translate-y-[2%]",
                          ]}
                        >
                          {/* `quality` 95: ảnh chụp giao diện, chữ nhỏ và nét mảnh 1px.
                              Ghi chú đặt ngoài thẻ — chú thích nhét vào giữa attribute
                              của thẻ Image bị Astro đọc thành attribute rời. */}
                          <Image
                            src={device.src}
                            alt={device.alt}
                            width={520}
                            densities={[1, 2]}
                            format="webp"
                            quality={95}
                            loading="lazy"
                            decoding="async"
                            class="block h-auto w-full"
                          />
                        </div>
                      ))}
                    </div>
                  ) : v.contain ? (
                    /* `class`: dưới `lg` ảnh chạy theo bề ngang (tối đa 24rem, canh giữa)
                       rồi để ô cao theo ảnh — cùng lý do đã ghi ở `WhyUs.astro`: ô ảnh ở
                       khổ hẹp thấp hơn ảnh nhiều nên bó theo chiều cao thì ảnh còn bằng
                       con tem.

                       Chú thích để NGOÀI thẻ: nhét vào giữa các attribute thì Astro đọc
                       từng chữ trong chú thích thành một attribute rời và `astro check`
                       báo lỗi type (`Property 'Dưới' does not exist`). */
                    <Image
                      src={v.image}
                      alt={`${v.title} — ${v.note}`}
                      width={720}
                      densities={[1, 2]}
                      format="webp"
                      quality={88}
                      loading="lazy"
                      decoding="async"
                      class="mx-auto h-auto w-full max-w-96 rounded-2xl object-contain lg:size-full lg:max-w-none"
                    />
                  ) : (
                    /* Ảnh chụp lớp học phủ kín nửa thẻ — cắt cạnh thay vì hiện trọn. */
                    <Image
                      src={v.image}
                      alt={v.title}
                      widths={[640, 1024]}
                      sizes="(min-width: 1024px) 50vw, 100vw"
                      format="webp"
                      quality={88}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 size-full object-cover"
                    />
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-background">
      <div class="container mx-auto px-6">
        <SectionHeading
          title={reasons.title}
          highlight={reasons.highlight}
          description={reasons.intro}
        />

        <ol class="mt-12 grid gap-5 lg:grid-cols-2">
          {
            reasons.items.map((r) => (
              <li class="flex flex-col rounded-3xl border border-border bg-background p-7">
                <h3 class="text-lg font-extrabold leading-snug text-brand-ink-900">
                  {r.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {r.desc}
                </p>

                {"bullets" in r && (
                  <ul class="mt-5 flex flex-col gap-2.5">
                    {r.bullets.map((b) => (
                      <li class="flex items-start gap-2.5">
                        <span
                          class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-500 text-white [&>svg]:size-3"
                          set:html={ICONS.check}
                        />
                        <span class="text-sm font-medium leading-relaxed text-foreground/85">
                          {b}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}

                {"note" in r && (
                  <p class="mt-5 border-t border-border pt-4 text-xs leading-relaxed text-muted-foreground">
                    {r.note}
                  </p>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
