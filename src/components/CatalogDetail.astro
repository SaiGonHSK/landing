---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RegisterSection from "@/components/RegisterSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import EnrollCta from "@/components/EnrollCta.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { contact, site } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { registerHref, registerNote } from "@/lib/registerLink";
import { clampDescription, courseSchema as buildCourseSchema } from "@/lib/seo";
import { breadcrumbNodes } from "@/lib/schema";

interface Props {
  title: string;
  summary: string;
  intro: string;
  facts?: { label: string; value: string }[];
  content?: string[];
  contentTitle?: string;
  outcomes?: string[];
  topics?: { title: string; note?: string; items: string[] };
  curriculum?: { title: string; items: string[] }[];
  crumbs: { label: string; href?: string }[];
  glyph?: string;

  registerCourse?: string;

  trial?: boolean;

  related?: { label: string; href: string }[];
  relatedTitle?: string;

  courseSchema?: boolean;

  seoTitle?: string;

  seoDescription?: string;

  keywords?: string;

  cta?: "default" | "enroll";
}

const {
  title,
  summary,
  intro,
  facts = [],
  content = [],
  contentTitle = "Nội dung khoá học",
  outcomes = [],
  topics,
  curriculum = [],
  crumbs,
  glyph = "课",
  registerCourse,
  trial = false,
  related = [],
  relatedTitle = "Xem thêm",
  courseSchema = false,
  seoTitle,
  seoDescription,
  keywords,
  cta = "default",
} = Astro.props;

const origin = Astro.site?.origin ?? "";

const fact = (label: string) => facts.find((f) => f.label.startsWith(label))?.value;

const months = fact("Thời lượng");
const level = fact("Cấp độ");
const entry = fact("Đầu vào");
const mode = fact("Hình thức") ?? "Offline tại TP.HCM hoặc online";

const schemas: Record<string, unknown>[] = [
  ...breadcrumbNodes(crumbs, Astro.url.pathname, Astro.site),
];

if (courseSchema) {
  schemas.push(
    buildCourseSchema({
      name: title,
      description: summary,
      url: `${origin}${Astro.url.pathname}`,
      origin,
      provider: { name: site.fullName, address: contact.address },
      workload: months ?? fact("Số buổi"),
      level: level ?? fact("Mục tiêu"),
      credential: title.match(/HSK\s?[1-6]/i)?.[0].replace(/\s+/g, ""),
    }),
  );
}

const heroFacts = [
  {
    icon: ICONS.users,
    label: "Sĩ số lớp",
    value: "10–15 học viên",
    tone: "bg-linear-to-br from-rose-500 to-red-600 shadow-red-500/30",
  },
  {
    icon: ICONS.pin,
    label: "Hình thức học",
    value: mode,
    tone: "bg-linear-to-br from-sky-400 to-blue-600 shadow-blue-500/30",
  },
  {
    icon: ICONS.target,
    label: "Đầu vào",
    value: entry ?? "Test trình độ miễn phí",
    tone: "bg-linear-to-br from-emerald-400 to-green-600 shadow-emerald-500/30",
  },
].filter((f) => f.value);

const registerContext = { course: registerCourse, trial };
const registerNoteText = registerNote(registerContext);

const sectionTitle =
  "text-[1.75rem] font-black leading-tight tracking-tight text-brand-ink-900 md:text-[2rem]";
---

<Layout
  title={seoTitle ?? `${title} tại TPHCM | ${site.shortName}`}
  description={clampDescription(seoDescription ?? `${intro}`)}
  keywords={keywords}
  schemas={schemas}
>
  <Header />
  <main id="main" class="pb-16 lg:pb-24">
    <div class="container mx-auto px-6 pt-10 lg:pt-14">
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol
          class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-muted-foreground"
        >
          <li>
            <a href="/" class="transition-colors hover:text-brand-red-600">Trang chủ</a>
          </li>
          {
            crumbs.map((c) => (
              <>
                <li
                  aria-hidden="true"
                  class="inline-flex items-center opacity-60 [&>svg]:size-3"
                  set:html={ICONS.chevron}
                />
                <li>
                  {c.href ? (
                    <a href={c.href} class="transition-colors hover:text-brand-red-600">
                      {c.label}
                    </a>
                  ) : (
                    <span class="text-foreground">{c.label}</span>
                  )}
                </li>
              </>
            ))
          }
        </ol>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1fr_21rem] lg:items-start lg:gap-14">
        <div class="space-y-14 lg:space-y-16">
          <div>
            <h1
              class="text-[2.25rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-5xl"
            >
              {title}
            </h1>

            <p class="mt-5 text-base leading-relaxed text-muted-foreground md:text-lg">
              {intro}
            </p>

            <dl
              class="mt-9 grid gap-x-7 gap-y-6 border-t border-border pt-7 sm:grid-cols-2 xl:grid-cols-3"
            >
              {
                heroFacts.map((f, i) => (
                  <div
                    class:list={[
                      "flex items-center gap-3",
                      i > 0 && "sm:border-l sm:border-border sm:pl-7",
                      i === 2 && "sm:border-l-0 sm:pl-0 xl:border-l xl:pl-7",
                    ]}
                  >
                    <span
                      class:list={[
                        "grid size-10 shrink-0 place-items-center rounded-full text-white shadow-lg [&>svg]:size-[1.125rem]",
                        f.tone,
                      ]}
                    >
                      <Fragment set:html={f.icon} />
                    </span>
                    <div class="min-w-0">
                      <dt class="text-xs font-medium text-muted-foreground">{f.label}</dt>
                      <dd
                        class="mt-0.5 line-clamp-2 text-sm font-bold leading-snug text-brand-ink-900"
                        title={f.value}
                      >
                        {f.value}
                      </dd>
                    </div>
                  </div>
                ))
              }
            </dl>
          </div>

          {
            outcomes.length > 0 && (
              <section>
                <h2 class={sectionTitle}>Bạn đạt được sau khoá học</h2>
                <div class="mt-7 overflow-hidden rounded-2xl border border-border bg-background">
                  {outcomes.map((o, i) => (
                    <div
                      class:list={[
                        "flex items-start gap-3.5 px-6 py-5",
                        i > 0 && "border-t border-border",
                      ]}
                    >
                      <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-500 text-white [&>svg]:size-3">
                        <Fragment set:html={ICONS.check} />
                      </span>
                      <p class="text-sm leading-relaxed text-brand-ink-800 md:text-base">
                        {o}
                      </p>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          {
            (curriculum.length > 0 || content.length > 0 || topics) && (
              <section>
                <h2 class={sectionTitle}>
                  {months ? `Chương trình học ${months}` : "Chương trình học"}
                </h2>

                {curriculum.length > 0 && (
                  <div class="mt-7 grid gap-4">
                    {curriculum.map((block) => (
                      <div class="rounded-2xl border border-border bg-background p-6 md:p-7">
                        <h3 class="text-lg font-extrabold text-brand-ink-900">
                          {block.title}
                        </h3>
                        <ul class="mt-5 space-y-3">
                          {block.items.map((line) => (
                            <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                              <span
                                aria-hidden="true"
                                class="mt-0.5 shrink-0 text-brand-ink-400 [&>svg]:size-4"
                                set:html={ICONS.plus}
                              />
                              <span>{line}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
                <div class="mt-7 grid gap-4">
                  {curriculum.length === 0 && content.length > 0 && (
                    <div class="rounded-2xl border border-border bg-background p-6 md:p-7">
                      <h3 class="text-lg font-extrabold text-brand-ink-900">
                        {contentTitle}
                      </h3>
                      <ul class="mt-5 space-y-3">
                        {content.map((c) => (
                          <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                            <span
                              aria-hidden="true"
                              class="mt-0.5 shrink-0 text-brand-ink-400 [&>svg]:size-4"
                              set:html={ICONS.plus}
                            />
                            <span>{c}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {curriculum.length === 0 && topics && topics.items.length > 0 && (
                    <div class="rounded-2xl border border-border bg-background p-6 md:p-7">
                      <h3 class="text-lg font-extrabold text-brand-ink-900">
                        {topics.title}
                      </h3>
                      {topics.note && (
                        <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                          {topics.note}
                        </p>
                      )}
                      <ul class="mt-5 space-y-3">
                        {topics.items.map((t) => (
                          <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                            <span
                              aria-hidden="true"
                              class="mt-0.5 shrink-0 text-brand-ink-400 [&>svg]:size-4"
                              set:html={ICONS.plus}
                            />
                            <span>{t}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </section>
            )
          }

          {
            related.length > 0 && (
              <section>
                <h2 class="text-xl font-extrabold text-brand-ink-900">{relatedTitle}</h2>
                <div class="mt-5 flex flex-wrap gap-3">
                  {related.map((r) => (
                    <a
                      href={r.href}
                      class="rounded-lg border border-border bg-background px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-brand-ink-50"
                    >
                      {r.label}
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <aside class="lg:sticky lg:top-24 lg:order-last">
          <div
            class="overflow-hidden rounded-2xl border border-border bg-background shadow-sm"
          >
            <div class="relative grid h-40 place-items-center bg-brand-red-600 text-white">
              <span
                aria-hidden="true"
                class="absolute -right-3 -top-6 select-none text-[8rem] font-black leading-none text-white/10"
                >{glyph}</span
              >
              <div class="relative text-center">
                <p class="text-3xl font-black leading-none">100%</p>
                <p class="mt-2 text-xs font-bold uppercase tracking-[0.14em]">
                  Cam kết đầu ra
                </p>
              </div>
            </div>

            <div class="p-6">
              <p class="text-center text-base font-black text-brand-ink-900">
                Test trình độ &amp; học thử miễn phí
              </p>
              <p class="mt-2 text-center text-xs leading-relaxed text-muted-foreground">
                Học thử một buổi cùng lớp đang mở rồi mới quyết định.
              </p>

              <a
                href={registerHref(registerContext)}
                class="mt-5 flex w-full items-center justify-center gap-2 rounded-lg bg-brand-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-brand-red-700"
              >
                Đăng ký ngay
                <span class="[&>svg]:size-4" set:html={ICONS.arrow} />
              </a>

              <a
                href={`tel:${contact.phonePrimaryRaw}`}
                class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-lg border border-border px-6 py-3.5 text-sm font-bold text-brand-ink-900 transition-colors hover:bg-brand-ink-50"
              >
                <span class="text-brand-ink-400 [&>svg]:size-4" set:html={ICONS.phone} />
                {contact.phonePrimary}
              </a>

              <ul class="mt-6 space-y-3.5 border-t border-border pt-6">
                {
                  [
                    { icon: ICONS.book, text: "Giáo trình biên soạn riêng" },
                    { icon: ICONS.cap, text: "Giảng viên Thạc sĩ – Tiến sĩ" },
                    { icon: ICONS.shield, text: "Không đạt, học lại miễn phí" },
                  ].map((f) => (
                    <li class="flex items-center gap-3 text-sm text-brand-ink-800">
                      <span class="shrink-0 text-brand-ink-400 [&>svg]:size-4">
                        <Fragment set:html={f.icon} />
                      </span>
                      {f.text}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-16 lg:mt-24 lg:gap-24">
      {cta === "enroll" && <EnrollCta href={registerHref(registerContext)} />}
      <RegisterSection course={registerCourse} note={registerNoteText} />
      {cta === "default" && <CtaSection primaryHref={registerHref(registerContext)} />}
    </div>
  </main>
  <Footer />
  <FloatingContact />
</Layout>
