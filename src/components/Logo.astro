---
import { Image } from "astro:assets";
import logoMark from "@/assets/logo-mark.webp";
import { site } from "@/data/site";
import { currentSeason } from "@/data/giftPromos";

interface Props {

  markOnly?: boolean;

  onDark?: boolean;
  class?: string;
}
const { markOnly = false, onDark = false, class: className = "" } = Astro.props;

const season = currentSeason();
---

<a
  href="/"
  aria-label={`${site.fullName} — Trang chủ`}
  class:list={[
    "flex select-none items-center gap-2.5 leading-none transition-transform duration-200 hover:scale-[1.03]",
    className,
  ]}
>
  <span class="relative shrink-0">
  {
    season === "christmas" && (
      <svg
        class="pointer-events-none absolute top-[-22.92%] left-[-10.42%] z-10 h-[133.33%] w-[133.33%] drop-shadow-sm"
        viewBox="-20 -44 256 256"
        aria-hidden="true"
      >
        <path d="M55 9C62-30 120-48 168-38C198-31 216-8 218 24L204 28C200 8 188-6 172-10C184 10 190 40 189 71A96 96 0 0 0 55 9Z" fill="#d62839" />
        <path d="M172-10C184 10 190 40 189 71L180 66C181 38 176 14 166-4Z" fill="#a51d2d" opacity=".55" />
        <path d="M168-38C198-31 216-8 218 24L204 28C200 8 186-12 168-38Z" fill="#a51d2d" opacity=".35" />
        <path d="M52 14A93 93 0 0 1 191 76" fill="none" stroke="#e7e0d6" stroke-width="24" stroke-linecap="round" transform="translate(1 3)" />
        <path d="M52 14A93 93 0 0 1 191 76" fill="none" stroke="#fff" stroke-width="22" stroke-linecap="round" />
        <circle cx="212" cy="32" r="17" fill="#e7e0d6" />
        <circle cx="210" cy="30" r="16" fill="#fff" />
        <g transform="translate(14 170) rotate(-20)">
          <path d="M0 0C-6-14-22-18-32-10c6 2 6 9 12 9-2 6 4 10 20 1z" fill="#1e7d4c" stroke="#fff" stroke-width="2" />
          <path d="M0 0C14-6 28 0 32 12c-6-1-9 5-14 2-1 6-8 7-18-14z" fill="#1e7d4c" stroke="#fff" stroke-width="2" />
          <circle cx="-2" cy="4" r="6" fill="#e8334a" stroke="#fff" stroke-width="1.5" />
          <circle cx="8" cy="6" r="5.5" fill="#e8334a" stroke="#fff" stroke-width="1.5" />
          <circle cx="2" cy="-6" r="5" fill="#e8334a" stroke="#fff" stroke-width="1.5" />
        </g>
      </svg>
    )
  }
  {
    season === "luna" && (
      <svg
        class="pointer-events-none absolute top-[-22.92%] left-[-10.42%] z-10 h-[133.33%] w-[133.33%] drop-shadow-sm"
        viewBox="-20 -44 256 256"
        aria-hidden="true"
      >
        <Fragment set:html={`<path d="M25.1 17.2A106 106 0 0 1 199.7 74.0" fill="none" stroke="#6b3e1f" stroke-width="7" stroke-linecap="round"/><path d="M70.4 -6.9Q56.1 -14.9 35.9 -17.0" fill="none" stroke="#6b3e1f" stroke-width="4" stroke-linecap="round"/><path d="M139.1 -0.8Q156.9 -9.3 168.7 -11.8" fill="none" stroke="#6b3e1f" stroke-width="4" stroke-linecap="round"/><path d="M183.9 36.7Q186.7 18.0 183.5 5.4" fill="none" stroke="#6b3e1f" stroke-width="4" stroke-linecap="round"/><ellipse cx="51.2" cy="4.1" rx="8.2" ry="6.3" transform="rotate(10.0 51.2 4.1)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="43.3" cy="11.7" rx="8.2" ry="6.3" transform="rotate(82.0 43.3 11.7)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="33.6" cy="6.5" rx="8.2" ry="6.3" transform="rotate(154.0 33.6 6.5)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="35.5" cy="-4.2" rx="8.2" ry="6.3" transform="rotate(226.0 35.5 -4.2)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="46.4" cy="-5.7" rx="8.2" ry="6.3" transform="rotate(298.0 46.4 -5.7)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><circle cx="42.0" cy="2.5" r="4.5" fill="#e2611b"/><circle cx="46.4" cy="7.0" r="1.4" fill="#b8410e"/><circle cx="39.0" cy="8.0" r="1.4" fill="#b8410e"/><circle cx="35.8" cy="1.4" r="1.4" fill="#b8410e"/><circle cx="41.1" cy="-3.8" r="1.4" fill="#b8410e"/><circle cx="47.7" cy="-0.3" r="1.4" fill="#b8410e"/><ellipse cx="110.3" cy="-17.7" rx="9.9" ry="7.6" transform="rotate(-20.0 110.3 -17.7)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="106.7" cy="-5.1" rx="9.9" ry="7.6" transform="rotate(52.0 106.7 -5.1)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="93.6" cy="-4.7" rx="9.9" ry="7.6" transform="rotate(124.0 93.6 -4.7)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="89.1" cy="-17.0" rx="9.9" ry="7.6" transform="rotate(196.0 89.1 -17.0)" fill="#ffcc2e" stroke="#e8a317" stroke-wid