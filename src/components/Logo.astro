1.2"/><ellipse cx="194.7" cy="37.3" rx="7.7" ry="5.9" transform="rotate(293.0 194.7 37.3)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><circle cx="191.4" cy="45.3" r="4.2" fill="#e2611b"/><circle cx="195.8" cy="49.2" r="1.4" fill="#b8410e"/><circle cx="189.1" cy="50.7" r="1.4" fill="#b8410e"/><circle cx="185.5" cy="44.8" r="1.4" fill="#b8410e"/><circle cx="190.0" cy="39.6" r="1.4" fill="#b8410e"/><circle cx="196.4" cy="42.3" r="1.4" fill="#b8410e"/><ellipse cx="167.2" cy="-16.6" rx="5.5" ry="4.2" transform="rotate(0.0 167.2 -16.6)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="162.9" cy="-10.7" rx="5.5" ry="4.2" transform="rotate(72.0 162.9 -10.7)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="156.0" cy="-12.9" rx="5.5" ry="4.2" transform="rotate(144.0 156.0 -12.9)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="156.0" cy="-20.2" rx="5.5" ry="4.2" transform="rotate(216.0 156.0 -20.2)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="162.9" cy="-22.5" rx="5.5" ry="4.2" transform="rotate(288.0 162.9 -22.5)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><circle cx="161.0" cy="-16.6" r="3.0" fill="#e2611b"/><circle cx="164.4" cy="-14.1" r="1.4" fill="#b8410e"/><circle cx="159.7" cy="-12.6" r="1.4" fill="#b8410e"/><circle cx="156.8" cy="-16.6" r="1.4" fill="#b8410e"/><circle cx="159.7" cy="-20.6" r="1.4" fill="#b8410e"/><circle cx="164.4" cy="-19.1" r="1.4" fill="#b8410e"/><ellipse cx="57.2" cy="-18.8" rx="5.0" ry="3.8" transform="rotate(40.0 57.2 -18.8)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="50.8" cy="-17.2" rx="5.0" ry="3.8" transform="rotate(112.0 50.8 -17.2)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="47.3" cy="-22.8" rx="5.0" ry="3.8" transform="rotate(184.0 47.3 -22.8)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="51.6" cy="-27.8" rx="5.0" ry="3.8" transform="rotate(256.0 51.6 -27.8)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><ellipse cx="57.6" cy="-25.4" rx="5.0" ry="3.8" transform="rotate(328.0 57.6 -25.4)" fill="#ffcc2e" stroke="#e8a317" stroke-width="1.2"/><circle cx="52.9" cy="-22.4" r="2.7" fill="#e2611b"/><circle cx="53.8" cy="-18.7" r="1.4" fill="#b8410e"/><circle cx="49.7" cy="-20.4" r="1.4" fill="#b8410e"/><circle cx="50.0" cy="-24.8" r="1.4" fill="#b8410e"/><circle cx="54.3" cy="-25.9" r="1.4" fill="#b8410e"/><circle cx="56.7" cy="-22.1" r="1.4" fill="#b8410e"/><circle cx="78.7" cy="-26.8" r="4.5" fill="#ffcc2e" stroke="#e8a317" stroke-width="1"/><circle cx="189.5" cy="17.6" r="4.5" fill="#ffcc2e" stroke="#e8a317" stroke-width="1"/><circle cx="16.3" cy="29.2" r="4.5" fill="#ffcc2e" stroke="#e8a317" stroke-width="1"/><circle cx="206.9" cy="55.6" r="4.5" fill="#ffcc2e" stroke="#e8a317" stroke-width="1"/><path d="M198.9 70.4L206.9 100.4" stroke="#e8a317" stroke-width="1.6"/><rect x="197.9" y="98.4" width="18" height="5" rx="1.5" fill="#f2b632"/><ellipse cx="206.9" cy="122.4" rx="20" ry="20" fill="#e3262f" stroke="#fff" stroke-width="1.6"/><path d="M206.9 102.4C197.9 112.4 197.9 132.4 206.9 142.4M206.9 102.4C215.9 112.4 215.9 132.4 206.9 142.4" fill="none" stroke="#a51d2d" stroke-width="1.4"/><text x="206.9" y="128.4" text-anchor="middle" font-size="17" font-weight="700" fill="#ffd76a" >福</text><rect x="197.9" y="141.4" width="18" height="5" rx="1.5" fill="#f2b632"/><path d="M202.9 146.4v14M206.9 146.4v17M210.9 146.4v14" stroke="#f2b632" stroke-width="1.8" stroke-linecap="round"/>`} />
      </svg>
    )
  }
  <Image
    src={logoMark}
    alt={`Logo ${site.fullName}`}
    width={44}
    densities={[1, 2]}
    format="webp"
    quality={90}
    loading="eager"
    class:list={[
      "size-10 shrink-0 object-contain md:size-11",
      onDark && "rounded-full bg-white p-0.5",
    ]}
  />
  </span>

  {
    !markOnly && (
      <span class="flex flex-col gap-0.5">
        <span
          class:list={[
            "text-sm font-extrabold whitespace-nowrap uppercase tracking-[0.08em] md:text-base",
            onDark ? "text-white" : "text-foreground",
          ]}
        >
          Hoa văn SaigonHSK
        </span>
        <span
          class:list={[
            "text-[11px] font-semibold tracking-[0.12em]",
            onDark
              ? "text-white/75"
              : "text-brand-red-600",
          ]}
        >
          {site.slogan}
        </span>
      </span>
    )
  }
</a>
