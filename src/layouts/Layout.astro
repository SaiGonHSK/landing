---
import "@/styles/global.css";
import Lightbox from "@/components/Lightbox.astro";
import { site, contact } from "@/data/site";
import { contentUpdatedAt } from "@/data/content";
import { keywordString } from "@/lib/seo";
import { canonicalUrl, enrollActionSchema, graph, speakable } from "@/lib/schema";
import classroom from "@/assets/facility/classroom.webp";
import facility1 from "@/assets/facility/facility-1.webp";
import facility2 from "@/assets/facility/facility-2.webp";
import ogDefault from "@/assets/og-default.jpg";

interface Props {
  title?: string;
  description?: string;

  image?: string;

  ogType?: string;

  noindex?: boolean;

  schemas?: Record<string, unknown>[];

  preloadImage?: string;

  keywords?: string;
}

const {
  title = `Trung tâm tiếng Trung TPHCM — luyện thi HSK | SaigonHSK`,
  description = site.description,
  image = ogDefault.src,
  ogType = "website",
  noindex = false,
  schemas = [],
  preloadImage,
  keywords,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "@id": `${canonical.origin}/#organization`,
  name: site.fullName,
  alternateName: Array.from(new Set([
    site.shortName,
    "Hoa văn SaigonHSK",
    "SaigonHSK",
    "Trung tâm tiếng Trung SaigonHSK",
    "Saigon HSK",
    "Hoa văn Sài Gòn HSK",
    "Trung tâm Hoa văn Sài Gòn HSK",
    "hoa van sai gon hsk",
    "trung tam hoa van sai gon hsk",
    "trung tam hoa van saigonhsk",
    "trung tam hoc tieng trung tphcm",
    "trung tam hoc tieng trung tai tphcm",
    "trung tam tieng trung sai gon",
  ])),
  slogan: `${site.slogan} — ${site.sloganVi}`,
  description: site.description,
  url: canonical.origin,
  logo: {
    "@type": "ImageObject",
    url: new URL("/favicon.png", Astro.site).href,
    width: 192,
    height: 192,
  },
  image: [classroom, facility1, facility2].map(
    (asset) => new URL(asset.src, Astro.site).href,
  ),
  email: contact.email,
  telephone: contact.phones,
  foundingDate: String(site.foundedYear),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: `Giấy phép hoạt động đào tạo — ${site.license.authority}`,
    description: site.license.text,
    credentialCategory: "license",
    recognizedBy: {
      "@type": "GovernmentOrganization",
      name: site.license.authority,
    },
  },
  priceRange: "$$",
  currenciesAccepted: "VND",
  address: {
    "@type": "PostalAddress",
    streetAddress: "384/8 Lý Thái Tổ, Phường Vườn Lài",
    addressLocality: "Thành phố Hồ Chí Minh",
    addressRegion: "TP.HCM",
    addressCountry: "VN",
  },
  hasMap: contact.mapsUrl,
  areaServed: [
    { "@type": "City", name: "Thành phố Hồ Chí Minh" },
    { "@type": "Country", name: "Việt Nam" },
  ],
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "Tư vấn khoá học và học phí",
      telephone: contact.phonePrimary,
      email: contact.email,
      areaServed: "VN",
      availableLanguage: ["vi", "zh-Hans"],
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "08:00",
      closes: "21:00",
    },
  ],
  knowsLanguage: ["vi", "zh-Hans"],
  knowsAbout: [
    "Tiếng Trung Quốc",
    "Kỳ thi HSK",
    "Chuẩn HSK 3.0",
    "Tiếng Trung thương mại",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Khoá học tiếng Trung tại SaigonHSK",
    itemListElement: [
      "Khoá tiếng Trung sơ cấp cho người mới bắt đầu",
      "Khoá tiếng Trung trung cấp và cao cấp",
      "Lớp luyện thi chứng chỉ HSK3, HSK4, HSK5",
      "Tiếng Trung giao tiếp cấp tốc",
      "Tiếng Trung công sở và doanh nghiệp",
      "Tiếng Trung cho trẻ em",
      "Lớp VIP 1 kèm 1",
    ].map((name) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Course", name, inLanguage: "vi-VN" },
    })),
  },
  sameAs: [contact.facebook, contact.zalo, contact.tiktok],
  potentialAction: { "@id": `${canonical.origin}/#enroll` },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${canonical.origin}/#website`,
  url: canonical.origin,
  name: site.fullName,
  alternateName: site.shortName,
  description: site.description,
  inLanguage: "vi-VN",
  publisher: { "@id": `${canonical.origin}/#organization` },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: "vi-VN",
  isPartOf: { "@id": `${canonical.origin}/#website` },
  about: { "@id": `${canonical.origin}/#organization` },
  dateModified: contentUpdatedAt,
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  speakable,
};

const jsonLd = graph([
  organizationSchema,
  enrollActionSchema(canonical.origin, contact.phonePrimary),
  websiteSchema,
  webPageSchema,
  ...schemas,
]);

const metaKeywords = Array.from(
  new Set(
    `${keywords ? `${keywords}, ` : ""}${keywordString}`
      .split(",")
      .map((k) => k.trim())
      .filter(Boolean),
  ),
).join(", ");
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex,nofollow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#c8102e" />
    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content="Thành phố Hồ Chí Minh" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-brand-red-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      Bỏ qua điều hướng, tới nội dung chính
    </a>
    <slot />
    <Lightbox />

    <script>
      import { captureAttribution } from "@/lib/attribution";

      captureAttribution();
    </script>

    {}
    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (reduce || !("IntersectionObserver" in window)) return;

        const main = document.getElementById("main");
        if (!main) return;

        const stagger = (el) => {
          const grid = el.querySelector(
            ':scope > .container > [class*="grid-cols"], :scope > .container > .grid, :scope > [class*="grid-cols"]'
          );
          if (!grid) return;
          Array.from(grid.children)
            .slice(0, 8)
            .forEach((child, i) => {
              child.style.setProperty("--reveal-delay", `${i * 70}ms`);
              child.classList.add("reveal", "reveal-child");
            });
        };

        const targets = [];
        main.querySelectorAll(":scope > section").forEach((section) => {

          if (section.querySelector(".sticky")) {
            section
              .querySelectorAll(":scope > .container > *")
              .forEach((block) => targets.push(block));
          } else {
            targets.push(section);
            stagger(section);
          }
        });

        if (!targets.length) return;
        targets.forEach((el) => el.classList.add("reveal"));

        const show = (el) => {
          el.classList.add("reveal-in");
          el.querySelectorAll(".reveal-child").forEach((c) =>
            c.classList.add("reveal-in")
          );
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              show(entry.target);
              io.unobserve(entry.target);
            });
          },

          { rootMargin: "0px 0px -12% 0px", threshold: [0, 0.08] }
        );

        requestAnimationFrame(() => {
          targets.forEach((el) => {
            const top = el.getBoundingClientRect().top;
            if (top < window.innerHeight * 0.9) show(el);
            else io.observe(el);
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;

    min-height: 100%;
  }
</style>
