---
interface Props {
  title: string;

  highlight?: string;
  inlineHighlight?: boolean;
  description?: string;
  note?: string;
  align?: "center" | "left";
  className?: string;
}

const {
  title,
  highlight,
  inlineHighlight = false,
  description,
  note,
  align = "center",
  className = "",
} = Astro.props;

const wrap =
  align === "center"
    ? "mx-auto max-w-3xl text-center items-center"
    : "max-w-3xl text-left items-start";
---

<div class:list={["flex flex-col", wrap, className]}>
  {
    note && (
      <p class="mb-5 w-fit -rotate-2 rounded-2xl border border-dashed border-brand-red-200 bg-brand-red-50 px-4 py-2 font-hand text-xl leading-tight text-brand-red-700 md:text-2xl">
        {note}
      </p>
    )
  }

  <h2
    class="text-[2rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-5xl"
  >
    {title}
    {inlineHighlight && " "}
    {
      highlight && (
        <span
          class:list={[
            "text-[2rem] font-black leading-[1.05] tracking-tight text-brand-red-600 md:text-5xl",
            inlineHighlight ? "inline whitespace-nowrap" : "mt-1 block",
          ]}
        >
          {highlight}
        </span>
      )
    }
  </h2>

  {
    description && (
      <p
        class="mt-6 max-w-2xl text-base leading-relaxed text-balance text-muted-foreground md:text-lg"
      >
        {description}
      </p>
    )
  }
</div>
