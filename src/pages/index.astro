---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/HeroV5.astro";
import Promotions from "@/components/Promotions.astro";
import WhyUs from "@/components/WhyUs.astro";
import Courses from "@/components/Courses.astro";
import Teacher from "@/components/Teacher.astro";
import Facility from "@/components/Facility.astro";
import Activities from "@/components/Activities.astro";
import Achievements from "@/components/Achievements.astro";
import Testimonials from "@/components/Testimonials.astro";
import TrialCta from "@/components/TrialCta.astro";
import FAQ from "@/components/FAQ.astro";
import CtaSection from "@/components/CtaSection.astro";
import Footer from "@/components/Footer.astro";
import FloatingContact from "@/components/FloatingContact.astro";
import { visiblePrograms } from "@/data/programsApi";
import { teachers } from "@/data/teachers";
import { itemListSchema } from "@/lib/seo";
import { hskTermSetSchema, teacherListSchema } from "@/lib/schema";

const origin = Astro.site?.origin ?? "";

const schemas = [
  hskTermSetSchema(origin),
  itemListSchema(
    "Chương trình đào tạo tiếng Trung tại SaigonHSK",
    visiblePrograms().map((p) => ({
      title: p.title,
      href: `/courses/programs/${p.slug}`,
    })),
    origin,
  ),
  teacherListSchema(teachers, origin),
];
---

<Layout
  title="Trung tâm tiếng Trung TPHCM — luyện thi HSK | SaigonHSK"
  description="Trung tâm tiếng Trung uy tín tại TP.HCM, có giấy phép của Sở Giáo dục: học từ con số 0 đến HSK6, luyện thi HSK. Lớp 10–15 học viên, cam kết 100% đầu ra."
  keywords="trung tâm tiếng Trung TPHCM, học tiếng Trung ở đâu tốt, trung tâm tiếng Trung Sài Gòn, luyện thi HSK TPHCM, học tiếng Trung cho người mới bắt đầu, trung tâm tiếng Trung có giấy phép Sở Giáo dục, hoc tieng trung, trung tam tieng trung tphcm, luyen thi hsk"
  schemas={schemas}
>
  <Header />
  <main id="main" class="flex flex-col gap-14 lg:gap-[4.5rem]">
    <Hero />
    <Promotions />
    <Achievements />
    <WhyUs />
    <Courses limit={4} />
    <!-- <Roadmap /> -->
    <Teacher />
    <Activities />
    <Facility />
    {
      /* Trang chủ chỉ lấy 6 thẻ đầu; phần còn lại ở `/about/reviews`. Xem `limit`
        trong `Testimonials.astro`. */
    }
    <Testimonials limit={6} />
    <TrialCta />
    <FAQ limit={5} />
    <!-- <RegisterSection /> -->
    <CtaSection />
  </main>
  <Footer />
  <FloatingContact />
</Layout>
