---
import HeroStickers from "@/components/HeroStickers.astro";

interface Props {
  variant?: "hero" | "band";
  stickers?: "portrait" | "wide" | "none";
  /** Sóng trắng ở đáy — tắt khi có nội dung (ảnh, thẻ) chạm mép dưới hero. */
  wave?: boolean;
}

const { variant = "hero", stickers = "portrait", wave = true } = Astro.props;

const WAVE_BACK = "M0 96C180 66 300 18 520 24s300 72 540 62 220-42 380-32V160H0Z";
const WAVE_FRONT =
  "M0 128C130 104 250 40 460 46s300 72 540 66 220-46 440-34V160H0Z";
---
<div
  class:list={[
    "hero-bd-base pointer-events-none absolute inset-0 -z-10",
    variant === "band" && "is-band",
  ]}
>
</div>
<div class="hero-bd-glow pointer-events-none absolute inset-0 -z-10"></div>
<div
  class:list={[
    "hero-bd-grid pointer-events-none absolute inset-0 -z-10",
    variant === "band" && "is-band",
  ]}
>
</div>

{stickers !== "none" && <HeroStickers variant={stickers} />}

{
  variant === "hero" && wave && (
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-28 sm:h-36 lg:h-44"
      aria-hidden="true"
    >
      <svg
        class="absolute inset-0 size-full"
        viewBox="0 0 1440 160"
        preserveAspectRatio="none"
        fill="none"
      >
        <path d={WAVE_BACK} fill="var(--background)" opacity="0.5" />
        <path class="hero-bd-wave" d={WAVE_FRONT} fill="var(--background)" />
      </svg>
    </div>
  )
}

<style>
  .hero-bd-base {
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #fbfbfc 45%,
      var(--brand-ink-50) 100%
    );
  }

  .hero-bd-base.is-band {
    background: linear-gradient(
      180deg,
      var(--background) 0%,
      var(--brand-ink-50) 34%,
      var(--brand-ink-50) 70%,
      var(--background) 100%
    );
  }

  .hero-bd-glow {
    background:
      radial-gradient(
        60% 55% at 16% 6%,
        rgba(18, 19, 22, 0.05) 0%,
        transparent 70%
      ),
      radial-gradient(
        50% 50% at 90% 88%,
        rgba(18, 19, 22, 0.04) 0%,
        transparent 70%
      );
  }

  .hero-bd-grid {
    background-image:
      linear-gradient(to right, rgba(18, 19, 22, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 19, 22, 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(70% 65% at 50% 30%, #000 0%, transparent 100%);
  }

  .hero-bd-grid.is-band {
    mask-image: radial-gradient(72% 70% at 50% 50%, #000 0%, transparent 100%);
  }

  .hero-bd-wave {
    filter: drop-shadow(0 -10px 22px rgba(18, 19, 22, 0.07));
  }
</style>
