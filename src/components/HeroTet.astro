---
import { hero } from "@/data/site";
import { ICONS } from "@/lib/icons";
import { TET_WISHES } from "@/data/tetWishes";

let seed = 31;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

const GOLD = "#f4c430";
const GOLD_D = "#c99a1a";

const SHAPES = {
  lantern: `<rect x="17" y="2" width="16" height="6" rx="1.5" fill="${GOLD}"/><ellipse cx="25" cy="30" rx="22" ry="21" fill="#e3262f"/><path d="M25 9c-11 9-11 33 0 42M25 9c11 9 11 33 0 42M10 14c-5 9-5 23 0 32M40 14c5 9 5 23 0 32" fill="none" stroke="${GOLD_D}" stroke-width="1.4"/><text x="25" y="36" text-anchor="middle" font-size="16" font-weight="800" fill="#ffd76a">福</text><rect x="17" y="50" width="16" height="6" rx="1.5" fill="${GOLD}"/><path d="M20 56v13M25 56v15M30 56v13" stroke="${GOLD}" stroke-width="2" stroke-linecap="round"/>`,
  envelope: `<rect x="3" y="3" width="34" height="50" rx="3" fill="#e3262f" stroke="${GOLD}" stroke-width="2"/><path d="M3 8l17 13 17-13" fill="none" stroke="${GOLD}" stroke-width="2"/><circle cx="20" cy="34" r="8" fill="${GOLD}"/><text x="20" y="38.5" text-anchor="middle" font-size="11" font-weight="800" fill="#b5121d">福</text>`,
  fire: `<path d="M20 2v10" stroke="${GOLD_D}" stroke-width="2"/><rect x="6" y="12" width="12" height="26" rx="3" fill="#e3262f"/><rect x="22" y="16" width="12" height="26" rx="3" fill="#d11f28"/><rect x="10" y="38" width="12" height="26" rx="3" fill="#e3262f"/><path d="M6 18h12M22 22h12M10 44h12M6 32h12M22 36h12M10 58h12" stroke="${GOLD}" stroke-width="2.4"/><path d="M16 64c0 4 2 6 0 8M28 42c0 4 2 6 0 8" stroke="${GOLD_D}" stroke-width="1.5" fill="none"/>`,
  coin: `<circle cx="20" cy="20" r="17" fill="${GOLD}" stroke="${GOLD_D}" stroke-width="2"/><circle cx="20" cy="20" r="12" fill="none" stroke="${GOLD_D}" stroke-width="1.4"/><rect x="15" y="15" width="10" height="10" fill="#b5121d"/>`,
  fu: `<path d="M22 2 42 22 22 42 2 22Z" fill="#e3262f" stroke="${GOLD}" stroke-width="2"/><text x="22" y="29" text-anchor="middle" font-size="18" font-weight="800" fill="#ffd76a">福</text><path d="M22 42v6M18 48h8M19 50v12M22 50v14M25 50v12" stroke="${GOLD}" stroke-width="2" stroke-linecap="round"/>`,
};
type Shape = keyof typeof SHAPES;
const BOX: Record<Shape, [number, number]> = { lantern: [50, 72], envelope: [40, 56], fire: [40, 72], coin: [40, 40], fu: [44, 64] };

const GARLAND = { w: 1000, h: 240, y0: 18, sag: 70 };
const garlandY = (x: number) => {
  const t = x / GARLAND.w;
  return (1 - t) ** 2 * GARLAND.y0 + 2 * (1 - t) * t * GARLAND.sag + t ** 2 * GARLAND.y0;
};
const garlandItems = (
  [
    { x: 90, shape: "lantern", s: 1, drop: 6 },
    { x: 195, shape: "envelope", s: 1, drop: 12 },
    { x: 295, shape: "fire", s: 1, drop: 4 },
    { x: 400, shape: "coin", s: 1.1, drop: 16 },
    { x: 500, shape: "fu", s: 1.15, drop: 4 },
    { x: 600, shape: "coin", s: 1.1, drop: 16 },
    { x: 705, shape: "fire", s: 1, drop: 4 },
    { x: 805, shape: "envelope", s: 1, drop: 12 },
    { x: 910, shape: "lantern", s: 1, drop: 6 },
  ] as { x: number; shape: Shape; s: number; drop: number }[]
).map((it) => ({ ...it, y: garlandY(it.x), w: BOX[it.shape][0] * it.s, h: BOX[it.shape][1] * it.s }));

const sideLanterns = [
  { left: 3.5, len: 90, size: 54 },
  { left: 8, len: 200, size: 40, desktop: true },
  { left: 1.5, len: 260, size: 30, desktop: true },
  { left: 96.5, len: 100, size: 54 },
  { left: 92, len: 210, size: 40, desktop: true },
  { left: 98.5, len: 270, size: 30, desktop: true },
];

const WIRE = Array.from({ length: 121 }, (_, i) => {
  const x = 50 + i * 5;
  const y = 36 + Math.sin(i / 7) * 12;
  return `${i ? "L" : "M"}${x} ${y.toFixed(1)}`;
}).join("");
const coins = Array.from({ length: 11 }, (_, k) => {
  const i = 6 + k * 11;
  return { x: 50 + i * 5, y: 36 + Math.sin(i / 7) * 12 + 14, knot: k % 2 === 1 };
});

const mai = (x: number, y: number, r: number) =>
  Array.from({ length: 5 }, (_, k) => {
    const a = ((k * 72 - 90) * Math.PI) / 180;
    return { cx: +(x + Math.cos(a) * r * 0.58).toFixed(1), cy: +(y + Math.sin(a) * r * 0.58).toFixed(1), r: +(r * 0.52).toFixed(1) };
  });

const TREE_BRANCHES = [
  "M160 330C158 280 150 240 132 200C118 170 96 150 70 130",
  "M152 262C176 226 206 204 246 186",
  "M136 210C140 170 150 140 170 110",
  "M118 176C96 172 72 178 44 196",
  "M200 214C220 180 236 150 264 128",
  "M168 124C190 100 214 88 240 84",
  "M100 150C92 120 94 96 104 70",
  "M246 186C268 182 286 188 300 200",
];
const TREE_CLUSTERS = [
  [70, 130], [246, 186], [170, 110], [44, 196], [264, 128], [240, 84], [104, 70], [300, 200], [150, 160], [200, 150], [120, 120],
];
const treeFlowers = TREE_CLUSTERS.flatMap(([cx, cy]) =>
  Array.from({ length: 5 }, () => ({ x: cx + (rand() - 0.5) * 56, y: cy + (rand() - 0.5) * 40, r: 8 + rand() * 6 })),
);
const treeBuds = TREE_CLUSTERS.flatMap(([cx, cy]) =>
  Array.from({ length: 3 }, () => ({ x: cx + (rand() - 0.5) * 70, y: cy + (rand() - 0.5) * 50 })),
);
const treeEnvelopes = [
  [96, 168], [214, 140], [276, 214], [58, 214],
];
---

<section id="hero" class="tt-hero relative isolate overflow-hidden">
  <script is:inline>
    (function (hero) {
      if (!hero) return;
      var head = document.getElementById("site-header");
      var overlay = head && head.dataset.glass === "true";
      if (head) {
        hero.style.setProperty("--tt-head", overlay ? "0px" : head.offsetHeight + "px");
        hero.style.setProperty("--tt-top", overlay ? head.offsetHeight + "px" : "0px");
        if (overlay) document.documentElement.style.setProperty("--header-overlap", head.offsetHeight + "px");
      }
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      hero.dataset.gift = "closed";
      setTimeout(function () {
        if (!hero.dataset.giftJs) delete hero.dataset.gift;
      }, 4000);
    })(document.currentScript && document.currentScript.parentElement);
  </script>

  <h1 class="sr-only">{hero.titleLine1} {hero.titleLine2}</h1>
  <p class="sr-only" data-speakable>
    Trung tâm Hoa văn SaigonHSK — dạy tiếng Trung và luyện thi HSK tại TP.HCM (Sài Gòn), cam kết 100% đầu ra.
  </p>

  <canvas data-tt-petals class="tt-petals" aria-hidden="true"></canvas>

  <svg class="tt-garland tt-deco" viewBox={`0 0 ${GARLAND.w} ${GARLAND.h}`} aria-hidden="true">
    <path d={`M0 ${GARLAND.y0}Q${GARLAND.w / 2} ${GARLAND.sag * 2 - GARLAND.y0} ${GARLAND.w} ${GARLAND.y0}`} class="tt-cord" />
    {
      garlandItems.map((it, i) => (
        <g class="tt-swing" style={`transform-origin:${it.x}px ${it.y.toFixed(1)}px;animation-delay:${(i * 410) % 2400}ms`}>
          <path d={`M${it.x} ${it.y.toFixed(1)}v${it.drop}`} class="tt-thread" />
          <circle cx={it.x} cy={it.y} r="3.5" fill={GOLD} />
          <svg
            x={it.x - it.w / 2}
            y={it.y + it.drop}
            width={it.w}
            height={it.h}
            viewBox={`0 0 ${BOX[it.shape][0]} ${BOX[it.shape][1]}`}
            set:html={SHAPES[it.shape]}
          />
        </g>
      ))
    }
  </svg>

  {
    sideLanterns.map((h, i) => (
      <div
        class:list={["tt-hang tt-deco", h.desktop && "hidden md:block"]}
        style={`left:${h.left}%;--len:${h.len}px;--size:${h.size}px;animation-delay:${(i * 530) % 2600}ms`}
        aria-hidden="true"
      >
        <svg viewBox="0 0 50 72" set:html={SHAPES.lantern} />
      </div>
    ))
  }

  <svg class="tt-tree tt-deco" viewBox="0 0 320 440" aria-hidden="true">
    {TREE_BRANCHES.map((d, i) => <path d={d} class="tt-trunk" stroke-width={i === 0 ? 12 : 5} />)}
    {treeBuds.map((b) => <circle cx={b.x.toFixed(1)} cy={b.y.toFixed(1)} r="4" fill="#ffcc2e" stroke="#e3a514" stroke-width="1" />)}
    {
      treeFlowers.map((f) => (
        <g>
          {mai(f.x, f.y, f.r).map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} fill="#ffcc2e" stroke="#e3a514" stroke-width="1" />)}
          <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={(f.r * 0.26).toFixed(1)} fill="#e2611b" />
        </g>
      ))
    }
    {
      treeEnvelopes.map(([x, y]) => (
        <g class="tt-swing" style={`transform-origin:${x}px ${y}px`}>
          <path d={`M${x} ${y}v8`} class="tt-thread" />
          <svg x={x - 9} y={y + 8} width="18" height="25" viewBox="0 0 40 56" set:html={SHAPES.envelope} />
        </g>
      ))
    }
    <path d="M96 330h128l-14 96H110z" fill="#2f5fa7" />
    <path d="M90 322h140v14H90z" fill="#3a6fc0" />
    <path d="M118 360c14-10 28 10 42 0s28 10 42 0M114 392c16-10 30 10 46 0s30 10 46 0" stroke="#e8eef8" stroke-width="3" fill="none" />
  </svg>

  <svg class="tt-gifts tt-deco" viewBox="0 0 300 300" aria-hidden="true">
    <g class="tt-gift">
      <rect x="150" y="150" width="145" height="150" fill="#d11f28" />
      <path d="M150 210h145M222 150v150" stroke={GOLD} stroke-width="10" />
      <path d="M222 150c-18-28-48-20-34 0zM222 150c18-28 48-20 34 0z" fill="none" stroke={GOLD} stroke-width="7" />
    </g>
    <g class="tt-gift">
      <rect x="160" y="70" width="125" height="80" fill={GOLD} />
      <path d="M160 100h125M222 70v80" stroke="#d11f28" stroke-width="8" />
      <text x="190" y="135" font-size="22" font-weight="800" fill="#b5121d">春</text>
    </g>
    <g class="tt-gift">
      <rect x="10" y="176" width="124" height="124" rx="6" fill="#3f8a3a" />
      <path d="M10 214h124M10 262h124M48 176v124M96 176v124" stroke="#7cc06a" stroke-width="2" opacity=".6" />
      <path d="M10 238h124M72 176v124" stroke="#e3262f" stroke-width="5" />
      <path d="M10 242h124M76 176v124" stroke="#fff" stroke-width="1.5" opacity=".8" />
    </g>
    <g class="tt-gift">
      <svg x="118" y="232" width="40" height="56" viewBox="0 0 40 56" set:html={SHAPES.envelope} transform="rotate(-12 138 260)" />
    </g>
  </svg>

  <div class="tt-stage">
    <div class="tt-lockup">
      <p class="tt-words" aria-hidden="true">
        <span class="tt-line tt-line--1">
          {[..."CHÚC MỪNG"].map((ch) => (ch === " " ? <span class="tt-space"> </span> : <span class="tt-letter">{ch}</span>))}
        </span>
        <span class="tt-line tt-line--2">
          <svg class="tt-sprig tt-sprig--left" viewBox="0 0 120 80">
            <path d="M118 46C90 44 62 36 30 18M74 38C66 26 66 14 72 4" stroke="#6b3e1f" stroke-width="4" fill="none" stroke-linecap="round" />
            {[[30, 18, 14], [72, 6, 12], [96, 44, 11]].map(([x, y, r]) => (
              <g>
                {mai(x, y, r).map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} fill="#ffcc2e" stroke="#e3a514" stroke-width="1" />)}
                <circle cx={x} cy={y} r={r * 0.26} fill="#e2611b" />
              </g>
            ))}
            <circle cx="52" cy="28" r="4" fill="#ffcc2e" />
          </svg>
          {[..."NĂM MỚI"].map((ch) => (ch === " " ? <span class="tt-space"> </span> : <span class="tt-letter">{ch}</span>))}
          <svg class="tt-sprig tt-sprig--right" viewBox="0 0 120 80">
            <g transform="translate(120 0) scale(-1 1)">
              <path d="M118 46C90 44 62 36 30 18M74 38C66 26 66 14 72 4" stroke="#6b3e1f" stroke-width="4" fill="none" stroke-linecap="round" />
              {[[30, 18, 14], [72, 6, 12], [96, 44, 11]].map(([x, y, r]) => (
                <g>
                  {mai(x, y, r).map((p) => <circle cx={p.cx} cy={p.cy} r={p.r} fill="#ffcc2e" stroke="#e3a514" stroke-width="1" />)}
                  <circle cx={x} cy={y} r={r * 0.26} fill="#e2611b" />
                </g>
              ))}
              <circle cx="52" cy="28" r="4" fill="#ffcc2e" />
            </g>
          </svg>
        </span>
      </p>

      <svg class="tt-coins" viewBox="0 0 700 90" aria-hidden="true">
        <svg x="0" y="0" width="40" height="72" viewBox="0 0 40 72" set:html={SHAPES.fire} />
        <svg x="660" y="0" width="40" height="72" viewBox="0 0 40 72" set:html={SHAPES.fire} />
        <path d={WIRE} class="tt-wire" />
        {
          coins.map((c) =>
            c.knot ? (
              <g class="tt-coin">
                <path d={`M${c.x} ${c.y - 14}v6`} class="tt-thread" />
                <path d={`M${c.x - 7} ${c.y - 2}l7-7 7 7-7 7z`} fill="#e3262f" stroke={GOLD} stroke-width="1.5" />
              </g>
            ) : (
              <g class="tt-coin">
                <path d={`M${c.x} ${c.y - 14}v4`} class="tt-thread" />
                <svg x={c.x - 12} y={c.y - 10} width="24" height="24" viewBox="0 0 40 40" set:html={SHAPES.coin} />
              </g>
            ),
          )
        }
      </svg>

      <div class="tt-message tt-fade">
        <p data-tt-wish>{TET_WISHES[0].text}</p>
      </div>
      <script type="application/json" data-tt-wishes set:html={JSON.stringify(TET_WISHES)} />
    </div>

    <div class="tt-fade tt-cta flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      <a
        href="/register"
        class="inline-flex h-11 items-center justify-center rounded-lg bg-white px-6 text-sm font-bold text-brand-red-700 transition-colors hover:bg-brand-red-50 sm:h-12 sm:px-7 sm:text-[0.95rem]"
      >
        Đăng ký nhận lì xì đầu xuân
      </a>
      <a
        href="/schedule"
        class="group inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-white/50 px-6 text-sm font-bold text-white transition-colors hover:bg-white/10 sm:h-12 sm:px-7 sm:text-[0.95rem]"
      >
        Xem lịch khai giảng
        <span class="transition-transform group-hover:translate-x-1 [&>svg]:size-[1.1rem]" set:html={ICONS.arrow} />
      </a>
    </div>

    <div class="tt-gate">
      <p class="tt-gate-title">SaigonHSK gửi bạn một món quà đầu xuân</p>
      <button type="button" data-tt-box class="tt-box" aria-label="Mở hộp quà Tết">
        <span data-tt-lid class="tt-lid"><span class="tt-bow"></span></span>
        <span data-tt-body class="tt-body"><span class="tt-seal">福</span></span>
      </button>
      <p data-tt-hint class="tt-hint">Chạm để mở quà Tết</p>
      <div data-tt-burst class="tt-burst" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .tt-hero {
    height: calc(100svh - var(--tt-head, 68px));
    min-height: 560px;
    display: grid;
    background: radial-gradient(ellipse at 50% 42%, #c9161f 0%, #a8121a 55%, #860c13 100%);
    color: #fff;
  }

  .tt-petals {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tt-garland {
    position: absolute;
    top: var(--tt-top, 0px);
    left: 50%;
    z-index: 2;
    width: min(72vw, 920px);
    translate: -50% 0;
    overflow: visible;
    pointer-events: none;
  }
  .tt-cord {
    fill: none;
    stroke: #f4c430;
    stroke-width: 3;
  }
  .tt-thread {
    stroke: #f4c430;
    stroke-width: 1.5;
  }
  .tt-hang {
    position: absolute;
    top: 0;
    z-index: 2;
    width: var(--size);
    translate: -50% 0;
    transform-origin: 50% 0;
    padding-top: calc(var(--len) + var(--tt-top, 0px));
    pointer-events: none;
  }
  .tt-hang::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 1.5px;
    height: calc(var(--len) + var(--tt-top, 0px) + 4px);
    background: #f4c430;
  }
  .tt-hang svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 10px rgb(60 4 10 / 0.35));
  }
  @media (prefers-reduced-motion: no-preference) {
    .tt-swing {
      animation: tt-swing 3.2s ease-in-out infinite alternate;
    }
    .tt-hang {
      animation: tt-hang 3.6s ease-in-out infinite alternate;
    }
  }
  @keyframes tt-swing {
    from {
      rotate: -4deg;
    }
    to {
      rotate: 4deg;
    }
  }
  @keyframes tt-hang {
    from {
      rotate: -3deg;
    }
    to {
      rotate: 3deg;
    }
  }

  .tt-tree {
    position: absolute;
    left: max(2vw, 8px);
    bottom: 0;
    z-index: 2;
    height: min(54%, 460px);
    pointer-events: none;
  }
  .tt-trunk {
    fill: none;
    stroke: #6b3e1f;
    stroke-linecap: round;
  }
  .tt-gifts {
    position: absolute;
    right: max(2vw, 8px);
    bottom: 0;
    z-index: 2;
    height: min(40%, 320px);
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .tt-tree {
      height: 26%;
      left: -10px;
    }
    .tt-gifts {
      height: 18%;
      right: 0;
    }
  }

  .tt-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(clamp(100px, 17vh, 180px) + var(--tt-top, 0px)) 16px clamp(110px, 18vh, 170px);
  }
  .tt-lockup {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    --tt-size: clamp(2.6rem, min(7.5vw, 11vh), 6.5rem);
  }
  .tt-words {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: var(--tt-size);
    font-weight: 900;
    line-height: 1.18;
    letter-spacing: 0.02em;
    text-align: center;
  }
  .tt-line {
    position: relative;
    white-space: nowrap;
  }
  .tt-line--1 {
    color: #fff;
    text-shadow: 0 0.05em 0 #7a0a12;
  }
  .tt-line--2 {
    color: #ffd76a;
    text-shadow: 0 0.05em 0 #7a0a12;
  }
  .tt-letter {
    display: inline-block;
  }
  .tt-space {
    display: inline-block;
    width: 0.3em;
  }
  .tt-sprig {
    position: absolute;
    top: 50%;
    width: 1.3em;
    translate: 0 -50%;
    pointer-events: none;
  }
  .tt-sprig--left {
    right: 100%;
    margin-right: 0.1em;
  }
  .tt-sprig--right {
    left: 100%;
    margin-left: 0.1em;
  }
  .tt-coins {
    width: calc(var(--tt-size) * 6);
    max-width: 94vw;
    margin-top: calc(var(--tt-size) * 0.04);
    overflow: visible;
  }
  .tt-wire {
    fill: none;
    stroke: #f4c430;
    stroke-width: 2;
  }
  .tt-message {
    max-width: 40rem;
    margin-top: calc(var(--tt-size) * 0.1);
    font-size: clamp(0.95rem, calc(var(--tt-size) * 0.2), 1.2rem);
    font-weight: 600;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.92);
    text-align: center;
    text-wrap: balance;
  }
  .tt-message strong {
    color: #ffd76a;
    font-weight: 800;
  }
  .tt-cta {
    margin-top: clamp(14px, 2.4vh, 26px);
  }

  .tt-gate {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding-top: var(--tt-top, 0px);
    padding-bottom: clamp(60px, 10vh, 120px);
    pointer-events: none;
  }
  [data-gift] .tt-gate {
    display: flex;
  }
  [data-gift="closed"] :is(.tt-lockup, .tt-cta) {
    visibility: hidden;
  }
  .tt-gate-title {
    margin-bottom: clamp(44px, 6vw, 72px);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 900;
    color: #fff;
    text-align: center;
    text-shadow: 0 0.05em 0 #7a0a12;
  }
  .tt-hint {
    font-weight: 700;
    color: #ffd76a;
  }
  .tt-box {
    position: relative;
    width: clamp(150px, 18vw, 210px);
    aspect-ratio: 210 / 170;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .tt-box:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 10px;
  }
  .tt-lid,
  .tt-body {
    position: absolute;
    background: #e3262f;
  }
  .tt-lid {
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 26%;
    border-radius: 6px;
    background: #d11f28;
    box-shadow: 0 6px 10px -6px rgb(0 0 0 / 0.4);
  }
  .tt-body {
    bottom: 0;
    left: 6%;
    right: 6%;
    height: 78%;
    border-radius: 0 0 8px 8px;
    box-shadow: inset 0 14px 18px -12px rgb(0 0 0 / 0.35);
  }
  .tt-lid::before,
  .tt-body::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 16%;
    height: 100%;
    translate: -50% 0;
    background: #f4c430;
  }
  .tt-bow {
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 24%;
    aspect-ratio: 1;
    translate: -50% 0;
  }
  .tt-bow::before,
  .tt-bow::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 0 10px #f4c430;
  }
  .tt-bow::before {
    transform: translateX(-45%) skewY(40deg);
  }
  .tt-bow::after {
    transform: translateX(45%) skewY(-40deg);
  }
  .tt-seal {
    position: absolute;
    left: 50%;
    top: 55%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #f4c430;
    color: #b5121d;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 900;
  }
  .tt-burst {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .tt-burst :global(i) {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
  }
</style>

<script>
  import { gsap } from "gsap";

  const hero = document.querySelector<HTMLElement>(".tt-hero");
  if (hero) wishes(hero);
  if (hero) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) decoIntro(hero);
    if (hero.dataset.gift === "closed") gate(hero);
  }

  function decoIntro(hero: HTMLElement) {
    const garland = hero.querySelector(".tt-garland");
    const hangs = gsap.utils.toArray<HTMLElement>(".tt-hang", hero);
    const tree = hero.querySelector(".tt-tree");
    const gifts = gsap.utils.toArray<SVGElement>(".tt-gift", hero);
    gsap
      .timeline({ delay: 0.1 })
      .from(garland, { y: -160, duration: 1.2, ease: "elastic.out(1, 0.55)" }, 0)
      .from(hangs, { y: -400, duration: 1.4, ease: "elastic.out(1, 0.5)", stagger: 0.08 }, 0.1)
      .from(tree, { scaleY: 0, transformOrigin: "50% 100%", duration: 0.9, ease: "back.out(1.4)" }, 0.2)
      .from(gifts, { y: -320, autoAlpha: 0, duration: 0.7, ease: "bounce.out", stagger: 0.12 }, 0.35)
      .add(() => petals(hero.querySelector<HTMLCanvasElement>("[data-tt-petals]")!), 0.5);
  }

  function gate(hero: HTMLElement) {
    hero.dataset.giftJs = "1";
    const box = hero.querySelector<HTMLButtonElement>("[data-tt-box]")!;
    const lid = hero.querySelector<HTMLElement>("[data-tt-lid]")!;
    const body = hero.querySelector<HTMLElement>("[data-tt-body]")!;
    const hint = hero.querySelector<HTMLElement>("[data-tt-hint]")!;
    const title = hero.querySelector<HTMLElement>(".tt-gate-title")!;
    const burst = hero.querySelector<HTMLElement>("[data-tt-burst]")!;

    gsap.from([title, box, hint], { y: 30, autoAlpha: 0, duration: 0.7, ease: "back.out(1.7)", stagger: 0.12, delay: 0.5 });
    const wobble = gsap
      .timeline({ repeat: -1, repeatDelay: 1.4, delay: 1.6 })
      .to(box, { rotation: -6, duration: 0.08 })
      .to(box, { rotation: 6, duration: 0.12 })
      .to(box, { rotation: -3, duration: 0.1 })
      .to(box, { rotation: 0, duration: 0.1 });

    let opened = false;
    box.addEventListener("click", () => {
      if (opened) return;
      opened = true;
      box.disabled = true;
      wobble.kill();

      gsap
        .timeline()
        .to([title, hint], { autoAlpha: 0, y: -12, duration: 0.3 }, 0)
        .to(box, { keyframes: [{ rotation: 4 }, { rotation: -3 }, { rotation: 0 }], duration: 0.45, repeat: 1, ease: "none" }, 0)
        .addLabel("pop")
        .to(lid, { y: -600, rotation: 25, autoAlpha: 0, duration: 0.7, ease: "power2.out" }, "pop")
        .to(body, { y: 60, scale: 0.7, autoAlpha: 0, duration: 0.45, ease: "power2.in" }, "pop+=0.1")
        .add(() => confetti(burst), "pop")
        .add(() => {
          delete hero.dataset.gift;
          greet(hero);
        }, "pop+=0.35");
    });
  }

  function wishes(hero: HTMLElement) {
    const data = hero.querySelector<HTMLScriptElement>("[data-tt-wishes]");
    const textEl = hero.querySelector<HTMLElement>("[data-tt-wish]");
    if (!data || !textEl) return;
    const list: { text: string }[] = JSON.parse(data.textContent || "[]");
    if (list.length) textEl.textContent = list[Math.floor(Math.random() * list.length)].text;
  }

  function confetti(layer: HTMLElement) {
    for (let i = 0; i < 60; i++) {
      const el = document.createElement("i");
      const coin = i % 3 === 0;
      const s = coin ? gsap.utils.random(14, 20) : gsap.utils.random(8, 13);
      el.style.width = `${s}px`;
      el.style.height = `${coin ? s : s * 0.6}px`;
      el.style.borderRadius = coin ? "50%" : "60% 0 60% 0";
      el.style.background = coin ? "#f4c430" : ["#ffcc2e", "#f79ab2", "#ffd84f"][i % 3];
      if (coin) el.style.boxShadow = "inset 0 0 0 3px #c99a1a";
      layer.appendChild(el);
      const a = gsap.utils.random(-Math.PI * 0.95, -Math.PI * 0.05);
      const d = gsap.utils.random(160, 360);
      gsap
        .timeline({ onComplete: () => el.remove() })
        .fromTo(
          el,
          { x: 0, y: 0, rotation: 0, autoAlpha: 1 },
          { x: Math.cos(a) * d, y: Math.sin(a) * d, rotation: gsap.utils.random(-540, 540), duration: gsap.utils.random(0.7, 1), ease: "power3.out" },
        )
        .to(el, { y: `+=${gsap.utils.random(300, 460)}`, rotation: "+=360", autoAlpha: 0, duration: gsap.utils.random(1.2, 1.8), ease: "power1.in" });
    }
  }

  function greet(hero: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => gsap.utils.toArray<T>(sel, hero);
    const letters = $(".tt-letter");
    const sprigs = $<SVGElement>(".tt-sprig");
    const wire = hero.querySelector<SVGPathElement>(".tt-wire");
    const coins = $<SVGElement>(".tt-coin");
    const fades = $(".tt-fade");
    const len = wire?.getTotalLength() ?? 0;

    gsap
      .timeline()
      .fromTo(
        letters,
        { y: 40, scale: 0.6, autoAlpha: 0 },
        { y: 0, scale: 1, autoAlpha: 1, duration: 0.7, ease: "back.out(2)", stagger: 0.06 },
        0.15,
      )
      .fromTo(sprigs, { scale: 0, transformOrigin: "50% 50%" }, { scale: 1, duration: 0.6, ease: "back.out(2.4)", stagger: 0.1 }, 0.9)
      .fromTo(wire, { strokeDasharray: len, strokeDashoffset: len }, { strokeDashoffset: 0, duration: 0.9, ease: "power2.inOut" }, 0.9)
      .fromTo(coins, { scale: 0, transformOrigin: "50% 0%", transformBox: "fill-box" }, { scale: 1, duration: 0.35, ease: "back.out(3)", stagger: 0.05 }, 1.1)
      .fromTo(fades, { y: 16, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.7, stagger: 0.12, ease: "power3.out" }, 1.4);
  }

  function petals(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0;
    let h = 0;
    const resize = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    const S = 64;
    const sprite = (draw: (c: CanvasRenderingContext2D) => void) => {
      const el = document.createElement("canvas");
      el.width = el.height = S;
      const c = el.getContext("2d")!;
      c.translate(S / 2, S / 2);
      draw(c);
      return el;
    };
    const ring = (c: CanvasRenderingContext2D, n: number, fn: () => void) => {
      for (let k = 0; k < n; k++) {
        c.save();
        c.rotate((k * Math.PI * 2) / n);
        fn();
        c.restore();
      }
    };

    const mai = sprite((c) => {
      ring(c, 5, () => {
        c.fillStyle = "#ffcc2e";
        c.strokeStyle = "#e3a514";
        c.lineWidth = 1.5;
        c.beginPath();
        c.arc(0, -13, 11, 0, Math.PI * 2);
        c.fill();
        c.stroke();
      });
      c.fillStyle = "#e2611b";
      c.beginPath();
      c.arc(0, 0, 5, 0, Math.PI * 2);
      c.fill();
      ring(c, 8, () => {
        c.fillStyle = "#b8410e";
        c.beginPath();
        c.arc(0, -8, 1.4, 0, Math.PI * 2);
        c.fill();
      });
    });
    const dao = sprite((c) => {
      ring(c, 5, () => {
        const g = c.createLinearGradient(0, 0, 0, -26);
        g.addColorStop(0, "#f06b92");
        g.addColorStop(1, "#ffd0dd");
        c.fillStyle = g;
        c.beginPath();
        c.moveTo(0, 0);
        c.bezierCurveTo(-14, -8, -12, -24, -4, -26);
        c.lineTo(0, -22);
        c.lineTo(4, -26);
        c.bezierCurveTo(12, -24, 14, -8, 0, 0);
        c.fill();
      });
      ring(c, 10, () => {
        c.strokeStyle = "#c2185b";
        c.lineWidth = 1.2;
        c.beginPath();
        c.moveTo(0, 0);
        c.lineTo(0, -9);
        c.stroke();
        c.fillStyle = "#ffd54f";
        c.beginPath();
        c.arc(0, -9, 1.5, 0, Math.PI * 2);
        c.fill();
      });
    });
    const cuc = sprite((c) => {
      ring(c, 16, () => {
        c.fillStyle = "#ffb300";
        c.beginPath();
        c.ellipse(0, -16, 3.6, 12, 0, 0, Math.PI * 2);
        c.fill();
      });
      ring(c, 12, () => {
        c.fillStyle = "#ffd54f";
        c.beginPath();
        c.ellipse(0, -10, 2.6, 8, 0, 0, Math.PI * 2);
        c.fill();
      });
      c.fillStyle = "#c66a00";
      c.beginPath();
      c.arc(0, 0, 6, 0, Math.PI * 2);
      c.fill();
    });
    const petalSprite = (color: string) =>
      sprite((c) => {
        c.fillStyle = color;
        c.beginPath();
        c.ellipse(0, 0, 14, 8, 0, 0, Math.PI * 2);
        c.fill();
      });
    const KINDS = [
      { img: mai, size: [16, 26], weight: 3 },
      { img: dao, size: [18, 28], weight: 3 },
      { img: cuc, size: [18, 28], weight: 2 },
      { img: petalSprite("#ffcc2e"), size: [8, 12], weight: 1 },
      { img: petalSprite("#f7a1b8"), size: [8, 12], weight: 1 },
    ];
    const bag = KINDS.flatMap((k) => Array(k.weight).fill(k));

    type Flower = { x: number; y: number; size: number; vx: number; vy: number; rot: number; vr: number; flip: number; vf: number; img: HTMLCanvasElement };
    const list: Flower[] = [];
    const max = Math.round(Math.min(46, w / 28));
    const spawn = (): Flower => {
      const k = bag[Math.floor(Math.random() * bag.length)];
      return {
        x: Math.random() * w,
        y: -30,
        size: k.size[0] + Math.random() * (k.size[1] - k.size[0]),
        vx: -0.4 + Math.random() * 0.8,
        vy: 0.6 + Math.random() * 0.7,
        rot: Math.random() * Math.PI * 2,
        vr: (Math.random() - 0.5) * 0.04,
        flip: Math.random() * Math.PI * 2,
        vf: 0.02 + Math.random() * 0.03,
        img: k.img,
      };
    };

    let running = true;
    let raf = 0;
    const tick = () => {
      if (list.length < max && Math.random() < 0.3) list.push(spawn());
      ctx.clearRect(0, 0, w, h);
      for (const f of list) {
        f.vx += (Math.random() - 0.5) * 0.06;
        f.x += f.vx + Math.sin(f.flip) * 0.3;
        f.y += f.vy;
        f.rot += f.vr;
        f.flip += f.vf;
        if (f.y > h + 30) Object.assign(f, spawn());
        ctx.save();
        ctx.translate(f.x, f.y);
        ctx.rotate(f.rot);
        ctx.scale(Math.max(0.25, Math.abs(Math.cos(f.flip))), 1);
        ctx.globalAlpha = 0.95;
        ctx.drawImage(f.img, -f.size / 2, -f.size / 2, f.size, f.size);
        ctx.restore();
      }
      if (running) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !running) {
        running = true;
        raf = requestAnimationFrame(tick);
      } else if (!entry.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }).observe(canvas);
  }
</script>
