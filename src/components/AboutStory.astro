---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ICONS } from "@/lib/icons";
import { about } from "@/data/site";
import photoClassGroup from "@/assets/facility/facility-2.webp";
import photoAoDaiLesson from "@/assets/daily/co-giao-ao-dai-giang-bai.webp";

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const { ctaHref = "/courses", ctaLabel = "Khám phá các khoá học" } = Astro.props;

const [quote, ...rest] = about.paragraphs;

const photos = [
  {
    image: photoClassGroup,
    alt: "Học viên và giảng viên SaigonHSK chụp ảnh ở cầu thang trung tâm dịp Giáng sinh",
    tint: "ring-brand-red-100",
    offset: "",
  },
  {
    image: photoAoDaiLesson,
    alt: "Giảng viên mặc áo dài giảng bài cho lớp tiếng Trung buổi tối",
    tint: "ring-brand-surface-200",
    offset: "sm:mt-10",
  },
] satisfies {
  image: ImageMetadata;
  alt: string;
  tint: string;
  offset: string;
}[];
---
<section class="relative overflow-hidden bg-background py-16 lg:py-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 -bottom-40 size-112 rounded-full bg-brand-red-50 opacity-80 blur-3xl"
  >
  </div>

  <div class="container relative z-10 mx-auto px-6">
    <div class="flex flex-col items-center text-center">
      <h2
        class="text-[2rem] font-black leading-[1.05] tracking-tight text-balance text-brand-ink-900 md:text-[2.75rem]"
      >
        Câu chuyện của chúng tôi
      </h2>

      <span
        aria-hidden="true"
        class="mt-5 block h-0.5 w-24 rounded-full bg-brand-red-300"></span>
    </div>

    <div
      class="mt-12 grid items-center gap-12 lg:mt-16 lg:grid-cols-2 lg:gap-16"
    >
      <div class="flex flex-col items-center text-center">
        <blockquote
          class="max-w-lg text-lg font-medium leading-relaxed text-brand-ink-900 md:text-xl"
        >
          <span class="text-brand-red-600">“</span>{quote}<span
            class="text-brand-red-600">”</span
          >
        </blockquote>

        <div
          class="mt-6 max-w-lg space-y-4 text-left text-[15px] leading-relaxed text-brand-ink-500"
        >
          {rest.map((p) => <p>{p}</p>)}
        </div>

        <a
          href={ctaHref}
          class="group mt-9 inline-flex items-center gap-2 rounded-lg bg-brand-red-600 px-8 py-4 text-sm font-bold text-white shadow-lg shadow-brand-red-600/25 transition-all hover:-translate-y-0.5 hover:bg-brand-red-700"
        >
          {ctaLabel}
          <span
            class="transition-transform group-hover:translate-x-1 [&>svg]:size-4"
            set:html={ICONS.arrow}
          />
        </a>
      </div>

      <div
        class="mx-auto grid w-full max-w-md grid-cols-2 items-start gap-4 lg:max-w-none lg:gap-5"
      >
        {
          photos.map((p) => (
            <div
              class:list={[
                "overflow-hidden rounded-[1.75rem] ring-4",
                p.offset,
                p.tint,
              ]}
            >
              <Image
                src={p.image}
                alt={p.alt}
                width={520}
                format="webp"
                quality={88}
                loading="lazy"
                decoding="async"
                class="h-auto w-full"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
